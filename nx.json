{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "analytics": false,
    "namedInputs": {
        "default": ["{projectRoot}/**/*", "sharedGlobals"],
        "production": [
            "default",
            "!{projectRoot}/tests/**/*",
            "!{projectRoot}/tsconfig.test.json",
            "!{projectRoot}/vitest*.config.ts"
        ],
        "sharedGlobals": [
            "{workspaceRoot}/tsconfig.base.json",
            "{workspaceRoot}/tsconfig.lib.json",
            "{workspaceRoot}/tsconfig.app.json",
            "{workspaceRoot}/tsconfig.test.json",
            "{workspaceRoot}/gtkx.config.base.ts",
            "{workspaceRoot}/vitest.config.base.ts",
            "{workspaceRoot}/scripts/workspace-paths.ts",
            "{workspaceRoot}/scripts/tsx.ts",
            "{workspaceRoot}/scripts/ci/Dockerfile",
            "{workspaceRoot}/.nx/workflows/agents.yaml",
            {
                "env": "GTKX_GIR_PATH"
            },
            "{workspaceRoot}/scripts/cache-environment.ts",
            {
                "runtime": "node scripts/cache-environment.ts runtime"
            },
            "{workspaceRoot}/.github/actions/setup-ci/**/*",
            {
                "runtime": "tsc --version"
            }
        ],
        "nativeEnvironment": [
            "{workspaceRoot}/scripts/cache-environment.ts",
            {
                "env": "RUSTUP_TOOLCHAIN"
            },
            {
                "env": "RUSTFLAGS"
            },
            {
                "env": "CARGO_ENCODED_RUSTFLAGS"
            },
            {
                "env": "CARGO_BUILD_TARGET"
            },
            {
                "runtime": "node scripts/cache-environment.ts native"
            }
        ]
    },
    "plugins": [
        {
            "plugin": "@nx/js/typescript",
            "options": {
                "typecheck": {
                    "targetName": "typecheck"
                },
                "build": {
                    "targetName": "build",
                    "configName": "tsconfig.lib.json"
                }
            },
            "exclude": ["tutorial/**"]
        },
        {
            "plugin": "@nx/oxlint",
            "options": {
                "targetName": "lint"
            },
            "exclude": ["tutorial/**"]
        },
        {
            "plugin": "@nx/eslint/plugin",
            "options": {
                "targetName": "_lint:eslint"
            },
            "exclude": ["tutorial/**"]
        },
        {
            "plugin": "@nx/vitest",
            "options": {
                "testTargetName": "test",
                "testMode": "run"
            },
            "exclude": ["examples/**", "packages/e2e/**", "tutorial/**"]
        }
    ],
    "targetDefaults": {
        "build": [
            {
                "inputs": ["...", "sharedGlobals"]
            },
            {
                "filter": {
                    "plugin": "@nx/js/typescript"
                },
                "options": {
                    "args": ["--noCheck"]
                }
            }
        ],
        "lint": {
            "dependsOn": ["^build", "gtkx:bindings", "@gtkx/gl:codegen", "_lint:eslint"],
            "inputs": [
                "...",
                "default",
                "^production",
                "sharedGlobals",
                "{workspaceRoot}/pnpm-lock.yaml",
                {
                    "dependentTasksOutputFiles": "**/*.{d.ts,d.mts}",
                    "transitive": true
                }
            ]
        },
        "test": {
            "dependsOn": ["^build", "gtkx:bindings"],
            "inputs": [
                "...",
                "default",
                "^production",
                {
                    "dependentTasksOutputFiles": "**/*.{js,node}",
                    "transitive": true
                },
                {
                    "env": "CI"
                }
            ],
            "cache": true
        },
        "release": {
            "cache": false,
            "parallelism": false,
            "dependsOn": ["build", "^release"]
        },
        "e2e": {
            "dependsOn": ["^build"],
            "inputs": [
                "...",
                {
                    "dependentTasksOutputFiles": "**/*.node",
                    "transitive": true
                }
            ]
        },
        "_lint:eslint": {
            "dependsOn": ["^build", "gtkx:bindings", "@gtkx/gl:codegen"],
            "inputs": [
                "...",
                "default",
                "^production",
                "sharedGlobals",
                "{workspaceRoot}/pnpm-lock.yaml",
                {
                    "dependentTasksOutputFiles": "**/*.{d.ts,d.mts}",
                    "transitive": true
                }
            ]
        },
        "typecheck": {
            "inputs": ["...", "sharedGlobals"]
        }
    },
    "release": {
        "versionPlans": {
            "ignorePatternsForPlanCheck": ["**/tests/**", "**/*.test.ts", "**/*.test.tsx", "**/typedoc.json", "**/*.md"]
        },
        "version": {
            "git": {
                "stageChanges": false
            },
            "versionActionsOptions": {
                "skipLockFileUpdate": true
            }
        },
        "changelog": {
            "git": {
                "commit": false,
                "tag": false
            }
        }
    }
}

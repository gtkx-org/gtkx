{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "defaultBase": "main",
    "analytics": false,
    "namedInputs": {
        "default": ["{projectRoot}/**/*", "sharedGlobals"],
        "production": [
            "default",
            "!{projectRoot}/tests/**/*",
            "!{projectRoot}/bench/**/*",
            "!{projectRoot}/tsconfig.test.json",
            "!{projectRoot}/vitest.config.ts",
            "!{projectRoot}/vitest.bench.config.ts"
        ],
        "sharedGlobals": [
            "{workspaceRoot}/tsconfig.base.json",
            "{workspaceRoot}/tsconfig.lib.json",
            "{workspaceRoot}/tsconfig.app.json",
            "{workspaceRoot}/tsconfig.test.json",
            "{workspaceRoot}/gtkx.config.base.ts",
            "{workspaceRoot}/vitest.config.base.ts",
            { "env": "GTK4_VERSION" },
            { "env": "GTKX_GIR_PATH" },
            { "env": "NODE_VERSION" }
        ]
    },
    "plugins": [
        {
            "plugin": "@nx/js/typescript",
            "options": {
                "typecheck": { "targetName": "typecheck" },
                "build": { "targetName": "build", "configName": "tsconfig.lib.json" }
            }
        },
        {
            "plugin": "@nx/eslint/plugin",
            "options": { "targetName": "lint" }
        },
        {
            "plugin": "@nx/vitest",
            "options": { "testTargetName": "test" }
        }
    ],
    "targetDefaults": {
        "build": {
            "dependsOn": ["^build", "gtkx:codegen"]
        },
        "typecheck": {
            "dependsOn": ["build", "^typecheck", "gtkx:codegen"]
        },
        "lint": {
            "dependsOn": ["gtkx:codegen", "@gtkx/gl:codegen"],
            "inputs": [
                "default",
                "^default",
                "{workspaceRoot}/eslint.config.ts",
                "{workspaceRoot}/packages/eslint/src/**/*",
                { "externalDependencies": ["eslint"] }
            ]
        },
        "test": {
            "dependsOn": [
                "gtkx:codegen",
                "@gtkx/cli:build",
                "@gtkx/components:build",
                "@gtkx/css:build",
                "@gtkx/gl:build"
            ]
        },
        "bench": {
            "cache": false,
            "dependsOn": ["gtkx:codegen", "^build"]
        },
        "release": {
            "cache": false,
            "dependsOn": ["build"]
        }
    }
}

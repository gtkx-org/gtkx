{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "analytics": false,
    "namedInputs": {
        "default": [
            "{projectRoot}/**/*",
            "sharedGlobals"
        ],
        "production": [
            "default",
            "!{projectRoot}/tests/**/*",
            "!{projectRoot}/tsconfig.test.json",
            "!{projectRoot}/vitest.config.ts"
        ],
        "sharedGlobals": [
            "{workspaceRoot}/tsconfig.base.json",
            "{workspaceRoot}/tsconfig.lib.json",
            "{workspaceRoot}/tsconfig.app.json",
            "{workspaceRoot}/tsconfig.test.json",
            "{workspaceRoot}/gtkx.config.ts",
            "{workspaceRoot}/vitest.config.base.ts",
            "{workspaceRoot}/scripts/workspace-paths.ts",
            "{workspaceRoot}/scripts/tsx.ts",
            {
                "env": "GTKX_GIR_PATH"
            },
            "{workspaceRoot}/scripts/cache-environment.ts",
            {
                "runtime": "node scripts/cache-environment.ts runtime"
            },
            "{workspaceRoot}/.github/actions/setup-ci/**/*",
            {
                "env": "ImageVersion"
            }
        ],
        "nativeEnvironment": [
            "{workspaceRoot}/scripts/cache-environment.ts",
            {
                "env": "RUSTUP_TOOLCHAIN"
            },
            {
                "env": "RUSTFLAGS"
            },
            {
                "env": "CARGO_ENCODED_RUSTFLAGS"
            },
            {
                "env": "CARGO_BUILD_TARGET"
            },
            {
                "runtime": "node scripts/cache-environment.ts native"
            }
        ]
    },
    "plugins": [
        {
            "plugin": "@nx/js/typescript",
            "options": {
                "typecheck": {
                    "targetName": "typecheck"
                },
                "build": {
                    "targetName": "build",
                    "configName": "tsconfig.lib.json"
                }
            },
            "exclude": [
                "packages/e2e/tests/cli/fixtures/**",
                "tutorial/**"
            ]
        },
        {
            "plugin": "@nx/eslint/plugin",
            "options": {
                "targetName": "lint"
            },
            "exclude": [
                "packages/e2e/tests/cli/fixtures/**",
                "tutorial/**"
            ]
        },
        {
            "plugin": "@nx/vitest",
            "options": {
                "testTargetName": "test",
                "testMode": "run"
            },
            "exclude": [
                "examples/**",
                "packages/e2e/**",
                "tutorial/**"
            ]
        },
        {
            "plugin": "@nx/vitest",
            "include": [
                "packages/e2e/vitest.config.ts"
            ],
            "options": {
                "testTargetName": "e2e",
                "testMode": "run"
            }
        }
    ],
    "targetDefaults": {
        "build": [
            {
                "dependsOn": [
                    "...",
                    "gtkx:_build:bindings"
                ],
                "inputs": [
                    "...",
                    "sharedGlobals"
                ]
            },
            {
                "filter": {
                    "plugin": "@nx/js/typescript"
                },
                "options": {
                    "args": [
                        "--noCheck"
                    ]
                }
            }
        ],
        "lint": {
            "dependsOn": [
                "gtkx:_build:bindings",
                "@gtkx/gl:codegen"
            ]
        },
        "test": {
            "dependsOn": [
                "^build",
                "gtkx:_build:bindings"
            ],
            "inputs": [
                "...",
                "default",
                "^production",
                {
                    "dependentTasksOutputFiles": "**/*.{js,node}",
                    "transitive": true
                },
                {
                    "env": "CI"
                }
            ],
            "cache": true
        },
        "release": {
            "cache": false,
            "parallelism": false,
            "dependsOn": [
                "build",
                "^release"
            ]
        },
        "e2e": {
            "dependsOn": [
                "^build"
            ],
            "inputs": [
                "...",
                {
                    "dependentTasksOutputFiles": "**/*.node",
                    "transitive": true
                }
            ]
        }
    },
    "release": {
        "versionPlans": {
            "ignorePatternsForPlanCheck": [
                "**/tests/**",
                "**/*.test.ts",
                "**/*.test.tsx",
                "**/typedoc.json",
                "**/*.md"
            ]
        },
        "version": {
            "git": {
                "stageChanges": false
            },
            "versionActionsOptions": {
                "skipLockFileUpdate": true
            }
        },
        "changelog": {
            "git": {
                "commit": false,
                "tag": false
            }
        }
    }
}

{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "analytics": false,
    "namedInputs": {
        "default": [
            "{projectRoot}/**/*",
            "sharedGlobals"
        ],
        "production": [
            "default",
            "!{projectRoot}/tests/**/*",
            "!{projectRoot}/tsconfig.test.json",
            "!{projectRoot}/vitest.config.ts"
        ],
        "sharedGlobals": [
            "{workspaceRoot}/tsconfig.base.json",
            "{workspaceRoot}/tsconfig.lib.json",
            "{workspaceRoot}/tsconfig.app.json",
            "{workspaceRoot}/tsconfig.test.json",
            "{workspaceRoot}/gtkx.config.ts",
            "{workspaceRoot}/vitest.config.base.ts",
            "{workspaceRoot}/scripts/workspace-paths.ts",
            "{workspaceRoot}/scripts/tsx.ts",
            {
                "env": "CI_IMAGE_ID"
            },
            {
                "env": "ADWAITA_VERSION"
            },
            {
                "env": "GTK4_VERSION"
            },
            {
                "env": "GTKX_GIR_PATH"
            },
            {
                "env": "NODE_VERSION"
            },
            "{workspaceRoot}/scripts/cache-environment.ts",
            {
                "runtime": "node scripts/cache-environment.ts runtime"
            }
        ],
        "eslintConfig": [
            "{workspaceRoot}/eslint.config.ts",
            {
                "externalDependencies": [
                    "eslint",
                    "typescript",
                    "typescript-eslint",
                    "@eslint/js",
                    "@vitest/eslint-plugin",
                    "eslint-plugin-react-hooks",
                    "eslint-plugin-vue",
                    "globals",
                    "vue-eslint-parser",
                    "jiti"
                ]
            }
        ],
        "nativeEnvironment": [
            "{workspaceRoot}/scripts/cache-environment.ts",
            {
                "env": "CI_IMAGE_ID"
            },
            {
                "env": "RUSTUP_TOOLCHAIN"
            },
            {
                "env": "RUSTFLAGS"
            },
            {
                "env": "CARGO_ENCODED_RUSTFLAGS"
            },
            {
                "env": "CARGO_BUILD_TARGET"
            },
            {
                "runtime": "node scripts/cache-environment.ts native"
            }
        ]
    },
    "plugins": [
        {
            "plugin": "@nx/js/typescript",
            "options": {
                "typecheck": {
                    "targetName": "typecheck"
                },
                "build": {
                    "targetName": "build",
                    "configName": "tsconfig.lib.json"
                }
            },
            "exclude": [
                "packages/cli/tests/fixtures/**",
                "tutorial/**"
            ]
        },
        {
            "plugin": "@nx/eslint/plugin",
            "options": {
                "targetName": "lint"
            },
            "exclude": [
                "packages/cli/tests/fixtures/**",
                "tutorial/**"
            ]
        },
        {
            "plugin": "@nx/vitest",
            "options": {
                "testTargetName": "test",
                "testMode": "run"
            },
            "exclude": [
                "packages/e2e/vitest.config.ts",
                "examples/gtk-demo/*",
                "examples/animations/*",
                "examples/browser/*",
                "examples/hello-world/*",
                "examples/navigation/*",
                "examples/storybook/*",
                "tutorial/**"
            ]
        }
    ],
    "targetDefaults": {
        "build": {
            "dependsOn": [
                "...",
                "gtkx:codegen"
            ],
            "inputs": [
                "...",
                "sharedGlobals"
            ]
        },
        "typecheck": {
            "dependsOn": [
                "...",
                "gtkx:codegen"
            ],
            "inputs": [
                "...",
                "sharedGlobals"
            ]
        },
        "lint": {
            "dependsOn": [
                "gtkx:codegen",
                "@gtkx/gl:codegen"
            ],
            "inputs": [
                "default",
                "^default",
                "eslintConfig"
            ]
        },
        "test": {
            "dependsOn": [
                "^build",
                "gtkx:codegen"
            ],
            "inputs": [
                "...",
                {
                    "dependentTasksOutputFiles": "**/*.node",
                    "transitive": true
                }
            ]
        },
        "release": {
            "cache": false,
            "parallelism": false,
            "dependsOn": [
                "build",
                "^release"
            ]
        }
    },
    "release": {
        "versionPlans": {
            "ignorePatternsForPlanCheck": [
                "**/tests/**",
                "**/*.test.ts",
                "**/*.test.tsx",
                "**/typedoc.json",
                "**/*.md"
            ]
        },
        "version": {
            "git": {
                "stageChanges": false
            },
            "versionActionsOptions": {
                "skipLockFileUpdate": true
            }
        },
        "changelog": {
            "git": {
                "commit": false,
                "tag": false
            }
        }
    }
}

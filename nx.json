{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "defaultBase": "main",
    "analytics": false,
    "sync": {
        "disabledTaskSyncGenerators": ["@nx/js:typescript-sync"]
    },
    "namedInputs": {
        "default": [
            "{projectRoot}/**/*",
            "sharedGlobals"
        ],
        "production": [
            "default",
            "!{projectRoot}/tests/**/*",
            "!{projectRoot}/tsconfig.test.json",
            "!{projectRoot}/vitest.config.ts"
        ],
        "sharedGlobals": [
            "{workspaceRoot}/tsconfig.base.json",
            "{workspaceRoot}/tsconfig.lib.json",
            "{workspaceRoot}/tsconfig.app.json",
            "{workspaceRoot}/tsconfig.test.json",
            "{workspaceRoot}/gtkx.config.ts",
            "{workspaceRoot}/vitest.config.base.ts",
            {
                "env": "CI_IMAGE_ID"
            },
            {
                "env": "ADWAITA_VERSION"
            },
            {
                "env": "GTK4_VERSION"
            },
            {
                "env": "GTKX_GIR_PATH"
            },
            {
                "env": "NODE_VERSION"
            },
            "{workspaceRoot}/scripts/cache-environment.ts",
            {
                "runtime": "node scripts/cache-environment.ts runtime"
            }
        ],
        "nativeEnvironment": [
            "{workspaceRoot}/scripts/cache-environment.ts",
            {
                "env": "CI_IMAGE_ID"
            },
            {
                "env": "RUSTUP_TOOLCHAIN"
            },
            {
                "env": "RUSTFLAGS"
            },
            {
                "env": "CARGO_ENCODED_RUSTFLAGS"
            },
            {
                "env": "CARGO_BUILD_TARGET"
            },
            {
                "runtime": "node scripts/cache-environment.ts native"
            }
        ]
    },
    "plugins": [
        {
            "plugin": "@nx/js/typescript",
            "options": {
                "typecheck": {
                    "targetName": "typecheck"
                },
                "build": {
                    "targetName": "build",
                    "configName": "tsconfig.lib.json"
                }
            },
            "exclude": [
                "packages/eslint/tests/fixtures/**",
                "packages/cli/tests/fixtures/**"
            ]
        },
        {
            "plugin": "@nx/eslint/plugin",
            "options": {
                "targetName": "lint"
            },
            "exclude": [
                "packages/eslint/tests/fixtures/**",
                "packages/cli/tests/fixtures/**"
            ]
        },
        {
            "plugin": "@nx/vitest",
            "options": {
                "testTargetName": "test",
                "testMode": "run"
            },
            "exclude": [
                "packages/e2e/vitest.config.ts",
                "examples/gtk-demo/*",
                "examples/animations/*",
                "examples/browser/*",
                "examples/hello-world/*",
                "examples/navigation/*",
                "examples/storybook/*"
            ]
        }
    ],
    "targetDefaults": {
        "build": {
            "dependsOn": [
                "^build",
                "gtkx:codegen"
            ],
            "inputs": [
                "...",
                "sharedGlobals"
            ]
        },
        "typecheck": {
            "dependsOn": [
                "build",
                "^typecheck",
                "gtkx:codegen"
            ],
            "inputs": [
                "...",
                "sharedGlobals"
            ]
        },
        "lint": {
            "dependsOn": [
                "gtkx:codegen",
                "@gtkx/gl:codegen"
            ],
            "inputs": [
                "default",
                "^default",
                "{workspaceRoot}/api.json",
                "{workspaceRoot}/eslint.config.ts",
                "{workspaceRoot}/packages/eslint/src/**/*",
                "{workspaceRoot}/packages/eslint/package.json",
                {
                    "externalDependencies": [
                        "eslint",
                        "typescript",
                        "typescript-eslint",
                        "@eslint/js",
                        "@nx/eslint-plugin",
                        "@stylistic/eslint-plugin",
                        "@vitest/eslint-plugin",
                        "eslint-plugin-perfectionist",
                        "eslint-plugin-promise",
                        "eslint-plugin-react-hooks",
                        "eslint-plugin-sonarjs",
                        "eslint-plugin-unicorn",
                        "eslint-plugin-vue",
                        "vue-eslint-parser",
                        "jiti"
                    ]
                }
            ]
        },
        "test": {
            "dependsOn": [
                "^build",
                "gtkx:codegen"
            ],
            "inputs": [
                "...",
                {
                    "dependentTasksOutputFiles": "**/*.node",
                    "transitive": true
                }
            ]
        },
        "release": {
            "cache": false,
            "parallelism": false,
            "dependsOn": [
                "build",
                "^release"
            ]
        }
    },
    "release": {
        "projectsRelationship": "fixed",
        "versionPlans": {
            "ignorePatternsForPlanCheck": [
                "**/tests/**",
                "**/*.test.ts",
                "**/*.test.tsx",
                "**/*.md"
            ]
        },
        "version": {
            "git": {
                "commit": false,
                "tag": false,
                "stageChanges": false,
                "push": false
            },
            "versionActionsOptions": {
                "skipLockFileUpdate": true
            }
        },
        "changelog": {
            "git": {
                "commit": false,
                "tag": false,
                "stageChanges": false,
                "push": false
            },
            "workspaceChangelog": {
                "file": "{workspaceRoot}/CHANGELOG.md",
                "createRelease": false
            },
            "projectChangelogs": false
        }
    }
}

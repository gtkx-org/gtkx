{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "ignoreExportsUsedInFile": true,
    "ignoreBinaries": [
        "espeak-ng",
        "glib-compile-resources",
        "glib-compile-schemas",
        "import",
        "pkg-config",
        "setpriv"
    ],
    "ignoreWorkspaces": ["packages/native/npm/*"],
    "workspaces": {
        ".": {
            "entry": ["gtkx.config.ts"],
            "project": ["scripts/**/*.ts"]
        },
        "packages/cli": {
            "entry": ["src/global.d.ts!"],
            "project": ["src/**/*.{ts,tsx}!", "tests/**/*.{ts,tsx}"]
        },
        "packages/codegen": {
            "includeEntryExports": true,
            "project": ["src/**/*.ts!"]
        },
        "packages/css": {
            "project": ["src/**/*.{ts,tsx}!", "tests/**/*.{ts,tsx}"]
        },
        "packages/e2e": {
            "includeEntryExports": true,
            "project": ["tests/**/*.{ts,tsx}"]
        },
        "packages/ffi": {
            "includeEntryExports": true,
            "project": ["src/**/*.ts!", "tests/**/*.{ts,tsx}"]
        },
        "packages/mcp": {
            "entry": ["src/server.ts!"],
            "project": ["src/**/*.ts!", "tests/**/*.{ts,tsx}"]
        },
        "packages/utils": {
            "includeEntryExports": true,
            "project": ["src/**/*.ts!", "tests/**/*.{ts,tsx}"]
        },
        "packages/native": {
            "includeEntryExports": true,
            "entry": ["types.ts!"],
            "project": ["*.ts!", "tests/**/*.{ts,tsx}"]
        },
        "packages/react": {
            "project": ["src/**/*.{ts,tsx}!"]
        },
        "packages/testing": {
            "project": ["src/**/*.{ts,tsx}!", "tests/**/*.{ts,tsx}"]
        },
        "packages/vitest": {
            "includeEntryExports": true,
            "entry": ["src/setup.ts!"],
            "project": ["src/**/*.ts!"]
        },
        "examples/browser": {
            "entry": ["src/index.tsx!", "src/gtkx-env.d.ts!", "gtkx.config.ts!"],
            "project": ["src/**/*.{ts,tsx}!"]
        },
        "examples/gtk-demo": {
            "entry": ["src/index.tsx!", "src/gtkx-env.d.ts!", "gtkx.config.ts!"],
            "project": ["src/**/*.{ts,tsx}!", "tests/**/*.{ts,tsx}"]
        },
        "examples/hello-world": {
            "entry": ["src/index.tsx!", "src/gtkx-env.d.ts!", "gtkx.config.ts!"],
            "project": ["src/**/*.{ts,tsx}!"]
        },
        "examples/tutorial": {
            "entry": ["src/index.tsx!", "src/gtkx-env.d.ts!", "gtkx.config.ts!"],
            "project": ["src/**/*.{ts,tsx}!", "scripts/**/*.ts"]
        },
        "website": {
            "entry": ["screenshots/**/*.test.{ts,tsx}"],
            "project": [".vitepress/**/*.{ts,tsx,js}", "scripts/**/*.{ts,js}", "screenshots/**/*.{ts,tsx}"]
        },
        ".gtkx/gi": {
            "entry": ["**/*.{js,d.ts}!"]
        },
        ".gtkx/react-gi": {
            "entry": ["**/*.js"]
        }
    }
}

{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "ignoreExportsUsedInFile": true,
    "ignore": ["**/out-tsc/**", "packages/native/index.js", "packages/native/index.d.ts"],
    "ignoreDependencies": ["^@gtkx/gi(/.*)?$", "^@gtkx/jsx(/.*)?$", "^@gtkx/native-(\\w+)-(\\w+)(-\\w+)?$"],
    "ignoreBinaries": [
        "espeak-ng",
        "pkg-config",
        "glib-compile-resources",
        "glib-compile-schemas",
        "setpriv",
        "weston"
    ],
    "ignoreUnresolved": [".*\\.wasi\\.cjs"],
    "workspaces": {
        ".": {
            "entry": ["gtkx.config.ts", "scripts/**/*.ts"]
        },
        "packages/e2e": {
            "entry": ["gtkx.config.ts!"]
        },
        "packages/testing": {
            "entry": ["gtkx.config.ts!"]
        },
        "packages/cli": {
            "entry": ["src/global.d.ts!", "scripts/**/*.ts!"]
        },
        "packages/codegen": {
            "entry": ["scripts/**/*.ts!"]
        },
        "packages/vitest": {
            "entry": ["src/worker-setup.ts!"]
        },
        "examples/*": {
            "entry": ["gtkx.config.ts!", "src/gtkx-env.d.ts!", "src/app.tsx!", "src/index.tsx!"]
        }
    }
}

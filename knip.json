{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "ignoreExportsUsedInFile": true,
    "ignore": [
        "packages/native/index.js"
    ],
    "ignoreDependencies": [
        "^@gtkx/gi(/.*)?$",
        "^@gtkx/jsx(/.*)?$"
    ],
    "workspaces": {
        ".": {
            "entry": [
                "gtkx.config.ts",
                "gtkx.config.base.ts"
            ],
            "ignoreDependencies": [
                "@gtkx/runtime",
                "@gtkx/native"
            ]
        },
        "scripts": {
            "entry": [
                "**/*.ts"
            ]
        },
        "website": {
            "entry": [
                ".vitepress/theme/**/*.{ts,vue}"
            ]
        },
        "packages/react": {
            "entry": [
                "src/env.d.ts!"
            ]
        },
        "packages/components": {
            "entry": [
                "gtkx.config.ts!"
            ]
        },
        "packages/e2e": {
            "entry": [
                "gtkx.config.ts!",
                "elements.ts"
            ]
        },
        "packages/testing": {
            "entry": [
                "gtkx.config.ts!"
            ]
        },
        "packages/cli": {
            "entry": [
                "src/global.d.ts!",
                "tests/dev/fixtures/supervisor-harness.ts",
                "tests/dev/fixtures/graceful-child.mjs"
            ]
        },
        "packages/vitest": {
            "entry": [
                "src/worker-preload.ts!",
                "src/worker-setup.ts!"
            ]
        },
        "examples/*": {
            "entry": [
                "gtkx.config.ts!",
                "src/gtkx-env.d.ts!",
                "src/app.tsx!",
                "src/index.tsx!"
            ]
        }
    }
}

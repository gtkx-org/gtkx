{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "includeEntryExports": true,
    "tags": [
        "-internal"
    ],
    "ignore": [
        "packages/eslint/tests/fixtures/**",
        "packages/native/index.js"
    ],
    "ignoreDependencies": [
        "^@gtkx/gi(/.*)?$",
        "^@gtkx/jsx(/.*)?$"
    ],
    "ignoreIssues": {
        "**/gtkx.config.ts": [
            "exports"
        ],
        "packages/e2e/elements.ts": [
            "exports"
        ],
        "packages/react/src/prop-types.ts": [
            "types"
        ],
        "packages/react/src/adw/prop-types.ts": [
            "types"
        ]
    },
    "workspaces": {
        ".": {
            "entry": [
                "gtkx.config.ts",
                "gtkx.config.base.ts"
            ],
            "ignoreDependencies": [
                "@gtkx/runtime",
                "@gtkx/native"
            ]
        },
        "scripts": {
            "entry": [
                "**/*.ts"
            ]
        },
        "website": {
            "entry": [
                ".vitepress/theme/**/*.{ts,vue}"
            ]
        },
        "packages/react": {
            "entry": [
                "src/env.d.ts!"
            ]
        },
        "packages/components": {
            "includeEntryExports": false,
            "entry": [
                "gtkx.config.ts!"
            ]
        },
        "packages/create-gtkx": {
            "includeEntryExports": false
        },
        "packages/css": {
            "includeEntryExports": false
        },
        "packages/e2e": {
            "entry": [
                "gtkx.config.ts!",
                "elements.ts"
            ]
        },
        "packages/gl": {
            "includeEntryExports": false
        },
        "packages/native": {
            "includeEntryExports": false
        },
        "packages/utils": {
            "entry": [
                "src/process/process-guard.ts",
                "tests/fixtures/spawn-driver.mjs",
                "tests/fixtures/spawn-escapee.mjs"
            ]
        },
        "packages/testing": {
            "includeEntryExports": false,
            "entry": [
                "gtkx.config.ts!"
            ]
        },
        "packages/cli": {
            "entry": [
                "src/global.d.ts!",
                "tests/dev/fixtures/supervisor-harness.ts",
                "tests/dev/fixtures/graceful-child.mjs",
                "tests/dev/fixtures/resolve-probe.mjs"
            ]
        },
        "packages/vitest": {
            "includeEntryExports": false,
            "entry": [
                "src/worker-preload.ts!"
            ]
        },
        "examples/*": {
            "entry": [
                "gtkx.config.ts!",
                "src/gtkx-env.d.ts!",
                "src/app.tsx!",
                "src/index.tsx!"
            ]
        }
    }
}

{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "ignoreExportsUsedInFile": true,
    "ignore": ["**/out-tsc/**", "**/native-binding*.cjs"],
    "ignoreBinaries": [
        "espeak-ng",
        "glib-compile-resources",
        "glib-compile-schemas",
        "pkg-config",
        "setpriv",
        "weston"
    ],
    "ignoreDependencies": ["^@gtkx/gi(/.*)?$", "^@gtkx/jsx(/.*)?$"],
    "ignoreWorkspaces": ["packages/native/npm/*"],
    "workspaces": {
        ".": {
            "entry": ["gtkx.config.ts"],
            "project": ["scripts/**/*.ts"]
        },
        "packages/animate": {
            "project": ["src/**/*.{ts,tsx}!"]
        },
        "packages/cli": {
            "entry": ["src/global.d.ts!"],
            "project": ["src/**/*.{ts,tsx}!", "scripts/**/*.ts!", "tests/**/*.{ts,tsx}"]
        },
        "packages/codegen": {
            "includeEntryExports": true,
            "project": ["src/**/*.ts!", "scripts/**/*.ts!", "!src/overrides/**"]
        },
        "packages/components": {
            "project": ["src/**/*.{ts,tsx}!"]
        },
        "packages/config": {
            "includeEntryExports": true,
            "project": ["src/**/*.ts!", "tests/**/*.{ts,tsx}"]
        },
        "packages/create-gtkx": {
            "entry": ["src/cli.ts!"],
            "project": ["src/**/*.ts!", "tests/**/*.{ts,tsx}"]
        },
        "packages/css": {
            "project": ["src/**/*.{ts,tsx}!", "tests/**/*.{ts,tsx}"]
        },
        "packages/e2e": {
            "entry": ["gtkx.config.ts!"],
            "project": ["tests/**/*.{ts,tsx}"]
        },
        "packages/ffi": {
            "project": ["src/**/*.ts!", "tests/**/*.{ts,tsx}"]
        },
        "packages/gl": {
            "project": ["src/**/*.ts!", "tests/**/*.{ts,tsx}"]
        },
        "packages/mcp": {
            "entry": ["src/server.ts!"],
            "project": ["src/**/*.ts!", "tests/**/*.{ts,tsx}"]
        },
        "packages/utils": {
            "includeEntryExports": true,
            "project": ["src/**/*.ts!", "tests/**/*.{ts,tsx}"]
        },
        "packages/native": {
            "includeEntryExports": true,
            "entry": ["types.ts!"],
            "project": ["*.ts!", "tests/**/*.{ts,tsx}"]
        },
        "packages/react": {
            "project": ["src/**/*.{ts,tsx}!"]
        },
        "packages/testing": {
            "entry": ["gtkx.config.ts!"],
            "project": ["src/**/*.{ts,tsx}!", "tests/**/*.{ts,tsx}"]
        },
        "packages/vitest": {
            "project": ["src/**/*.ts!"]
        },
        "examples/browser": {
            "entry": ["src/index.tsx!", "src/gtkx-env.d.ts!", "gtkx.config.ts!"],
            "project": ["src/**/*.{ts,tsx}!"]
        },
        "examples/gtk-demo": {
            "entry": ["src/index.tsx!", "src/gtkx-env.d.ts!", "gtkx.config.ts!"],
            "project": ["src/**/*.{ts,tsx}!", "tests/**/*.{ts,tsx}"]
        },
        "examples/hello-world": {
            "entry": ["src/index.tsx!", "src/gtkx-env.d.ts!", "gtkx.config.ts!"],
            "project": ["src/**/*.{ts,tsx}!"]
        },
        "examples/tutorial": {
            "entry": ["src/index.tsx!", "src/gtkx-env.d.ts!", "gtkx.config.ts!"],
            "project": ["src/**/*.{ts,tsx}!", "scripts/**/*.ts"]
        },
        ".gtkx/gi": {
            "entry": ["**/*.{js,d.ts}!"],
            "ignoreDependencies": ["@gtkx/.*"]
        },
        ".gtkx/jsx": {
            "entry": ["**/*.{js,d.ts}!"],
            "ignoreDependencies": ["@gtkx/.*"]
        }
    }
}

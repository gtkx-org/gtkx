{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "ignoreExportsUsedInFile": true,
    "ignore": ["packages/native/index.js"],
    "ignoreDependencies": ["^@gtkx/gi(/.*)?$", "^@gtkx/jsx(/.*)?$"],
    "ignoreBinaries": [
        "espeak-ng",
        "pkg-config",
        "glib-compile-resources",
        "glib-compile-schemas",
        "setpriv",
        "weston",
        "wlheadless-run"
    ],
    "workspaces": {
        ".": {
            "entry": ["gtkx.config.ts", "scripts/**/*.ts"],
            "ignoreDependencies": ["@gtkx/ffi", "@gtkx/native", "@gtkx/react"]
        },
        "website": {
            "entry": [".vitepress/theme/**/*.{ts,vue}"]
        },
        "packages/e2e": {
            "entry": ["gtkx.config.ts!"]
        },
        "packages/testing": {
            "entry": ["gtkx.config.ts!"]
        },
        "packages/cli": {
            "entry": ["src/global.d.ts!"]
        },
        "packages/vitest": {
            "entry": ["src/worker-preload.ts!", "src/worker-setup.ts!"]
        },
        "examples/*": {
            "entry": ["gtkx.config.ts!", "src/gtkx-env.d.ts!", "src/app.tsx!", "src/index.tsx!"]
        }
    }
}

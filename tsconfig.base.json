{
    "compilerOptions": {
        "allowUnreachableCode": false,
        "allowUnusedLabels": false,
        "composite": true,
        "declarationMap": true,
        "erasableSyntaxOnly": true,
        "exactOptionalPropertyTypes": true,
        "forceConsistentCasingInFileNames": true,
        "inlineSources": true,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "lib": ["esnext"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "noEmitOnError": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitOverride": true,
        "noImplicitReturns": true,
        "noUncheckedIndexedAccess": true,
        "noUncheckedSideEffectImports": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "paths": {
            "@gtkx/animated": ["./packages/animated/src/index.ts"],
            "@gtkx/cairo": ["./packages/cairo/src/index.ts"],
            "@gtkx/cli/refresh-runtime": ["./packages/cli/src/refresh-runtime.ts"],
            "@gtkx/cli/vitest-plugin": ["./packages/cli/src/vitest-plugin.ts"],
            "@gtkx/codegen": ["./packages/codegen/src/index.ts"],
            "@gtkx/codegen/internal": ["./packages/codegen/src/internal.ts"],
            "@gtkx/components": ["./packages/components/src/index.ts"],
            "@gtkx/config": ["./packages/config/src/index.ts"],
            "@gtkx/config/internal": ["./packages/config/src/internal.ts"],
            "@gtkx/config/vite-plugin": ["./packages/config/src/vite-plugin.ts"],
            "create-gtkx": ["./packages/create-gtkx/src/index.ts"],
            "@gtkx/css": ["./packages/css/src/index.ts"],
            "@gtkx/css/internal": ["./packages/css/src/internal.ts"],
            "@gtkx/forms": ["./packages/forms/src/index.ts"],
            "@gtkx/gl": ["./packages/gl/src/index.ts"],
            "@gtkx/i18n": ["./packages/i18n/src/index.ts"],
            "@gtkx/i18n/bootstrap": ["./packages/i18n/src/bootstrap.ts"],
            "@gtkx/mcp/server": ["./packages/mcp/src/server.ts"],
            "@gtkx/mcp/internal": ["./packages/mcp/src/internal.ts"],
            "@gtkx/navigation": ["./packages/navigation/src/index.ts"],
            "@gtkx/react": ["./packages/react/src/index.ts"],
            "@gtkx/react/internal": ["./packages/react/src/internal.ts"],
            "@gtkx/react/config": ["./packages/react/src/config.ts"],
            "@gtkx/runtime": ["./packages/runtime/src/index.ts"],
            "@gtkx/runtime/internal": ["./packages/runtime/src/internal.ts"],
            "@gtkx/storybook": ["./packages/storybook/src/index.ts"],
            "@gtkx/storybook/config": ["./packages/storybook/src/config.ts"],
            "@gtkx/storybook/explorer": ["./packages/storybook/src/explorer.ts"],
            "@gtkx/testing": ["./packages/testing/src/index.ts"],
            "@gtkx/testing/internal": ["./packages/testing/src/internal.ts"],
            "@gtkx/utils": ["./packages/utils/src/index.ts"],
            "@gtkx/vitest": ["./packages/vitest/src/index.ts"],
            "@gtkx/vitest/headless": ["./packages/vitest/src/headless.ts"],
            "@gtkx/config/elements": ["./packages/config/src/builtin-elements.ts"]
        },
        "resolveJsonModule": true,
        "rewriteRelativeImportExtensions": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "strict": true,
        "target": "es2025",
        "types": ["node"],
        "verbatimModuleSyntax": true
    }
}

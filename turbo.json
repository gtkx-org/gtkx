{
    "$schema": "https://turborepo.com/schema.json",
    "globalDependencies": ["tsconfig.base.json", "tsconfig.lib.json", "tsconfig.app.json", "tsconfig.test.json"],
    "globalEnv": ["NODE_VERSION", "GTK4_VERSION", "VERSION"],
    "globalPassThroughEnv": ["TURBO_TOKEN", "TURBO_TEAM"],
    "tasks": {
        "//#setup:store-link": {
            "dependsOn": ["@gtkx/cli#codegen"],
            "outputs": [".gtkx"],
            "outputLogs": "new-only"
        },
        "//#lint:all": {
            "dependsOn": ["//#setup:store-link", "@gtkx/cli#build", "@gtkx/vitest#build"],
            "inputs": [
                "**/*.ts",
                "**/*.tsx",
                "**/package.json",
                "**/tsconfig*.json",
                "biome.json",
                "knip.json",
                ".dependency-cruiser.cjs"
            ],
            "outputLogs": "new-only"
        },
        "//#coverage:all": {
            "dependsOn": ["@gtkx/cli#build", "@gtkx/vitest#build", "@gtkx/native#native-build"],
            "inputs": [
                "vitest.config.ts",
                "packages/*/vitest.config.ts",
                "packages/*/src/**/*.{ts,tsx}",
                "packages/*/tests/**/*.{ts,tsx}"
            ],
            "outputs": ["coverage/**"],
            "outputLogs": "new-only"
        },
        "//#test:all": {
            "dependsOn": ["@gtkx/cli#build", "@gtkx/vitest#build", "@gtkx/native#native-build"],
            "inputs": [
                "vitest.config.ts",
                "packages/*/vitest.config.ts",
                "packages/*/src/**/*.{ts,tsx}",
                "packages/*/tests/**/*.{ts,tsx}",
                "examples/gtk-demo/vitest.config.ts",
                "examples/gtk-demo/src/**/*.{ts,tsx}",
                "examples/gtk-demo/tests/**/*.{ts,tsx}"
            ],
            "outputLogs": "new-only"
        },
        "@gtkx/native#lint": {
            "dependsOn": ["native-build"],
            "inputs": ["Cargo.toml", "Cargo.lock", "build.rs", "src/**/*.rs", "tests/**/*.rs"],
            "outputs": [],
            "outputLogs": "new-only",
            "passThroughEnv": ["RUSTUP_TOOLCHAIN"]
        },
        "build": {
            "dependsOn": ["^build", "native-build", "@gtkx/cli#codegen"],
            "inputs": [
                "package.json",
                "*.ts",
                "bin/**",
                "src/**/*.ts",
                "src/**/*.tsx",
                "src/**/*.d.ts",
                "src/**/*.js",
                "scripts/**/*.ts",
                "tests/**/*.ts",
                "tests/**/*.tsx",
                "tsconfig.json",
                "tsconfig.lib.json",
                "tsconfig.test.json"
            ],
            "outputs": ["dist/**", "out-tsc/**", "*.tsbuildinfo"],
            "outputLogs": "new-only"
        },
        "@gtkx/cli#codegen": {
            "dependsOn": ["@gtkx/native#native-build"],
            "cache": false
        },
        "native-build": {
            "inputs": ["Cargo.toml", "Cargo.lock", "build.rs", "src/**/*.rs"],
            "outputs": [
                "*.node",
                "native-binding.cjs",
                "native-binding.d.cts",
                "npm/linux-arm64-gnu/*.node",
                "npm/linux-x64-gnu/*.node"
            ],
            "outputLogs": "new-only",
            "passThroughEnv": ["RUSTUP_TOOLCHAIN", "CARGO_INCREMENTAL", "CARGO_NET_RETRY"]
        },
        "@gtkx/native#test": {
            "dependsOn": ["native-build"],
            "inputs": ["Cargo.toml", "src/**/*.rs", "tests/**/*.rs"],
            "outputs": [],
            "outputLogs": "new-only",
            "passThroughEnv": ["RUSTUP_TOOLCHAIN"]
        },
        "native-coverage": {
            "dependsOn": ["native-build"],
            "inputs": ["Cargo.toml", "src/**/*.rs", "tests/**/*.rs"],
            "outputs": ["coverage/**"],
            "outputLogs": "new-only",
            "passThroughEnv": ["RUSTUP_TOOLCHAIN"]
        },
        "start": {
            "dependsOn": ["build"],
            "persistent": true,
            "cache": false
        },
        "dev": {
            "dependsOn": ["^build"],
            "persistent": true,
            "cache": false
        },
        "//#typecheck:packages": {
            "dependsOn": ["//#setup:store-link", "@gtkx/cli#codegen"],
            "inputs": [
                "packages/*/src/**/*.ts",
                "packages/*/src/**/*.tsx",
                "packages/*/tests/**/*.ts",
                "packages/*/tests/**/*.tsx",
                "packages/*/vitest.config.ts",
                "packages/native/*.ts",
                "scripts/**/*.ts",
                "vitest.config.ts",
                "tsconfig.base.json",
                "tsconfig.check.json"
            ],
            "outputs": []
        },
        "typecheck": {
            "dependsOn": ["^build", "@gtkx/cli#codegen"],
            "inputs": [
                "src/**/*.ts",
                "src/**/*.tsx",
                "src/**/*.d.ts",
                "vitest.config.ts",
                "tsconfig.json",
                "tsconfig.app.json",
                "tsconfig.lib.json",
                "tsconfig.test.json"
            ],
            "outputs": ["dist/**", "out-tsc/**", "*.tsbuildinfo"],
            "outputLogs": "new-only"
        },
        "bench": {
            "dependsOn": ["^build", "native-build", "@gtkx/cli#codegen"],
            "cache": false
        },
        "native-bench": {
            "dependsOn": ["native-build"],
            "cache": false,
            "passThroughEnv": ["RUSTUP_TOOLCHAIN", "CODSPEED_RUNNER_MODE"]
        }
    }
}

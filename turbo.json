{
    "$schema": "https://turborepo.com/schema.json",
    "globalDependencies": [
        ".dependency-cruiser.js",
        "biome.json",
        "gtkx.config.ts",
        "knip.json",
        "tsconfig.json",
        "tsconfig.*.json",
        "vitest.config.ts",
    ],
    "globalEnv": [
        "NODE_VERSION",
        "GTK4_VERSION",
        "VERSION"
    ],
    "globalPassThroughEnv": [
        "TURBO_TOKEN",
        "TURBO_TEAM",
        "RUSTUP_HOME",
        "CARGO_HOME",
        "NPM_CONFIG_REGISTRY",
        "NPM_CONFIG_USERCONFIG"
    ],
    "tasks": {
        "production": {
            "dependsOn": [
                "//#codegen:all",
                "codegen",
                "@gtkx/native#build",
                "^production"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                "src/**",
                "data/**",
                "gtkx.config.ts",
                "tsconfig.lib.json",
                {
                    "mode": "dependencyOutputs",
                    "from": ["codegen", "//#codegen:all"],
                    "globs": ["**"]
                }
            ],
            "outputs": []
        },
        "bench": {
            "dependsOn": [
                "production"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                "bench/**/*.bench.{ts,tsx}",
                "vitest.bench.config.ts"
            ],
            "outputs": []
        },
        "build": {
            "dependsOn": [
                "production"
            ],
            "inputs": [],
            "outputs": [
                "dist/**",
                "tsconfig.lib.tsbuildinfo"
            ]
        },
        "codegen": {
            "dependsOn": [
                "production"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                "scripts/codegen.ts"
            ],
            "outputs": [
                "src/generated/**"
            ]
        },
        "coverage": {
            "dependsOn": [
                "production"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                "tests/**",
                "vitest.config.ts"
            ],
            "outputs": [
                "coverage/**"
            ]
        },
        "release": {
            "dependsOn": [
                "build"
            ],
            "cache": false
        },
        "typecheck": {
            "dependsOn": [
                "production"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                "tests/**"
            ],
            "outputs": ["*.tsbuildinfo"]
        },
        "@gtkx/native#production": {
            "dependsOn": [
                "^production"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                "main.d.ts",
                "main.js",
                "Cargo.toml",
                "Cargo.lock"
            ],
            "outputs": []
        },
        "@gtkx/native#artifacts": {
            "dependsOn": [
                "build"
            ],
            "inputs": [],
            "outputs": [
                "artifacts/**"
            ]
        },
        "@gtkx/native#create-npm-dirs": {
            "dependsOn": [
                "build"
            ],
            "inputs": [],
            "outputs": [
                "npm/**"
            ]
        },
        "@gtkx/native#release": {
            "dependsOn": [
                "artifacts",
                "create-npm-dirs"
            ]
        },
        "@gtkx/native#build": {
            "outputs": [
                "target/**",
                "index.d.ts",
                "index.js",
                "native.*.node"
            ],
            "inputs": []
        },
        "@gtkx/native#test": {
            "dependsOn": [
                "build",
                "test:asan",
                "test:miri"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                "$TURBO_ROOT$/scripts/run-headless.ts"
            ],
            "outputs": []
        },
        "@gtkx/native#test:asan": {
            "dependsOn": [
                "build"
            ],
            "inputs": [],
            "outputs": []
        },
        "@gtkx/native#test:miri": {
            "dependsOn": [
                "build"
            ],
            "inputs": [],
            "outputs": []
        },
        "//#codegen:all": {
            "inputs": [
                "$TURBO_DEFAULT$",
                "packages/cli/src/**",
                "packages/codegen/src/**"
            ],
            "outputs": [
                "node_modules/.gtkx/**"
            ]
        },
        "//#coverage:all": {
            "dependsOn": [
                "codegen",
                "//#codegen:all",
                "@gtkx/native#build"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                "packages/**/src/**",
                "packages/**/tests/**",
                "packages/**/vitest.config.ts",
                {
                    "mode": "dependencyOutputs",
                    "from": ["codegen", "//#codegen:all"],
                    "globs": ["**"]
                }
            ],
            "outputs": [
                "coverage/**"
            ]
        },
        "//#lint:all": {
            "dependsOn": [
                "//#lint:deps",
                "//#lint:knip",
                "//#lint:ts-refs"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                "packages/**/src/**",
                "packages/**/tests/**",
                "packages/**/gtkx.config.ts",
                "packages/**/vitest.config.ts"
            ],
            "outputs": []
        },
        "//#lint:deps": {
            "dependsOn": [
                "codegen",
                "//#codegen:all"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                "packages/**/src/**",
                "packages/**/tests/**",
                "packages/**/package.json",
                "packages/**/gtkx.config.ts",
                {
                    "mode": "dependencyOutputs",
                    "from": ["codegen", "//#codegen:all"],
                    "globs": ["**"]
                }
            ],
            "outputs": []
        },
        "//#lint:knip": {
            "dependsOn": [
                "codegen",
                "//#codegen:all"
            ],
            "inputs": [
                "packages/**/src/**",
                "packages/**/tests/**",
                "packages/**/gtkx.config.ts",
                "packages/**/package.json",
                {
                    "mode": "dependencyOutputs",
                    "from": ["codegen", "//#codegen:all"],
                    "globs": ["**"]
                }
            ],
            "outputs": []
        },
        "//#lint:ts-refs": {
            "inputs": [
                "packages/**/src/**",
                "packages/**/tests/**",
                "packages/**/gtkx.config.ts",
                "packages/**/package.json",
                "packages/**/tsconfig.json",
                "packages/**/tsconfig.*.json"
            ],
            "outputs": []
        },
        "//#test:all": {
            "dependsOn": [
                "codegen",
                "//#codegen:all",
                "@gtkx/native#build"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                "packages/**/src/**",
                "packages/**/tests/**",
                "packages/**/gtkx.config.ts",
                "packages/**/vitest.config.ts",
                {
                    "mode": "dependencyOutputs",
                    "from": ["codegen", "//#codegen:all"],
                    "globs": ["**"]
                }
            ],
            "outputs": []
        },
        "//#typecheck:all": {
            "dependsOn": [
                "codegen",
                "//#codegen:all",
                "@gtkx/native#build"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                "**/scripts/**",
                ".dependency-cruiser.js",
                "gtkx.config.ts",
                "vitest.config.ts",
                {
                    "mode": "dependencyOutputs",
                    "from": ["codegen", "//#codegen:all"],
                    "globs": ["**"]
                }
            ],
            "outputs": []
        }
    }
}

{
    "$schema": "https://turborepo.com/schema.json",
    "globalDependencies": ["tsconfig.base.json", "tsconfig.lib.json", "tsconfig.app.json", "tsconfig.test.json"],
    "globalEnv": ["NODE_VERSION", "GTK4_VERSION", "VERSION"],
    "globalPassThroughEnv": ["TURBO_TOKEN", "TURBO_TEAM"],
    "tasks": {
        "//#lint:all": {
            "dependsOn": ["@gtkx/cli#build", "@gtkx/vitest#build"],
            "inputs": [
                "**/*.ts",
                "**/*.tsx",
                "**/package.json",
                "**/tsconfig*.json",
                "biome.json",
                "knip.json",
                ".dependency-cruiser.cjs"
            ],
            "outputLogs": "new-only"
        },
        "//#coverage:all": {
            "dependsOn": ["@gtkx/vitest#build", "@gtkx/native#native-build", "@gtkx/cli#codegen"],
            "inputs": [
                "vitest.config.ts",
                "packages/*/vitest.config.ts",
                "packages/*/src/**/*.{ts,tsx}",
                "packages/*/tests/**/*.{ts,tsx}"
            ],
            "outputs": ["coverage/**"],
            "outputLogs": "new-only"
        },
        "//#test:all": {
            "dependsOn": ["@gtkx/cli#build", "@gtkx/vitest#build", "@gtkx/native#native-build"],
            "inputs": [
                "vitest.config.ts",
                "packages/*/vitest.config.ts",
                "packages/*/src/**/*.{ts,tsx}",
                "packages/*/tests/**/*.{ts,tsx}",
                "examples/gtk-demo/vitest.config.ts",
                "examples/gtk-demo/src/**/*.{ts,tsx}",
                "examples/gtk-demo/tests/**/*.{ts,tsx}"
            ],
            "outputLogs": "new-only"
        },
        "@gtkx/native#lint": {
            "dependsOn": ["native-build"],
            "inputs": ["Cargo.toml", "Cargo.lock", "build.rs", "src/**/*.rs", "tests/**/*.rs"],
            "outputs": [],
            "outputLogs": "new-only",
            "passThroughEnv": ["RUSTUP_TOOLCHAIN"]
        },
        "build": {
            "dependsOn": ["^build", "native-build"],
            "inputs": [
                "package.json",
                "*.ts",
                "bin/**",
                "src/**/*.ts",
                "src/**/*.tsx",
                "src/**/*.d.ts",
                "src/**/*.js",
                "scripts/**/*.ts",
                "tests/**/*.ts",
                "tests/**/*.tsx",
                "tsconfig.json",
                "tsconfig.lib.json",
                "tsconfig.test.json"
            ],
            "outputs": ["dist/**", "out-tsc/**", "*.tsbuildinfo"],
            "outputLogs": "new-only"
        },
        "@gtkx/cli#codegen": {
            "dependsOn": ["@gtkx/native#native-build"],
            "cache": false
        },
        "@gtkx/ffi#build": {
            "dependsOn": ["^build", "native-build", "@gtkx/cli#codegen"],
            "outputs": ["dist/**", "out-tsc/**", "*.tsbuildinfo"],
            "outputLogs": "new-only"
        },
        "@gtkx/react#build": {
            "dependsOn": ["^build", "native-build", "@gtkx/cli#codegen"],
            "outputs": ["dist/**", "out-tsc/**", "*.tsbuildinfo"],
            "outputLogs": "new-only"
        },
        "@gtkx/testing#build": {
            "dependsOn": ["^build", "native-build", "@gtkx/cli#codegen"],
            "outputs": ["dist/**", "out-tsc/**", "*.tsbuildinfo"],
            "outputLogs": "new-only"
        },
        "@gtkx/css#build": {
            "dependsOn": ["^build", "native-build", "@gtkx/cli#codegen"],
            "outputs": ["dist/**", "out-tsc/**", "*.tsbuildinfo"],
            "outputLogs": "new-only"
        },
        "@gtkx/cli#build": {
            "dependsOn": ["^build", "native-build", "@gtkx/cli#codegen"],
            "outputs": ["dist/**", "out-tsc/**", "*.tsbuildinfo"],
            "outputLogs": "new-only"
        },
        "@gtkx/e2e#build": {
            "dependsOn": ["^build", "native-build", "@gtkx/cli#codegen"],
            "outputs": ["dist/**", "out-tsc/**", "*.tsbuildinfo"],
            "outputLogs": "new-only"
        },
        "native-build": {
            "inputs": ["Cargo.toml", "Cargo.lock", "build.rs", "src/**/*.rs"],
            "outputs": [
                "*.node",
                "native-binding.cjs",
                "native-binding.d.cts",
                "npm/linux-arm64-gnu/*.node",
                "npm/linux-x64-gnu/*.node"
            ],
            "outputLogs": "new-only",
            "passThroughEnv": ["RUSTUP_TOOLCHAIN", "CARGO_INCREMENTAL", "CARGO_NET_RETRY"]
        },
        "@gtkx/native#test": {
            "dependsOn": ["native-build"],
            "inputs": ["Cargo.toml", "src/**/*.rs", "tests/**/*.rs"],
            "outputs": [],
            "outputLogs": "new-only",
            "passThroughEnv": ["RUSTUP_TOOLCHAIN"]
        },
        "native-coverage": {
            "dependsOn": ["native-build"],
            "inputs": ["Cargo.toml", "src/**/*.rs", "tests/**/*.rs"],
            "outputs": ["coverage/**"],
            "outputLogs": "new-only",
            "passThroughEnv": ["RUSTUP_TOOLCHAIN"]
        },
        "start": {
            "dependsOn": ["build"],
            "persistent": true,
            "cache": false
        },
        "dev": {
            "dependsOn": ["^build"],
            "persistent": true,
            "cache": false
        },
        "typecheck": {
            "dependsOn": ["^typecheck", "@gtkx/cli#codegen"],
            "inputs": [
                "src/**/*.ts",
                "src/**/*.tsx",
                "src/**/*.d.ts",
                "src/**/*.js",
                "scripts/**/*.ts",
                "screenshots/**/*.ts",
                "screenshots/**/*.tsx",
                "tests/**/*.ts",
                "tests/**/*.tsx",
                "vitest.config.ts",
                "tsconfig.json",
                "tsconfig.app.json",
                "tsconfig.lib.json",
                "tsconfig.test.json"
            ],
            "outputs": ["dist/**", "out-tsc/**", "*.tsbuildinfo"],
            "outputLogs": "new-only"
        },
        "bench": {
            "dependsOn": ["^build", "native-build", "@gtkx/cli#codegen"],
            "cache": false
        },
        "native-bench": {
            "dependsOn": ["native-build"],
            "cache": false,
            "passThroughEnv": ["RUSTUP_TOOLCHAIN", "CODSPEED_RUNNER_MODE"]
        },
        "docs": {
            "dependsOn": ["@gtkx/ffi#build", "@gtkx/react#build"],
            "inputs": [
                "package.json",
                ".vitepress/**",
                "docs/**",
                "index.md",
                "public/**",
                "scripts/**",
                "typedoc.config.ts",
                "typedoc.json",
                "tsconfig.json"
            ],
            "outputs": [".vitepress/dist/**", "api/**"],
            "outputLogs": "new-only"
        },
        "@gtkx/native#typecheck": {
            "dependsOn": ["^typecheck", "native-build"],
            "inputs": ["*.ts", "tests/**/*.ts", "tsconfig.json", "tsconfig.lib.json", "tsconfig.test.json"],
            "outputs": ["dist/**", "out-tsc/**", "*.tsbuildinfo"],
            "outputLogs": "new-only"
        }
    }
}

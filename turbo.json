{
    "$schema": "https://turborepo.com/schema.json",
    "globalDependencies": [
        ".dependency-cruiser.js",
        "biome.json",
        "gtkx.config.ts",
        "knip.json",
        "tsconfig.json",
        "tsconfig.*.json",
        "vitest.config.ts"
    ],
    "globalEnv": ["NODE_VERSION", "GTK4_VERSION", "GTKX_GIR_PATH"],
    "globalPassThroughEnv": [
        "TURBO_TOKEN",
        "TURBO_TEAM",
        "RUSTUP_HOME",
        "CARGO_HOME",
        "NPM_CONFIG_REGISTRY",
        "NPM_CONFIG_USERCONFIG"
    ],
    "tasks": {
        "production": {
            "dependsOn": ["codegen", "^production"],
            "inputs": [
                "$TURBO_DEFAULT$",
                "src/**",
                "data/**",
                "gtkx.config.ts",
                "tsconfig.lib.json",
                {
                    "mode": "dependencyOutputs",
                    "from": ["//#codegen:all", "codegen"],
                    "globs": ["node_modules/.gtkx/**", "src/generated/**"]
                }
            ],
            "outputs": []
        },
        "bench": {
            "dependsOn": ["production"],
            "inputs": ["$TURBO_DEFAULT$", "bench/**/*.bench.{ts,tsx}", "vitest.bench.config.ts"],
            "outputs": []
        },
        "build": {
            "dependsOn": ["production", "^build"],
            "inputs": [],
            "outputs": ["dist/**", "tsconfig.lib.tsbuildinfo"]
        },
        "dev": {
            "dependsOn": ["^build"],
            "cache": false,
            "persistent": true
        },
        "@gtkx/website#build": {
            "dependsOn": [
                "production",
                "^build",
                "@gtkx/components#build",
                "@gtkx/config#build",
                "@gtkx/css#build",
                "@gtkx/runtime#build",
                "@gtkx/gl#build",
                "@gtkx/native#build",
                "@gtkx/react#build",
                "@gtkx/testing#build",
                "@gtkx/vitest#build"
            ],
            "inputs": [],
            "outputs": [".vitepress/dist/**"]
        },
        "lint": {
            "inputs": ["$TURBO_DEFAULT$"],
            "outputs": []
        },
        "codegen": {
            "dependsOn": ["//#codegen:all"],
            "inputs": ["$TURBO_DEFAULT$"],
            "outputs": ["src/generated/**"]
        },
        "coverage": {
            "dependsOn": ["production"],
            "inputs": ["$TURBO_DEFAULT$", "tests/**", "vitest.config.ts"],
            "outputs": ["coverage/**"]
        },
        "release": {
            "dependsOn": ["build"],
            "cache": false,
            "passThroughEnv": [
                "ACTIONS_ID_TOKEN_REQUEST_URL",
                "ACTIONS_ID_TOKEN_REQUEST_TOKEN",
                "NPM_CONFIG_PROVENANCE",
                "NPM_ID_TOKEN",
                "GITHUB_ACTIONS",
                "GITHUB_SERVER_URL",
                "GITHUB_REPOSITORY",
                "GITHUB_REPOSITORY_ID",
                "GITHUB_REPOSITORY_OWNER",
                "GITHUB_REPOSITORY_OWNER_ID",
                "GITHUB_REF",
                "GITHUB_SHA",
                "GITHUB_RUN_ID",
                "GITHUB_RUN_NUMBER",
                "GITHUB_RUN_ATTEMPT",
                "GITHUB_WORKFLOW",
                "GITHUB_WORKFLOW_REF",
                "GITHUB_EVENT_NAME",
                "GITHUB_ACTOR",
                "GITHUB_ACTOR_ID",
                "GITHUB_JOB",
                "RUNNER_ENVIRONMENT"
            ]
        },
        "typecheck": {
            "dependsOn": ["production", "^build"],
            "inputs": ["$TURBO_DEFAULT$", "tests/**"],
            "outputs": ["*.tsbuildinfo"]
        },
        "@gtkx/native#production": {
            "dependsOn": ["^production"],
            "inputs": ["$TURBO_DEFAULT$", "main.d.ts", "main.js", "Cargo.toml", "Cargo.lock"],
            "outputs": []
        },
        "@gtkx/native#artifacts": {
            "dependsOn": ["build", "create-npm-dirs"],
            "cache": false
        },
        "@gtkx/native#create-npm-dirs": {
            "dependsOn": ["build"],
            "inputs": [],
            "outputs": ["npm/**"]
        },
        "@gtkx/native#release": {
            "dependsOn": ["artifacts", "create-npm-dirs"],
            "cache": false
        },
        "@gtkx/native#build": {
            "inputs": ["Cargo.toml", "Cargo.lock", "build.rs", "src/**", "package.json"],
            "outputs": ["index.d.ts", "index.js", "native.*.node"]
        },
        "@gtkx/native#test": {
            "dependsOn": ["test:asan", "test:miri"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/run-headless.ts"],
            "outputs": []
        },
        "@gtkx/native#test:asan": {
            "dependsOn": ["build"],
            "inputs": [],
            "outputs": []
        },
        "@gtkx/native#test:miri": {
            "dependsOn": ["build"],
            "inputs": [],
            "outputs": []
        },
        "//#codegen:all": {
            "dependsOn": ["@gtkx/native#build"],
            "inputs": [
                "gtkx.config.ts",
                "packages/cli/src/**",
                "packages/codegen/src/**",
                "packages/codegen/overrides/**",
                "packages/config/src/**",
                "packages/utils/src/**",
                "packages/runtime/src/**",
                "packages/runtime/package.json",
                "packages/react/package.json"
            ],
            "outputs": ["node_modules/.gtkx/**", "node_modules/@gtkx/gi", "node_modules/@gtkx/jsx"]
        },
        "//#coverage:all": {
            "dependsOn": ["@gtkx/gl#build", "@gtkx/cli#build", "@gtkx/css#build"],
            "inputs": [
                "$TURBO_DEFAULT$",
                "packages/**/src/**",
                "packages/**/tests/**",
                "packages/**/vitest.config.ts",
                {
                    "mode": "dependencyOutputs",
                    "from": ["//#codegen:all"],
                    "globs": ["node_modules/.gtkx/**"]
                }
            ],
            "outputs": ["coverage/**"]
        },
        "//#lint:all": {
            "dependsOn": ["//#lint:deps", "//#lint:knip"],
            "inputs": [
                "$TURBO_DEFAULT$",
                "packages/**/src/**",
                "packages/**/tests/**",
                "packages/**/gtkx.config.ts",
                "packages/**/vitest.config.ts"
            ],
            "outputs": []
        },
        "//#lint:deps": {
            "dependsOn": ["//#codegen:all"],
            "inputs": [
                "$TURBO_DEFAULT$",
                "packages/**/src/**",
                "packages/**/tests/**",
                "packages/**/package.json",
                "packages/**/gtkx.config.ts",
                {
                    "mode": "dependencyOutputs",
                    "from": ["//#codegen:all"],
                    "globs": ["node_modules/.gtkx/**"]
                }
            ],
            "outputs": []
        },
        "//#lint:knip": {
            "dependsOn": ["@gtkx/cli#build"],
            "inputs": [
                "packages/**/src/**",
                "packages/**/tests/**",
                "packages/**/gtkx.config.ts",
                "packages/**/package.json",
                {
                    "mode": "dependencyOutputs",
                    "from": ["//#codegen:all"],
                    "globs": ["node_modules/.gtkx/**"]
                }
            ],
            "outputs": []
        },
        "//#test:all": {
            "dependsOn": ["@gtkx/gl#build", "@gtkx/cli#build", "@gtkx/css#build"],
            "inputs": [
                "$TURBO_DEFAULT$",
                "packages/**/src/**",
                "packages/**/tests/**",
                "packages/**/gtkx.config.ts",
                "packages/**/vitest.config.ts",
                {
                    "mode": "dependencyOutputs",
                    "from": ["//#codegen:all"],
                    "globs": ["node_modules/.gtkx/**"]
                }
            ],
            "outputs": []
        },
        "//#typecheck:all": {
            "dependsOn": ["//#codegen:all"],
            "inputs": [
                "$TURBO_DEFAULT$",
                "**/scripts/**",
                ".dependency-cruiser.js",
                "gtkx.config.ts",
                "vitest.config.ts",
                {
                    "mode": "dependencyOutputs",
                    "from": ["//#codegen:all"],
                    "globs": ["node_modules/.gtkx/**"]
                }
            ],
            "outputs": []
        }
    }
}

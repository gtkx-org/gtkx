{
    "extends": "./tsconfig.base.json",
    "include": [
        "**/scripts",
        "**/vitest.config.ts",
        "**/vitest.*.config.ts",
        "**/vite.config.ts",
        "**/gtkx.config.ts",
        "vitest.config.base.ts",
        "eslint.config.ts",
        "packages/*/env.d.ts",
        "packages/e2e/elements.ts",
        "packages/native/main.d.ts",
        "packages/cli/src/babel-modules.d.ts",
        "packages/vitest/src/dbus-native.d.ts",
        "packages/native/tools/**/*.ts"
    ],
    "exclude": [
        "tutorial"
    ],
    "references": [
      {
        "path": "./packages/create-gtkx"
      },
      {
        "path": "./examples/hello-world"

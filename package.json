{
    "name": "gtkx",
    "version": "0.0.0",
    "private": true,
    "homepage": "https://gtkx.dev",
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "scripts": {
        "asan": "./scripts/run-asan.ts",
        "codspeed": "./scripts/run-codspeed.ts",
        "build": "turbo run build --filter=!gtkx",
        "codegen": "turbo run codegen:all && turbo run codegen --filter=!gtkx",
        "codegen:all": "pnpm exec gtkx codegen",
        "coverage": "turbo run coverage:all",
        "coverage:all": "vitest run --coverage",
        "lint": "turbo run lint:all lint:deps lint:knip lint:ts-refs && turbo run lint --filter=!gtkx",
        "lint:all": "biome check .",
        "lint:deps": "depcruise packages",
        "lint:knip": "knip",
        "lint:ts-refs": "update-ts-references",
        "miri": "turbo run miri:all",
        "miri:all": "./scripts/run-miri.ts",
        "publish-test": "turbo run publish-test:all",
        "publish-test:all": "./scripts/publish-test.ts",
        "release": "turbo run release:all",
        "release:all": "./scripts/publish.ts",
        "test": "turbo run test:all && turbo run test --filter=!gtkx",
        "test:all": "vitest run",
        "typecheck": "turbo run typecheck:all && turbo run typecheck --filter=!gtkx",
        "typecheck:all": "tsc --noEmit"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.1",
        "@types/node": "catalog:",
        "@types/react": "^19.2.17",
        "@vitest/coverage-v8": "catalog:",
        "dependency-cruiser": "^17.4.3",
        "knip": "^6.18.0",
        "react": "catalog:",
        "turbo": "^2.9.18",
        "typescript": "catalog:",
        "update-ts-references": "^6.1.0",
        "verdaccio": "^6.7.4",
        "vitest": "catalog:"
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}

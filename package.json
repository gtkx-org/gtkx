{
    "name": "gtkx",
    "version": "0.0.0",
    "private": true,
    "homepage": "https://gtkx.dev",
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "scripts": {
        "bench": "turbo run bench --filter=!gtkx",
        "build": "turbo run build --filter=!gtkx",
        "codegen": "turbo run codegen:all && turbo run codegen --filter=!gtkx",
        "codegen:all": "NODE_OPTIONS=--conditions=source pnpm --filter @gtkx/cli exec tsx ./src/cli.ts codegen",
        "coverage": "turbo run coverage:all && turbo run coverage --filter=!gtkx",
        "coverage:all": "vitest run --coverage",
        "lint": "turbo run lint:all && turbo run lint --filter=!gtkx",
        "lint:all": "biome check .",
        "lint:deps": "depcruise packages",
        "lint:knip": "knip",
        "release-e2e": "tsx ./scripts/release-e2e.ts",
        "release": "turbo run release --filter=!gtkx",
        "test": "turbo run test:all && turbo run test --filter=!gtkx",
        "test:all": "vitest run",
        "typecheck": "turbo run typecheck:all && turbo run typecheck --filter=!gtkx",
        "typecheck:all": "tsc --noEmit"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.1",
        "@types/node": "catalog:",
        "@types/react": "^19.2.17",
        "@vitest/coverage-v8": "catalog:",
        "dependency-cruiser": "^17.4.3",
        "knip": "^6.18.0",
        "react": "catalog:",
        "tsx": "^4.22.4",
        "turbo": "^2.9.18",
        "typescript": "catalog:",
        "verdaccio": "^6.7.4",
        "vitest": "catalog:"
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}

{
    "name": "gtkx",
    "version": "0.0.0",
    "private": true,
    "homepage": "https://gtkx.dev",
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "scripts": {
        "build": "nx run-many -t build && nx run gtkx:reference",
        "codegen": "nx run-many -t codegen && nx run gtkx:reference",
        "coverage": "nx run-many -t coverage --parallel=1",
        "lint": "nx run-many -t lint lint:rust lint:knip",
        "plan": "nx release plan",
        "postinstall": "tsc -b --force packages/vitest/tsconfig.lib.json",
        "prepare-release": "tsx ./scripts/prepare-release.ts",
        "release": "nx run-many -t release",
        "release-e2e": "tsx ./scripts/release-e2e.ts",
        "local-registry": "tsx ./scripts/local-registry.ts",
        "test": "nx run-many -t test",
        "tutorial": "tsx ./scripts/tutorial.ts",
        "typecheck": "nx run-many -t typecheck"
    },
    "nx": {
        "includedScripts": [],
        "targets": {
            "codegen": {
                "command": "NODE_OPTIONS=--conditions=source tsx packages/cli/src/cli.ts codegen --config scripts/gtkx.bootstrap.ts",
                "cache": false,
                "dependsOn": [
                    "@gtkx/native:build"
                ],
                "outputs": [
                    "{workspaceRoot}/node_modules/.gtkx/**/*.{js,d.ts,json}"
                ]
            },
            "reference": {
                "command": "node packages/cli/dist/cli.js codegen",
                "cache": false,
                "dependsOn": [
                    "@gtkx/cli:build"
                ],
                "outputs": [
                    "{workspaceRoot}/.gtkx/reference"
                ]
            },
            "typecheck": {
                "command": "tsc --noEmit",
                "cache": true,
                "dependsOn": [
                    "codegen",
                    "reference"
                ],
                "inputs": [
                    "{workspaceRoot}/tsconfig.json",
                    "{workspaceRoot}/eslint.config.ts",
                    "{workspaceRoot}/gtkx.config.ts",
                    "{workspaceRoot}/vitest.config.ts",
                    "{workspaceRoot}/scripts/**/*",
                    "{workspaceRoot}/packages/**/*.{ts,tsx,mts,json}",
                    "{workspaceRoot}/examples/**/*.{ts,tsx,mts,json}",
                    "{workspaceRoot}/website/**/*.{ts,tsx,mts,json}",
                    "sharedGlobals",
                    {
                        "dependentTasksOutputFiles": "**/*.{d.ts,d.mts}",
                        "transitive": true
                    }
                ]
            },
            "coverage-dependencies": {
                "executor": "nx:noop",
                "dependsOn": [
                    "codegen",
                    "@gtkx/e2e:test-fixtures",
                    "@gtkx/vitest:build",
                    "@gtkx/cairo:build",
                    "@gtkx/cli:build",
                    "@gtkx/components:build",
                    "@gtkx/css:build",
                    "@gtkx/forms:build",
                    "@gtkx/gl:build",
                    "@gtkx/i18n:build",
                    "@gtkx/navigation:build",
                    "@gtkx/storybook:build"
                ]
            },
            "coverage": {
                "command": "rm -rf coverage/subprocess && GTKX_COVERAGE_DIR=\"$PWD/coverage/subprocess\" vitest run --coverage --exclude '**/tests/testing/query-perf.test.tsx' && NODE_OPTIONS=--max-old-space-size=8192 tsx ./scripts/subprocess-coverage.ts && rm -rf coverage/subprocess",
                "cache": true,
                "dependsOn": [
                    "coverage-dependencies"
                ],
                "inputs": [
                    "sharedGlobals",
                    "{workspaceRoot}/package.json",
                    "{workspaceRoot}/pnpm-lock.yaml",
                    "{workspaceRoot}/vitest.config.ts",
                    "{workspaceRoot}/gtkx.config.ts",
                    "{workspaceRoot}/scripts/**/*",
                    "{workspaceRoot}/packages/**/*",
                    "{workspaceRoot}/examples/gtk-demo/**/*",
                    "{workspaceRoot}/examples/storybook/**/*",
                    {
                        "dependentTasksOutputFiles": "**/*.{js,d.ts,json}",
                        "transitive": true
                    },
                    {
                        "externalDependencies": [
                            "vitest",
                            "@vitest/coverage-v8",
                            "c8"
                        ]
                    }
                ],
                "outputs": [
                    "{workspaceRoot}/coverage/**"
                ]
            },
            "coverage-shard": {
                "command": "GTKX_COVERAGE_DIR=\"$PWD/coverage/subprocess\" vitest run --coverage --shard=\"$GTKX_COVERAGE_SHARD/$GTKX_COVERAGE_SHARDS\" --reporter=blob --outputFile=\"coverage-artifacts/vitest/blob-$GTKX_COVERAGE_SHARD.json\" --exclude '**/tests/testing/query-perf.test.tsx' && GTKX_SUBPROCESS_COVERAGE_REPORT_DIR=\"$PWD/coverage-artifacts/subprocess-report/$GTKX_COVERAGE_SHARD\" NODE_OPTIONS=--max-old-space-size=8192 tsx ./scripts/subprocess-coverage.ts && rm -rf coverage/subprocess",
                "cache": false,
                "dependsOn": [
                    "coverage-dependencies"
                ]
            },
            "coverage-merge": {
                "command": "GTKX_COVERAGE_MERGE=1 NODE_OPTIONS=--max-old-space-size=8192 vitest --merge-reports=coverage-artifacts/vitest --coverage",
                "cache": false
            },
            "lint": {
                "command": "eslint . --ignore-pattern packages --ignore-pattern examples --ignore-pattern website",
                "cache": true,
                "dependsOn": [
                    "codegen",
                    "reference"
                ],
                "inputs": [
                    "{workspaceRoot}/eslint.config.ts",
                    "{workspaceRoot}/gtkx.config.ts",
                    "{workspaceRoot}/vitest.config.ts",
                    "{workspaceRoot}/scripts/**/*",
                    "{workspaceRoot}/packages/eslint/src/**/*",
                    "{workspaceRoot}/packages/eslint/package.json",
                    "sharedGlobals",
                    {
                        "externalDependencies": [
                            "eslint",
                            "typescript",
                            "typescript-eslint",
                            "@eslint/js",
                            "@nx/eslint-plugin",
                            "@stylistic/eslint-plugin",
                            "@vitest/eslint-plugin",
                            "eslint-plugin-perfectionist",
                            "eslint-plugin-promise",
                            "eslint-plugin-react-hooks",
                            "eslint-plugin-sonarjs",
                            "eslint-plugin-unicorn",
                            "jiti"
                        ]
                    }
                ]
            },
            "lint:knip": {
                "command": "knip",
                "cache": true,
                "dependsOn": [
                    "codegen",
                    "@gtkx/cli:build"
                ],
                "inputs": [
                    "{workspaceRoot}/knip.json",
                    "{workspaceRoot}/package.json",
                    "{workspaceRoot}/pnpm-workspace.yaml",
                    "{workspaceRoot}/tsconfig.json",
                    "{workspaceRoot}/eslint.config.ts",
                    "{workspaceRoot}/vitest.config.ts",
                    "{workspaceRoot}/gtkx.config.ts",
                    "{workspaceRoot}/scripts/**/*",
                    "{workspaceRoot}/packages/**/*",
                    "{workspaceRoot}/examples/**/*",
                    "{workspaceRoot}/website/**/*",
                    "sharedGlobals",
                    {
                        "externalDependencies": [
                            "knip"
                        ]
                    }
                ]
            }
        }
    },
    "devDependencies": {
        "@gtkx/cairo": "workspace:*",
        "@gtkx/eslint": "workspace:*",
        "@gtkx/native": "workspace:*",
        "@gtkx/react": "workspace:*",
        "@gtkx/runtime": "workspace:*",
        "@gtkx/utils": "workspace:*",
        "@nx/eslint": "^23.2.1",
        "@nx/js": "^23.2.1",
        "@nx/vitest": "^23.2.1",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/semver": "^7.8.0",
        "@vitest/coverage-v8": "catalog:",
        "c8": "^12.0.0",
        "eslint": "^10.11.0",
        "jiti": "^2.7.0",
        "knip": "^6.37.0",
        "nx": "^23.2.1",
        "react": "catalog:",
        "semver": "^7.8.5",
        "tsx": "^4.23.15",
        "typescript": "catalog:",
        "verdaccio": "^6.10.4",
        "vitest": "catalog:"
    },
    "engines": {
        "node": ">=26.7.0"
    },
    "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}

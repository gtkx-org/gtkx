{
    "name": "gtkx",
    "version": "0.0.0",
    "private": true,
    "homepage": "https://gtkx.dev",
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "scripts": {
        "build": "turbo build --filter=!gtkx",
        "changeset": "changeset",
        "codegen": "node --conditions=source --import tsx packages/cli/src/cli.ts codegen",
        "coverage": "turbo coverage:all native-coverage --filter=!gtkx",
        "coverage:all": "vitest run --coverage",
        "docs": "turbo run docs --filter=!gtkx",
        "lint": "turbo lint:all lint --filter=!gtkx",
        "lint:all": "biome check . && knip && knip --production && depcruise packages",
        "release": "node scripts/publish.ts",
        "test": "turbo test --filter=!gtkx",
        "test:all": "vitest run",
        "typecheck": "turbo typecheck --filter=!gtkx",
        "version-packages": "changeset version"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.16",
        "@changesets/cli": "^2.27.10",
        "@types/node": "^25.9.1",
        "@types/react": "^19.2.15",
        "@vitest/coverage-v8": "^4.1.7",
        "dependency-cruiser": "^17.4.2",
        "knip": "^6.14.1",
        "react": "^19.2.6",
        "tsx": "^4.22.3",
        "turbo": "^2.9.15",
        "typescript": "^6.0.3",
        "vitest": "^4.1.7"
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "pnpm@11.3.0+sha512.2c403d6594527287672b1f7056343a1f7c3634036a67ffabfcc2b3d7595d843768f8787148d1b57cf7956c90606bbd192857c363af19e96d2d0ec9ec5741d215"
}

{
    "name": "gtkx",
    "version": "0.0.0",
    "private": true,
    "homepage": "https://gtkx.dev",
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "scripts": {
        "build": "turbo build --filter=!gtkx",
        "changeset": "changeset",
        "codegen": "node --conditions=source --import tsx packages/cli/src/cli.ts codegen",
        "coverage": "turbo coverage:all native-coverage --filter=!gtkx",
        "coverage:all": "vitest run --coverage",
        "docs": "turbo run docs --filter=!gtkx",
        "lint": "turbo lint:all lint --filter=!gtkx",
        "lint:all": "biome check . && knip && knip --production && depcruise packages",
        "release": "node scripts/publish.ts",
        "test": "turbo test --filter=!gtkx",
        "test:all": "vitest run",
        "typecheck": "turbo typecheck --filter=!gtkx",
        "version-packages": "changeset version"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.16",
        "@changesets/cli": "^2.27.10",
        "@types/node": "^25.9.1",
        "@types/react": "^19.2.15",
        "@vitest/coverage-v8": "^4.1.7",
        "dependency-cruiser": "^17.4.3",
        "knip": "^6.14.1",
        "react": "^19.2.6",
        "tsx": "^4.22.3",
        "turbo": "^2.9.16",
        "typescript": "^5.9.3",
        "vitest": "^4.1.7"
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1"
}

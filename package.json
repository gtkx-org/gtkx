{
    "name": "gtkx",
    "version": "0.0.0",
    "private": true,
    "homepage": "https://gtkx.dev",
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "scripts": {
        "bench": "turbo run bench --filter=!gtkx",
        "build": "turbo run build --filter=!gtkx",
        "codegen": "turbo run codegen:all && turbo run codegen --filter=!gtkx",
        "codegen:all": "NODE_OPTIONS=--conditions=source pnpm exec tsx packages/cli/src/cli.ts codegen",
        "coverage": "turbo run coverage:all && turbo run coverage --filter=!gtkx",
        "coverage:all": "vitest run --coverage --maxWorkers=50%",
        "lint": "turbo run lint:all && turbo run lint --filter=!gtkx",
        "lint:all": "biome check .",
        "lint:deps": "depcruise packages",
        "lint:knip": "knip",
        "release-e2e": "tsx ./scripts/release-e2e.ts",
        "tutorial": "tsx ./scripts/tutorial.ts",
        "release": "turbo run release --filter=!gtkx --filter='!./examples/*' --filter=!./website --filter=!@gtkx/e2e",
        "test": "turbo run test:all && turbo run test --filter=!gtkx",
        "test:all": "vitest run",
        "typecheck": "turbo run typecheck:all && turbo run typecheck --filter=!gtkx",
        "typecheck:all": "tsc --noEmit"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.3",
        "@gtkx/ffi": "workspace:*",
        "@gtkx/native": "workspace:*",
        "@gtkx/react": "workspace:*",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "dependency-cruiser": "^18.0.0",
        "knip": "^6.25.0",
        "react": "catalog:",
        "tsx": "^4.23.0",
        "turbo": "^2.10.4",
        "typescript": "catalog:",
        "verdaccio": "^6.7.4",
        "vitest": "catalog:"
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8"
}

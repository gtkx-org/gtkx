{
    "name": "gtkx",
    "version": "0.0.0",
    "private": true,
    "homepage": "https://gtkx.dev",
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "scripts": {
        "bench": "nx run-many -t bench",
        "build": "nx run-many -t build",
        "codegen": "nx run-many -t codegen",
        "coverage": "nx run-many -t coverage",
        "lint": "nx run-many -t lint lint:rust lint:knip",
        "postinstall": "tsc -b --force packages/vitest/tsconfig.lib.json",
        "release": "nx run-many -t release",
        "release-e2e": "tsx ./scripts/release-e2e.ts",
        "test": "nx run-many -t test",
        "tutorial": "tsx ./scripts/tutorial.ts",
        "typecheck": "nx run-many -t typecheck"
    },
    "nx": {
        "includedScripts": [],
        "targets": {
            "codegen": {
                "command": "NODE_OPTIONS=--conditions=source tsx packages/cli/src/cli.ts codegen",
                "cache": false,
                "dependsOn": [
                    "@gtkx/native:build"
                ]
            },
            "typecheck": {
                "command": "tsc --noEmit",
                "cache": true,
                "dependsOn": [
                    "codegen"
                ],
                "inputs": [
                    "{workspaceRoot}/tsconfig.json",
                    "{workspaceRoot}/eslint.config.ts",
                    "{workspaceRoot}/scripts/**/*",
                    "{workspaceRoot}/packages/*/gtkx.config.ts",
                    "{workspaceRoot}/packages/*/vitest.config.ts",
                    "{workspaceRoot}/packages/*/vitest.bench.config.ts",
                    "sharedGlobals"
                ],
                "outputs": []
            },
            "coverage": {
                "command": "vitest run --coverage --maxWorkers=50%",
                "cache": true,
                "dependsOn": [
                    "codegen",
                    "@gtkx/vitest:build",
                    "@gtkx/cli:build",
                    "@gtkx/components:build",
                    "@gtkx/css:build",
                    "@gtkx/gl:build"
                ],
                "outputs": [
                    "{workspaceRoot}/coverage/**"
                ]
            },
            "lint": {
                "command": "eslint . --ignore-pattern packages --ignore-pattern examples --ignore-pattern website",
                "cache": true,
                "dependsOn": [
                    "codegen"
                ],
                "inputs": [
                    "{workspaceRoot}/eslint.config.ts",
                    "{workspaceRoot}/gtkx.config.ts",
                    "{workspaceRoot}/gtkx.config.base.ts",
                    "{workspaceRoot}/vitest.config.ts",
                    "{workspaceRoot}/vitest.config.base.ts",
                    "{workspaceRoot}/scripts/**/*",
                    "{workspaceRoot}/packages/eslint/src/**/*",
                    {
                        "externalDependencies": [
                            "eslint"
                        ]
                    }
                ],
                "outputs": []
            },
            "test": {
                "command": "vitest run --project scripts",
                "cache": true,
                "dependsOn": [
                    "codegen",
                    "@gtkx/vitest:build"
                ],
                "inputs": [
                    "{workspaceRoot}/scripts/**/*",
                    "{workspaceRoot}/vitest.config.ts",
                    "{workspaceRoot}/vitest.config.base.ts"
                ],
                "outputs": []
            },
            "lint:knip": {
                "command": "knip",
                "cache": true,
                "dependsOn": [
                    "codegen",
                    "@gtkx/cli:build"
                ],
                "inputs": [
                    "{workspaceRoot}/knip.json",
                    "{workspaceRoot}/packages/*/src/**/*",
                    "{workspaceRoot}/packages/*/tests/**/*",
                    "{workspaceRoot}/packages/*/package.json",
                    "{workspaceRoot}/packages/*/gtkx.config.ts"
                ],
                "outputs": []
            }
        }
    },
    "devDependencies": {
        "@gtkx/eslint": "workspace:*",
        "@gtkx/native": "workspace:*",
        "@gtkx/react": "workspace:*",
        "@gtkx/runtime": "workspace:*",
        "@gtkx/utils": "workspace:*",
        "@gtkx/vitest": "workspace:*",
        "@nx/eslint": "^23.1.0",
        "@nx/js": "^23.1.0",
        "@nx/vitest": "^23.1.0",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "eslint": "^10.8.0",
        "jiti": "^2.7.0",
        "knip": "^6.27.0",
        "nx": "^23.1.0",
        "react": "catalog:",
        "tsx": "^4.23.1",
        "typescript": "catalog:",
        "verdaccio": "^6.8.0",
        "vitest": "catalog:"
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "pnpm@11.15.1+sha512.81350b07e53c9538a02f1f2303b4290fa2d7be04e56e2a970c4cc4b417dc761de196edabd49d55c7dc9580db81007c44143e4e3d7e462b3000d23c255122d065"
}

{
    "name": "gtkx",
    "version": "0.0.0",
    "private": true,
    "homepage": "https://gtkx.dev",
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "scripts": {
        "build": "turbo build --filter=!gtkx",
        "codegen": "turbo run codegen --filter=@gtkx/cli",
        "coverage": "turbo coverage:all native-coverage --filter=!gtkx",
        "coverage:all": "vitest run --coverage",
        "docs": "turbo run docs --filter=!gtkx",
        "lint": "turbo lint:all lint --filter=!gtkx",
        "lint:all": "ln -sfn node_modules/.gtkx .gtkx && biome check . && knip --no-gitignore --exclude files && knip --production --no-gitignore --exclude files && depcruise packages",
        "publish-test": "node scripts/publish-test.ts",
        "release": "node scripts/publish.ts",
        "test": "turbo test --filter=!gtkx",
        "test:all": "vitest run",
        "typecheck": "turbo typecheck --filter=!gtkx"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.16",
        "@types/node": "^25.9.2",
        "@types/react": "^19.2.17",
        "@vitest/coverage-v8": "^4.1.8",
        "dependency-cruiser": "^17.4.3",
        "knip": "^6.16.1",
        "react": "^19.2.7",
        "tsx": "^4.22.4",
        "turbo": "^2.9.16",
        "typescript": "^6.0.3",
        "verdaccio": "^6.7.2",
        "vitest": "^4.1.8"
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916"
}

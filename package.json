{
    "name": "gtkx",
    "version": "0.0.0",
    "private": true,
    "homepage": "https://gtkx.dev",
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "scripts": {
        "build": "nx run-many -t build",
        "codegen": "nx run-many -t codegen",
        "coverage": "nx run-many -t coverage",
        "lint": "nx run-many -t lint lint:rust lint:knip",
        "postinstall": "tsc -b --force packages/vitest/tsconfig.lib.json",
        "release": "nx run-many -t release",
        "release-e2e": "tsx ./scripts/release-e2e.ts",
        "local-registry": "tsx ./scripts/local-registry.ts",
        "test": "nx run-many -t test",
        "tutorial": "tsx ./scripts/tutorial.ts",
        "typecheck": "nx run-many -t typecheck"
    },
    "nx": {
        "includedScripts": [],
        "targets": {
            "codegen": {
                "command": "NODE_OPTIONS=--conditions=source tsx packages/cli/src/cli.ts codegen",
                "cache": false,
                "dependsOn": [
                    "@gtkx/native:build"
                ],
                "outputs": [
                    "{workspaceRoot}/node_modules/.gtkx/**/*.{js,d.ts,json}"
                ]
            },
            "typecheck": {
                "command": "tsc --noEmit",
                "cache": true,
                "dependsOn": [
                    "codegen"
                ],
                "inputs": [
                    "{workspaceRoot}/tsconfig.json",
                    "{workspaceRoot}/eslint.config.ts",
                    "{workspaceRoot}/gtkx.config.ts",
                    "{workspaceRoot}/vitest.config.ts",
                    "{workspaceRoot}/scripts/**/*",
                    "{workspaceRoot}/packages/**/*.{ts,tsx,mts,cts,json}",
                    "{workspaceRoot}/examples/**/*.{ts,tsx,mts,cts,json}",
                    "{workspaceRoot}/website/**/*.{ts,tsx,mts,cts,json}",
                    "sharedGlobals",
                    {
                        "dependentTasksOutputFiles": "**/*.{d.ts,d.cts,d.mts}",
                        "transitive": true
                    }
                ]
            },
            "coverage": {
                "command": "rm -rf coverage/subprocess && GTKX_COVERAGE_DIR=\"$PWD/coverage/subprocess\" vitest run --coverage && tsx ./scripts/subprocess-coverage.ts",
                "cache": true,
                "dependsOn": [
                    "codegen",
                    "@gtkx/vitest:build",
                    "@gtkx/cli:build",
                    "@gtkx/components:build",
                    "@gtkx/css:build",
                    "@gtkx/gl:build"
                ],
                "inputs": [
                    "default",
                    "{workspaceRoot}/packages/**/*",
                    "{workspaceRoot}/examples/gtk-demo/**/*",
                    {
                        "dependentTasksOutputFiles": "**/*.{js,d.ts,json}"
                    },
                    {
                        "externalDependencies": [
                            "vitest",
                            "@vitest/coverage-v8",
                            "c8"
                        ]
                    }
                ],
                "outputs": [
                    "{workspaceRoot}/coverage/**"
                ]
            },
            "lint": {
                "command": "eslint . --ignore-pattern packages --ignore-pattern examples --ignore-pattern website",
                "cache": true,
                "dependsOn": [
                    "codegen"
                ],
                "inputs": [
                    "{workspaceRoot}/eslint.config.ts",
                    "{workspaceRoot}/gtkx.config.ts",
                    "{workspaceRoot}/vitest.config.ts",
                    "{workspaceRoot}/scripts/**/*",
                    "{workspaceRoot}/packages/eslint/src/**/*",
                    "{workspaceRoot}/packages/eslint/package.json",
                    "sharedGlobals",
                    {
                        "externalDependencies": [
                            "eslint",
                            "typescript",
                            "typescript-eslint",
                            "@eslint/js",
                            "@nx/eslint-plugin",
                            "@stylistic/eslint-plugin",
                            "@vitest/eslint-plugin",
                            "eslint-plugin-perfectionist",
                            "eslint-plugin-promise",
                            "eslint-plugin-react-hooks",
                            "eslint-plugin-sonarjs",
                            "eslint-plugin-unicorn",
                            "jiti"
                        ]
                    }
                ]
            },
            "lint:knip": {
                "command": "knip",
                "cache": true,
                "dependsOn": [
                    "codegen",
                    "@gtkx/cli:build"
                ],
                "inputs": [
                    "{workspaceRoot}/knip.json",
                    "{workspaceRoot}/package.json",
                    "{workspaceRoot}/pnpm-workspace.yaml",
                    "{workspaceRoot}/tsconfig.json",
                    "{workspaceRoot}/eslint.config.ts",
                    "{workspaceRoot}/vitest.config.ts",
                    "{workspaceRoot}/gtkx.config.ts",
                    "{workspaceRoot}/scripts/**/*",
                    "{workspaceRoot}/packages/**/*",
                    "{workspaceRoot}/examples/**/*",
                    "{workspaceRoot}/website/**/*",
                    "sharedGlobals",
                    {
                        "externalDependencies": [
                            "knip"
                        ]
                    }
                ]
            }
        }
    },
    "devDependencies": {
        "@gtkx/cairo": "workspace:*",
        "@gtkx/eslint": "workspace:*",
        "@gtkx/native": "workspace:*",
        "@gtkx/react": "workspace:*",
        "@gtkx/runtime": "workspace:*",
        "@gtkx/utils": "workspace:*",
        "@nx/eslint": "^23.1.1",
        "@nx/js": "^23.1.1",
        "@nx/vitest": "^23.1.1",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "c8": "^12.0.0",
        "eslint": "^10.8.1",
        "jiti": "^2.7.0",
        "knip": "^6.32.2",
        "nx": "^23.1.1",
        "react": "catalog:",
        "tsx": "^4.23.12",
        "typescript": "catalog:",
        "verdaccio": "^6.9.2",
        "vitest": "catalog:"
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}

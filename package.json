{
    "name": "gtkx",
    "version": "0.0.0",
    "private": true,
    "homepage": "https://gtkx.dev",
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "scripts": {
        "asan": "node scripts/ci.ts asan",
        "bench": "node scripts/ci.ts bench",
        "build": "turbo build --filter=!gtkx",
        "codegen": "turbo run codegen --filter=@gtkx/cli",
        "coverage": "turbo coverage:all native-coverage --filter=!gtkx",
        "coverage:all": "vitest run --coverage --project=!gtk-demo",
        "lint": "turbo setup:store-link lint:all lint --filter=!gtkx",
        "lint:all": "pnpm check:ts-refs && pnpm --filter @gtkx/cli check:env && pnpm lint:biome && pnpm lint:knip && pnpm lint:knip:prod && pnpm lint:deps",
        "lint:biome": "biome check .",
        "lint:deps": "depcruise packages",
        "lint:knip": "knip --no-gitignore --exclude files",
        "lint:knip:prod": "knip --production --no-gitignore --exclude files",
        "check:ts-refs": "node scripts/sync-ts-references.ts --check",
        "setup:store-link": "ln -sfn node_modules/.gtkx .gtkx",
        "miri": "node scripts/ci.ts miri",
        "publish-test": "node scripts/publish-test.ts",
        "release": "node scripts/publish.ts",
        "sync:ts-refs": "node scripts/sync-ts-references.ts",
        "version-key": "node scripts/compute-version-key.ts",
        "test": "turbo run test:all test --filter=!gtkx",
        "test:all": "vitest run",
        "typecheck": "turbo run typecheck:packages && turbo run typecheck --filter=!gtkx",
        "typecheck:packages": "tsc -p tsconfig.check.json"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.0",
        "@types/node": "catalog:",
        "@types/react": "^19.2.17",
        "@vitest/coverage-v8": "catalog:",
        "dependency-cruiser": "^17.4.3",
        "knip": "^6.17.1",
        "react": "catalog:",
        "tsx": "^4.22.4",
        "turbo": "^2.9.18",
        "typescript": "catalog:",
        "verdaccio": "^6.7.4",
        "vitest": "catalog:"
    },
    "engines": {
        "node": ">=26"
    },
    "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26"
}

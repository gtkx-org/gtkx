{
    "name": "@gtkx/website",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "Marketing site for GTKX: The React framework for Linux.",
    "scripts": {
        "reference": "typedoc && node scripts/reference-search-exclude.mjs",
        "dev": "pnpm reference && vitepress dev",
        "build": "pnpm reference && vitepress build",
        "preview": "vitepress preview"
    },
    "devDependencies": {
        "typedoc": "^0.28.20",
        "typedoc-plugin-markdown": "^4.12.0",
        "typedoc-vitepress-theme": "^1.1.3",
        "typescript": "catalog:",
        "vitepress": "^2.0.0-alpha.18",
        "vue": "^3.5.40"
    },
    "nx": {
        "targets": {
            "build": {
                "cache": true,
                "dependsOn": [
                    "reference"
                ],
                "outputs": [
                    "{projectRoot}/.vitepress/dist/**"
                ]
            },
            "reference": {
                "cache": true,
                "dependsOn": [
                    "gtkx:codegen",
                    "@gtkx/components:build",
                    "@gtkx/config:build",
                    "@gtkx/css:build",
                    "@gtkx/gl:build",
                    "@gtkx/native:build",
                    "@gtkx/react:build",
                    "@gtkx/runtime:build",
                    "@gtkx/testing:build",
                    "@gtkx/vitest:build"
                ],
                "outputs": [
                    "{projectRoot}/reference/**"
                ]
            },
            "dev": {
                "cache": false,
                "continuous": true
            },
            "preview": {
                "cache": false,
                "continuous": true
            },
            "lint": {
                "dependsOn": [
                    "gtkx:codegen",
                    "@gtkx/gl:codegen",
                    "reference"
                ]
            },
            "typecheck": {
                "dependsOn": [
                    "reference"
                ]
            }
        }
    }
}

{
    "name": "@gtkx/website",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "Marketing site for GTKX: The React framework for Linux.",
    "scripts": {
        "reference": "typedoc && node scripts/reference-search-exclude.mjs",
        "dev": "pnpm reference && vitepress dev",
        "build": "pnpm reference && vitepress build",
        "preview": "vitepress preview"
    },
    "devDependencies": {
        "typedoc": "^0.28.20",
        "typedoc-plugin-markdown": "^4.12.0",
        "typedoc-vitepress-theme": "^1.1.3",
        "typescript": "catalog:",
        "vitepress": "^2.0.0-alpha.18",
        "vue": "^3.5.40"
    },
    "nx": {
        "implicitDependencies": [
            "@gtkx/components",
            "@gtkx/config",
            "@gtkx/css",
            "@gtkx/gl",
            "@gtkx/native",
            "@gtkx/react",
            "@gtkx/runtime",
            "@gtkx/testing",
            "@gtkx/vitest"
        ],
        "targets": {
            "build": {
                "cache": true,
                "dependsOn": [
                    "reference"
                ],
                "inputs": [
                    "default"
                ],
                "outputs": [
                    "{projectRoot}/.vitepress/dist/**"
                ]
            },
            "reference": {
                "cache": true,
                "dependsOn": [
                    "gtkx:codegen",
                    "^build"
                ],
                "inputs": [
                    "default",
                    "^production",
                    {
                        "dependentTasksOutputFiles": "**/*.{d.ts,d.cts,d.mts}",
                        "transitive": true
                    },
                    {
                        "externalDependencies": [
                            "typedoc",
                            "typedoc-plugin-markdown",
                            "typedoc-vitepress-theme"
                        ]
                    }
                ],
                "outputs": [
                    "{projectRoot}/reference/**"
                ]
            },
            "dev": {
                "cache": false,
                "continuous": true,
                "dependsOn": [
                    "reference"
                ]
            },
            "preview": {
                "cache": false,
                "continuous": true,
                "dependsOn": [
                    "build"
                ]
            },
            "lint": {
                "dependsOn": [
                    "gtkx:codegen",
                    "@gtkx/gl:codegen",
                    "reference"
                ]
            },
            "typecheck": {
                "dependsOn": [
                    "reference"
                ]
            }
        }
    }
}

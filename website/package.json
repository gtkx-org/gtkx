{
    "name": "@gtkx/website",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "Marketing site for GTKX: The React framework for Linux.",
    "scripts": {
        "reference": "nx run @gtkx/website:reference",
        "reference-current": "node scripts/references.mjs current",
        "reference-stable": "node scripts/references.mjs stable",
        "dev": "vitepress dev",
        "build": "vitepress build",
        "preview": "vitepress preview"
    },
    "devDependencies": {
        "shiki": "^4.4.3",
        "typedoc": "^0.28.20",
        "typedoc-plugin-markdown": "^4.13.0",
        "typedoc-vitepress-theme": "^1.1.3",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitepress": "^2.0.0-alpha.19",
        "vue": "^3.5.41"
    },
    "nx": {
        "implicitDependencies": [
            "@gtkx/animated",
            "@gtkx/cairo",
            "@gtkx/cli",
            "@gtkx/codegen",
            "@gtkx/components",
            "@gtkx/config",
            "@gtkx/css",
            "@gtkx/forms",
            "@gtkx/gl",
            "@gtkx/i18n",
            "@gtkx/navigation",
            "@gtkx/react",
            "@gtkx/runtime",
            "@gtkx/testing",
            "@gtkx/vitest"
        ],
        "targets": {
            "build": {
                "cache": false,
                "dependsOn": [
                    "reference"
                ],
                "inputs": [
                    "default",
                    "^production",
                    {
                        "dependentTasksOutputFiles": "**/*.{md,js,d.ts,json}",
                        "transitive": true
                    }
                ],
                "outputs": [
                    "{projectRoot}/.vitepress/dist"
                ]
            },
            "reference": {
                "executor": "nx:noop",
                "cache": false,
                "dependsOn": [
                    "reference-current",
                    "reference-stable"
                ]
            },
            "reference-current": {
                "cache": true,
                "dependsOn": [
                    "gtkx:codegen",
                    "@gtkx/animated:build",
                    "@gtkx/cairo:build",
                    "@gtkx/cli:build",
                    "@gtkx/codegen:build",
                    "@gtkx/components:build",
                    "@gtkx/config:build",
                    "@gtkx/css:build",
                    "@gtkx/forms:build",
                    "@gtkx/gl:build",
                    "@gtkx/i18n:build",
                    "@gtkx/navigation:build",
                    "@gtkx/react:build",
                    "@gtkx/runtime:build",
                    "@gtkx/testing:build",
                    "@gtkx/vitest:build"
                ],
                "inputs": [
                    "default",
                    "^production",
                    "{workspaceRoot}/api.json",
                    "{workspaceRoot}/packages/eslint/src/api-entrypoints.ts",
                    {
                        "dependentTasksOutputFiles": "**/*.{d.ts,d.mts}",
                        "transitive": true
                    },
                    {
                        "externalDependencies": [
                            "typedoc",
                            "typedoc-plugin-markdown",
                            "typedoc-vitepress-theme"
                        ]
                    }
                ],
                "outputs": [
                    "{projectRoot}/v2/reference"
                ]
            },
            "reference-stable": {
                "cache": true,
                "inputs": [
                    "{projectRoot}/scripts/references.mjs",
                    "{projectRoot}/scripts/reference-search-exclude.mjs"
                ],
                "outputs": [
                    "{projectRoot}/reference"
                ]
            },
            "dev": {
                "cache": false,
                "continuous": true,
                "dependsOn": [
                    "reference"
                ]
            },
            "preview": {
                "cache": false,
                "continuous": true,
                "dependsOn": [
                    "build"
                ]
            },
            "lint": {
                "dependsOn": [
                    "gtkx:codegen",
                    "@gtkx/gl:codegen",
                    "reference"
                ],
                "options": {
                    "cwd": ".",
                    "command": "eslint {projectRoot}"
                }
            },
            "typecheck": {
                "dependsOn": [
                    "reference"
                ]
            }
        }
    }
}

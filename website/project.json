{
    "$schema": "../node_modules/nx/schemas/project-schema.json",
    "name": "@gtkx/website",
    "implicitDependencies": [
        "@gtkx/animated",
        "@gtkx/cairo",
        "@gtkx/cli",
        "@gtkx/codegen",
        "@gtkx/components",
        "@gtkx/config",
        "@gtkx/css",
        "@gtkx/forms",
        "@gtkx/gl",
        "@gtkx/i18n",
        "@gtkx/navigation",
        "@gtkx/react",
        "@gtkx/runtime",
        "@gtkx/storybook",
        "@gtkx/testing",
        "@gtkx/vitest",
        "create-gtkx"
    ],
    "targets": {
        "lint": {},
        "build": {
            "cache": true,
            "dependsOn": ["reference"],
            "inputs": [
                "default",
                "^production",
                {
                    "dependentTasksOutputFiles": "**/*.{md,js,d.ts,json}",
                    "transitive": true
                },
                {
                    "runtime": "node -e \"import('./website/.vitepress/blog.ts').then((blog) => console.log(blog.unpublishedBlogFiles('website').join(' ')))\""
                }
            ],
            "outputs": ["{projectRoot}/.vitepress/dist"],
            "command": "pnpm run build",
            "options": {
                "cwd": "{projectRoot}"
            }
        },
        "reference": {
            "executor": "nx:noop",
            "cache": true,
            "dependsOn": ["reference-current", "reference-stable"],
            "outputs": []
        },
        "reference-current": {
            "cache": true,
            "dependsOn": ["^build", "gtkx:bindings"],
            "inputs": [
                "default",
                "^production",
                {
                    "runtime": "git rev-parse HEAD"
                },
                {
                    "dependentTasksOutputFiles": "**/*.{d.ts,d.mts,d.ts.map,d.mts.map}",
                    "transitive": true
                },
                {
                    "externalDependencies": [
                        "typedoc",
                        "typedoc-plugin-markdown",
                        "typedoc-plugin-zod",
                        "typedoc-vitepress-theme"
                    ]
                }
            ],
            "outputs": ["{projectRoot}/v2/reference"],
            "command": "pnpm run reference-current",
            "options": {
                "cwd": "{projectRoot}"
            }
        },
        "reference-stable": {
            "cache": true,
            "inputs": [
                "{projectRoot}/scripts/reference*.mjs",
                {
                    "runtime": "node website/scripts/references.mjs pins"
                }
            ],
            "outputs": ["{projectRoot}/reference"],
            "command": "pnpm run reference-stable",
            "options": {
                "cwd": "{projectRoot}"
            }
        },
        "figures": {
            "cache": false,
            "dependsOn": ["^build", "gtkx:bindings"],
            "command": "vitest run",
            "options": {
                "cwd": "{projectRoot}/figures"
            }
        },
        "dev": {
            "cache": false,
            "continuous": true,
            "dependsOn": ["reference"]
        },
        "preview": {
            "cache": false,
            "continuous": true,
            "dependsOn": ["build"]
        },
        "lint-oxlint": {
            "dependsOn": ["...", "reference", "codegen-figures"]
        },
        "typecheck": {
            "command": "vue-tsc --noEmit -p tsconfig.json",
            "cache": true,
            "dependsOn": ["typecheck-figures"],
            "inputs": [
                "{projectRoot}/**/*.{ts,vue,json}",
                "{projectRoot}/.vitepress/**/*.{ts,vue,json}",
                "{workspaceRoot}/packages/create-gtkx/package.json",
                "sharedGlobals",
                {
                    "externalDependencies": ["vue-tsc", "typescript", "vue", "vitepress"]
                }
            ],
            "options": {
                "cwd": "website"
            }
        },
        "codegen-figures": {
            "command": "gtkx codegen",
            "cache": true,
            "dependsOn": ["^build"],
            "inputs": ["{projectRoot}/figures/**/*", "^production"],
            "outputs": ["{projectRoot}/figures/node_modules/.gtkx"],
            "options": {
                "cwd": "{projectRoot}/figures"
            }
        },
        "typecheck-figures": {
            "command": "tsc --build figures/tsconfig.json",
            "cache": true,
            "dependsOn": ["^build", "gtkx:bindings", "codegen-figures"],
            "inputs": ["{projectRoot}/figures/**/*", "sharedGlobals", "^production"],
            "outputs": ["{projectRoot}/figures/out-tsc", "{projectRoot}/figures/tsconfig.tsbuildinfo"],
            "options": {
                "cwd": "{projectRoot}"
            }
        }
    }
}

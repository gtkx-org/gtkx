{
    "$schema": "../node_modules/nx/schemas/project-schema.json",
    "name": "@gtkx/website",
    "implicitDependencies": [
        "@gtkx/animated",
        "@gtkx/cairo",
        "@gtkx/cli",
        "@gtkx/codegen",
        "@gtkx/components",
        "@gtkx/config",
        "@gtkx/css",
        "@gtkx/forms",
        "@gtkx/gl",
        "@gtkx/i18n",
        "@gtkx/navigation",
        "@gtkx/react",
        "@gtkx/runtime",
        "@gtkx/storybook",
        "@gtkx/testing",
        "@gtkx/vitest"
    ],
    "targets": {
        "build": {
            "cache": false,
            "dependsOn": [
                "reference"
            ],
            "inputs": [
                "default",
                "^production",
                {
                    "dependentTasksOutputFiles": "**/*.{md,js,d.ts,json}",
                    "transitive": true
                }
            ],
            "outputs": [
                "{projectRoot}/.vitepress/dist"
            ]
        },
        "reference": {
            "executor": "nx:noop",
            "cache": false,
            "dependsOn": [
                "reference-current",
                "reference-stable"
            ]
        },
        "reference-current": {
            "cache": true,
            "dependsOn": [
                "gtkx:codegen",
                "@gtkx/animated:build",
                "@gtkx/cairo:build",
                "@gtkx/cli:build",
                "@gtkx/codegen:build",
                "@gtkx/components:build",
                "@gtkx/config:build",
                "@gtkx/css:build",
                "@gtkx/forms:build",
                "@gtkx/gl:build",
                "@gtkx/i18n:build",
                "@gtkx/navigation:build",
                "@gtkx/react:build",
                "@gtkx/runtime:build",
                "@gtkx/storybook:build",
                "@gtkx/testing:build",
                "@gtkx/vitest:build"
            ],
            "inputs": [
                "default",
                "^production",
                "{workspaceRoot}/api.json",
                "{workspaceRoot}/packages/eslint/src/api-entrypoints.ts",
                {
                    "runtime": "git rev-parse HEAD"
                },
                {
                    "dependentTasksOutputFiles": "**/*.{d.ts,d.mts,d.ts.map,d.mts.map}",
                    "transitive": true
                },
                {
                    "externalDependencies": [
                        "typedoc",
                        "typedoc-plugin-markdown",
                        "typedoc-plugin-zod",
                        "typedoc-vitepress-theme"
                    ]
                }
            ],
            "outputs": [
                "{projectRoot}/v2/reference"
            ]
        },
        "reference-stable": {
            "cache": true,
            "inputs": [
                "{projectRoot}/scripts/reference*.mjs",
                {
                    "runtime": "node website/scripts/references.mjs pins"
                }
            ],
            "outputs": [
                "{projectRoot}/reference"
            ]
        },
        "dev": {
            "cache": false,
            "continuous": true,
            "dependsOn": [
                "reference"
            ]
        },
        "preview": {
            "cache": false,
            "continuous": true,
            "dependsOn": [
                "build"
            ]
        },
        "lint": {
            "dependsOn": [
                "gtkx:codegen",
                "@gtkx/gl:codegen",
                "reference"
            ]
        },
        "typecheck": {
            "command": "vue-tsc --noEmit -p tsconfig.json",
            "cache": true,
            "dependsOn": [],
            "inputs": [
                "{projectRoot}/**/*.{ts,vue,json}",
                "{projectRoot}/.vitepress/**/*.{ts,vue,json}",
                "sharedGlobals",
                {
                    "externalDependencies": [
                        "vue-tsc",
                        "typescript",
                        "vue",
                        "vitepress"
                    ]
                }
            ],
            "options": {
                "cwd": "website"
            }
        }
    }
}

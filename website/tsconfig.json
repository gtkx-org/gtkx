{
    "nx": {
        "addTypecheckTarget": false
    },
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "strict": true,
        "noEmit": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true
    },
    "include": ["env.d.ts", "**/*.ts", "**/*.vue", ".vitepress/**/*.ts", ".vitepress/**/*.vue"],
    "exclude": ["node_modules", ".vitepress/cache", ".vitepress/dist", "figures"],
    "references": [
        {
            "path": "../packages/cli"
        },
        {
            "path": "../packages/css"
        },
        {
            "path": "../packages/components"
        },
        {
            "path": "../packages/config"
        },
        {
            "path": "../packages/testing"
        },
        {
            "path": "../packages/react"
        },
        {
            "path": "../packages/navigation"
        },
        {
            "path": "../packages/create-gtkx"
        }
    ]
}

{
    "name": "gtkx-tutorial",
    "version": "1.0.0",
    "private": true,
    "license": "MPL-2.0",
    "description": "Adwaita task manager from the GTKX tutorial",
    "type": "module",
    "engines": {
        "node": ">=26.7.0"
    },
    "scripts": {
        "dev": "gtkx dev",
        "build": "gtkx build",
        "codegen": "gtkx codegen",
        "test": "vitest run && npm run test:timezone && npm run test:i18n",
        "test:timezone": "vitest run --config vitest.timezone.config.ts",
        "test:i18n": "gtkx build && vitest run --config vitest.i18n.config.ts",
        "typecheck": "gtkx codegen && tsc",
        "start": "node dist/bundle.mjs",
        "deploy": "gtkx deploy"
    },
    "dependencies": {
        "@gtkx/cairo": "^2.0.0-beta.11",
        "@gtkx/components": "^2.0.0-beta.11",
        "@gtkx/css": "^2.0.0-beta.11",
        "@gtkx/forms": "^2.0.0-beta.11",
        "@gtkx/i18n": "^2.0.0-beta.11",
        "@gtkx/navigation": "^2.0.0-beta.11",
        "@gtkx/react": "^2.0.0-beta.11",
        "@react-navigation/core": "^7.23.0",
        "react": "^19.3.0",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@gtkx/cli": "^2.0.0-beta.11",
        "@gtkx/config": "^2.0.0-beta.11",
        "@gtkx/testing": "^2.0.0-beta.11",
        "@types/node": "^26.6.3",
        "@types/react": "^19.3.0",
        "typescript": "^7.0.2",
        "vitest": "^5.0.2"
    },
    "allowScripts": {
        "@swc/core": true
    },
    "author": "GTKX <hello@gtkx.dev>",
    "homepage": "https://gtkx.dev"
}

{
    "$schema": "./node_modules/nx/schemas/project-schema.json",
    "name": "gtkx",
    "targets": {
        "local-registry": {
            "executor": "@nx/js:verdaccio",
            "cache": false,
            "options": {
                "port": 4873,
                "listenAddress": "127.0.0.1",
                "location": "none",
                "clear": true,
                "config": ".verdaccio/config.yml",
                "storage": ".local-registry/storage"
            }
        },
        "codegen": {
            "command": "node --import ./scripts/tsx.ts packages/cli/src/cli.ts codegen --config scripts/gtkx.bootstrap.ts",
            "cache": false,
            "dependsOn": [
                "@gtkx/native:build"
            ],
            "outputs": [
                "{workspaceRoot}/node_modules/.gtkx/**/*.{js,d.ts,json}"
            ]
        },
        "typecheck": {
            "command": "tsc --noEmit",
            "cache": true,
            "dependsOn": [
                "codegen",
                "build",
                "^typecheck"
            ],
            "inputs": [
                "{workspaceRoot}/tsconfig.json",
                "{workspaceRoot}/eslint.config.ts",
                "{workspaceRoot}/gtkx.config.ts",
                "{workspaceRoot}/scripts/**/*",
                "{workspaceRoot}/packages/**/*.{ts,tsx,mts,json}",
                "{workspaceRoot}/examples/**/*.{ts,tsx,mts,json}",
                "{workspaceRoot}/website/**/*.{ts,tsx,mts,json}",
                "sharedGlobals",
                {
                    "dependentTasksOutputFiles": "**/*.{d.ts,d.mts}",
                    "transitive": true
                }
            ]
        },
        "lint": {
            "command": "eslint . --ignore-pattern packages --ignore-pattern examples --ignore-pattern tutorial --ignore-pattern website",
            "cache": true,
            "dependsOn": [
                "codegen",
                "build",
                "_lint:codescythe",
                "_lint:workflows"
            ],
            "inputs": [
                "default",
                "^default",
                "{workspaceRoot}/packages/native/.gitignore",
                "{workspaceRoot}/website/.gitignore"
            ]
        },
        "build": {
            "command": "node packages/cli/dist/cli.js codegen",
            "cache": false,
            "dependsOn": [
                "@gtkx/cli:build"
            ],
            "outputs": [
                "{workspaceRoot}/.gtkx/reference"
            ]
        },
        "_lint:codescythe": {
            "command": "tsx scripts/codescythe.ts",
            "cache": true,
            "dependsOn": [
                "codegen",
                "@gtkx/gl:codegen"
            ],
            "inputs": [
                "{workspaceRoot}/codescythe.json",
                "{workspaceRoot}/package.json",
                "{workspaceRoot}/pnpm-workspace.yaml",
                "{workspaceRoot}/.gitignore",
                "{workspaceRoot}/tsconfig.json",
                "{workspaceRoot}/eslint.config.ts",
                "{workspaceRoot}/gtkx.config.ts",
                "{workspaceRoot}/scripts/**/*",
                "{workspaceRoot}/packages/**/*",
                "{workspaceRoot}/examples/**/*",
                "sharedGlobals",
                {
                    "externalDependencies": [
                        "codescythe"
                    ]
                },
                {
                    "dependentTasksOutputFiles": "**/*.{js,ts,json}",
                    "transitive": true
                }
            ]
        },
        "_registry:publish": {
            "command": "tsx scripts/local-registry.ts",
            "continuous": true,
            "dependsOn": [
                {
                    "projects": [
                        "@gtkx/*",
                        "create-gtkx",
                        "!@gtkx/e2e",
                        "!@gtkx/website"
                    ],
                    "target": "build"
                }
            ]
        },
        "_tutorial:checkpoint": {
            "command": "tsx scripts/tutorial-checkpoints.ts",
            "cache": false
        },
        "_lint:workflows": {
            "executor": "nx:run-commands",
            "cache": true,
            "inputs": [
                "{workspaceRoot}/project.json",
                "{workspaceRoot}/.github/**/*",
                "{workspaceRoot}/**/*.sh",
                "{workspaceRoot}/.shellcheckrc",
                {
                    "runtime": "go version"
                },
                {
                    "runtime": "shellcheck --version"
                },
                {
                    "env": "SHELLCHECK_OPTS"
                }
            ],
            "outputs": [],
            "options": {
                "parallel": false,
                "commands": [
                    "bash -euo pipefail -c 'git ls-files -z -- \"*.sh\" | xargs -0 -r shellcheck --shell=bash'",
                    "go run github.com/rhysd/actionlint/cmd/actionlint@v1.7.12 -pyflakes=",
                    "bash -euo pipefail -c 'for action in .github/actions/*/action.yml .github/actions/*/action.yaml; do if [ -f \"$action\" ]; then go run github.com/mikefarah/yq/v4@v4.54.1 \"{\\\"on\\\":\\\"push\\\",\\\"jobs\\\":{\\\"composite\\\":{\\\"runs-on\\\":\\\"ubuntu-latest\\\",\\\"steps\\\":.runs.steps}}}\" \"$action\" | go run github.com/rhysd/actionlint/cmd/actionlint@v1.7.12 -pyflakes= -stdin-filename \"$action\" -; fi; done'"
                ]
            }
        }
    }
}

{
    "$schema": "./node_modules/nx/schemas/project-schema.json",
    "name": "gtkx",
    "targets": {
        "codegen": {
            "command": "node packages/cli/dist/cli.js codegen --config gtkx.config.base.ts",
            "cache": true,
            "dependsOn": ["bindings", "@gtkx/cli:build"],
            "outputs": ["{workspaceRoot}/.gtkx/reference"],
            "inputs": [
                "default",
                "^production",
                {
                    "dependentTasksOutputFiles": "**/*.{js,d.ts,json}",
                    "transitive": true
                }
            ]
        },
        "typecheck": {
            "command": "tsc --noEmit",
            "cache": true,
            "dependsOn": ["build", "^typecheck"],
            "inputs": [
                "{workspaceRoot}/tsconfig.json",
                "{workspaceRoot}/eslint.config.ts",
                "{workspaceRoot}/gtkx.config.base.ts",
                "{workspaceRoot}/scripts/**/*",
                "{workspaceRoot}/packages/**/*.{ts,tsx,mts,json}",
                "{workspaceRoot}/examples/**/*.{ts,tsx,mts,json}",
                "{workspaceRoot}/website/**/*.{ts,tsx,mts,json}",
                "sharedGlobals",
                {
                    "dependentTasksOutputFiles": "**/*.{d.ts,d.mts}",
                    "transitive": true
                }
            ]
        },
        "lint": {
            "command": "oxlint . --ignore-pattern packages --ignore-pattern examples --ignore-pattern tutorial --ignore-pattern website",
            "cache": true,
            "dependsOn": ["build", "_lint:codescythe", "_lint:workflows", "_lint:format", "_lint:eslint"],
            "inputs": [
                "default",
                "^default",
                "{workspaceRoot}/packages/native/.gitignore",
                "{workspaceRoot}/website/.gitignore",
                "{workspaceRoot}/.oxlintrc.json",
                "{workspaceRoot}/pnpm-lock.yaml"
            ]
        },
        "build": {
            "executor": "nx:noop",
            "dependsOn": ["codegen"],
            "outputs": [],
            "cache": true
        },
        "_lint:codescythe": {
            "command": "tsx scripts/codescythe.ts",
            "cache": true,
            "dependsOn": ["bindings", "@gtkx/gl:codegen"],
            "inputs": [
                "{workspaceRoot}/codescythe.json",
                "{workspaceRoot}/package.json",
                "{workspaceRoot}/pnpm-workspace.yaml",
                "{workspaceRoot}/.gitignore",
                "{workspaceRoot}/tsconfig.json",
                "{workspaceRoot}/eslint.config.ts",
                "{workspaceRoot}/gtkx.config.base.ts",
                "{workspaceRoot}/scripts/**/*",
                "{workspaceRoot}/packages/**/*",
                "{workspaceRoot}/examples/**/*",
                "sharedGlobals",
                {
                    "externalDependencies": ["codescythe"]
                },
                {
                    "dependentTasksOutputFiles": "**/*.{js,ts,json}",
                    "transitive": true
                }
            ]
        },
        "_lint:workflows": {
            "executor": "nx:run-commands",
            "cache": true,
            "inputs": [
                "{workspaceRoot}/project.json",
                "{workspaceRoot}/.github/**/*",
                {
                    "runtime": "go version"
                },
                {
                    "runtime": "shellcheck --version"
                },
                {
                    "env": "SHELLCHECK_OPTS"
                }
            ],
            "outputs": [],
            "options": {
                "parallel": false,
                "commands": [
                    "go run github.com/rhysd/actionlint/cmd/actionlint@v1.7.12 -pyflakes=",
                    "bash -euo pipefail -c 'for action in .github/actions/*/action.yml .github/actions/*/action.yaml; do if [ -f \"$action\" ]; then go run github.com/mikefarah/yq/v4@v4.54.1 \"{\\\"on\\\":{\\\"workflow_dispatch\\\":{\\\"inputs\\\":((.inputs // {}) | with_entries(.value.type = \\\"string\\\"))}},\\\"jobs\\\":{\\\"composite\\\":{\\\"runs-on\\\":\\\"ubuntu-latest\\\",\\\"steps\\\":.runs.steps}}}\" \"$action\" | go run github.com/rhysd/actionlint/cmd/actionlint@v1.7.12 -pyflakes= -stdin-filename \"$action\" -; fi; done'"
                ]
            }
        },
        "_lint:format": {
            "command": "oxfmt --check .",
            "cache": true,
            "inputs": [
                "{workspaceRoot}/**/*",
                {
                    "externalDependencies": ["oxfmt"]
                }
            ],
            "outputs": []
        },
        "bindings": {
            "command": "node packages/codegen/dist/cli.js --config gtkx.config.base.ts",
            "cache": true,
            "dependsOn": ["@gtkx/codegen:build"],
            "outputs": ["{workspaceRoot}/node_modules/.gtkx"],
            "inputs": [
                "{workspaceRoot}/gtkx.config.base.ts",
                "{workspaceRoot}/package.json",
                "{workspaceRoot}/pnpm-lock.yaml",
                "{workspaceRoot}/packages/runtime/package.json",
                "{workspaceRoot}/packages/react/package.json",
                "{workspaceRoot}/packages/codegen/overrides/**/*",
                "sharedGlobals",
                {
                    "dependentTasksOutputFiles": "**/*.{js,node,d.ts,json}",
                    "transitive": true
                }
            ]
        },
        "test": {
            "dependsOn": ["@gtkx/utils:build"],
            "inputs": ["default", "^production", "{workspaceRoot}/packages/native/tools/**/*"]
        },
        "_lint:eslint": {
            "command": "eslint scripts",
            "cache": true,
            "dependsOn": ["@gtkx/utils:build"],
            "inputs": [
                "default",
                "^production",
                "sharedGlobals",
                "{workspaceRoot}/eslint.config.ts",
                "{workspaceRoot}/pnpm-lock.yaml"
            ],
            "outputs": []
        }
    }
}

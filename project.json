{
    "$schema": "./node_modules/nx/schemas/project-schema.json",
    "name": "gtkx",
    "targets": {
        "local-registry": {
            "executor": "@nx/js:verdaccio",
            "cache": false,
            "options": {
                "port": 4873,
                "listenAddress": "127.0.0.1",
                "location": "none",
                "clear": true,
                "config": ".verdaccio/config.yml",
                "storage": ".local-registry/storage"
            }
        },
        "_build:bindings": {
            "command": "node scripts/ci/run.mjs 'node --import ./scripts/tsx.ts packages/cli/src/cli.ts codegen --config scripts/gtkx.bootstrap.ts'",
            "cache": true,
            "dependsOn": [
                "@gtkx/native:build"
            ],
            "outputs": [
                "{workspaceRoot}/node_modules/.gtkx"
            ],
            "inputs": [
                "default",
                "{workspaceRoot}/**/*.{js,jsx,mjs,mts,ts,tsx,json,xml,po,pot}",
                "{workspaceRoot}/packages/codegen/overrides/**/*",
                "nativeEnvironment",
                "{workspaceRoot}/scripts/ci/**/*"
            ]
        },
        "codegen": {
            "command": "node scripts/ci/run.mjs 'node packages/cli/dist/cli.js codegen'",
            "cache": true,
            "dependsOn": [
                "@gtkx/cli:build"
            ],
            "outputs": [
                "{workspaceRoot}/.gtkx/reference"
            ],
            "inputs": [
                "default",
                "^production",
                {
                    "dependentTasksOutputFiles": "**/*.{js,d.ts,json}",
                    "transitive": true
                },
                "{workspaceRoot}/scripts/ci/**/*"
            ]
        },
        "typecheck": {
            "command": "node scripts/ci/run.mjs 'tsc --noEmit'",
            "cache": true,
            "dependsOn": [
                "build",
                "^typecheck"
            ],
            "inputs": [
                "{workspaceRoot}/tsconfig.json",
                "{workspaceRoot}/eslint.config.ts",
                "{workspaceRoot}/gtkx.config.ts",
                "{workspaceRoot}/scripts/**/*",
                "{workspaceRoot}/packages/**/*.{ts,tsx,mts,json}",
                "{workspaceRoot}/examples/**/*.{ts,tsx,mts,json}",
                "{workspaceRoot}/website/**/*.{ts,tsx,mts,json}",
                "sharedGlobals",
                {
                    "dependentTasksOutputFiles": "**/*.{d.ts,d.mts}",
                    "transitive": true
                },
                "{workspaceRoot}/scripts/ci/**/*"
            ]
        },
        "lint": {
            "command": "node scripts/ci/run.mjs 'eslint . --ignore-pattern packages --ignore-pattern examples --ignore-pattern tutorial --ignore-pattern website'",
            "cache": true,
            "dependsOn": [
                "build",
                "_lint:codescythe",
                "_lint:workflows",
                "_lint:ci"
            ],
            "inputs": [
                "default",
                "^default",
                "{workspaceRoot}/packages/native/.gitignore",
                "{workspaceRoot}/website/.gitignore",
                "{workspaceRoot}/scripts/ci/**/*"
            ]
        },
        "build": {
            "executor": "nx:noop",
            "dependsOn": [
                "codegen"
            ],
            "outputs": [],
            "cache": true
        },
        "_lint:codescythe": {
            "command": "node scripts/ci/run.mjs 'tsx scripts/codescythe.ts'",
            "cache": true,
            "dependsOn": [
                "_build:bindings",
                "@gtkx/gl:codegen"
            ],
            "inputs": [
                "{workspaceRoot}/codescythe.json",
                "{workspaceRoot}/package.json",
                "{workspaceRoot}/pnpm-workspace.yaml",
                "{workspaceRoot}/.gitignore",
                "{workspaceRoot}/tsconfig.json",
                "{workspaceRoot}/eslint.config.ts",
                "{workspaceRoot}/gtkx.config.ts",
                "{workspaceRoot}/scripts/**/*",
                "{workspaceRoot}/packages/**/*",
                "{workspaceRoot}/examples/**/*",
                "sharedGlobals",
                {
                    "externalDependencies": [
                        "codescythe"
                    ]
                },
                {
                    "dependentTasksOutputFiles": "**/*.{js,ts,json}",
                    "transitive": true
                },
                "{workspaceRoot}/scripts/ci/**/*"
            ]
        },
        "_registry:publish": {
            "command": "tsx scripts/local-registry.ts",
            "continuous": true,
            "dependsOn": [
                {
                    "projects": [
                        "@gtkx/*",
                        "create-gtkx",
                        "!@gtkx/e2e",
                        "!@gtkx/website"
                    ],
                    "target": "build"
                }
            ]
        },
        "_tutorial:checkpoint": {
            "command": "tsx scripts/tutorial-checkpoints.ts",
            "cache": false
        },
        "_lint:workflows": {
            "executor": "nx:run-commands",
            "cache": true,
            "inputs": [
                "{workspaceRoot}/project.json",
                "{workspaceRoot}/.github/**/*",
                {
                    "runtime": "node scripts/ci/run.mjs 'go version'"
                },
                {
                    "runtime": "node scripts/ci/run.mjs 'shellcheck --version'"
                },
                {
                    "env": "SHELLCHECK_OPTS"
                },
                "{workspaceRoot}/scripts/ci/**/*",
                "{workspaceRoot}/scripts/ci/**/*.sh"
            ],
            "outputs": [],
            "options": {
                "parallel": false,
                "commands": [
                    "node scripts/ci/run.mjs 'go run github.com/rhysd/actionlint/cmd/actionlint@v1.7.12 -pyflakes='",
                    "node scripts/ci/run.mjs 'bash -euo pipefail -c '\\''for action in .github/actions/*/action.yml .github/actions/*/action.yaml; do if [ -f \"$action\" ]; then go run github.com/mikefarah/yq/v4@v4.54.1 \"{\\\"on\\\":{\\\"workflow_dispatch\\\":{\\\"inputs\\\":((.inputs // {}) | with_entries(.value.type = \\\"string\\\"))}},\\\"jobs\\\":{\\\"composite\\\":{\\\"runs-on\\\":\\\"ubuntu-latest\\\",\\\"steps\\\":.runs.steps}}}\" \"$action\" | go run github.com/rhysd/actionlint/cmd/actionlint@v1.7.12 -pyflakes= -stdin-filename \"$action\" -; fi; done'\\'''",
                    "node scripts/ci/run.mjs 'shellcheck scripts/ci/*.sh'"
                ]
            }
        },
        "_lint:ci": {
            "command": "node scripts/ci/run.mjs 'node --test scripts/ci/run.test.mjs'",
            "cache": true,
            "inputs": [
                "default",
                "^default",
                "{workspaceRoot}/scripts/ci/**/*"
            ],
            "outputs": []
        }
    }
}

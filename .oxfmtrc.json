{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "printWidth": 120,
    "tabWidth": 4,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "sortImports": false,
    "sortPackageJson": false,
    "embeddedLanguageFormatting": "off",
    "ignorePatterns": [
        "**/AGENTS.md",
        "**/CLAUDE.md",
        "**/CHANGELOG.md",
        "**/fixtures/**",
        "**/gtkx-env.d.ts",
        "**/.gtkx/**",
        ".codescythe-*/**",
        "packages/gl/src/generated/**",
        "packages/native/index.js",
        "packages/native/index.d.ts",
        "packages/native/npm/**",
        "website/reference/**",
        "website/*/reference/**"
    ],
    "overrides": [
        {
            "files": ["**/*.{yaml,yml,md,mdx}"],
            "options": {
                "tabWidth": 2
            }
        }
    ]
}

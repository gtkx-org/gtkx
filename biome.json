{
    "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
    "files": {
        "includes": ["**", "!**/*.svg"]
    },
    "css": {
        "parser": {
            "cssModules": true
        }
    },
    "linter": {
        "rules": {
            "complexity": {
                "noExcessiveCognitiveComplexity": "error",
                "noExcessiveLinesPerFunction": "error",
                "useMaxParams": "error"
            },
            "style": {
                "useConsistentArrayType": {
                    "level": "error",
                    "options": {
                        "syntax": "shorthand"
                    }
                },
                "useFilenamingConvention": {
                    "level": "error",
                    "options": {
                        "requireAscii": true,
                        "filenameCases": ["kebab-case"]
                    }
                },
                "useNamingConvention": {
                    "level": "error",
                    "options": {
                        "strictCase": false,
                        "requireAscii": true,
                        "conventions": [
                            {
                                "selector": {
                                    "kind": "typeParameter"
                                },
                                "match": "T?[A-Z][a-zA-Z0-9]*"
                            },
                            {
                                "selector": {
                                    "kind": "enumMember"
                                },
                                "formats": ["CONSTANT_CASE", "PascalCase"]
                            },
                            {
                                "selector": {
                                    "kind": "objectLiteralProperty"
                                },
                                "match": "[0-9]+|[_$]*([a-zA-Z][a-zA-Z0-9_]*?)[_$]*",
                                "formats": ["camelCase", "PascalCase", "CONSTANT_CASE"]
                            },
                            {
                                "selector": {
                                    "kind": "typeProperty"
                                },
                                "match": "[0-9]+|[_$]*([a-zA-Z][a-zA-Z0-9_]*?)[_$]*",
                                "formats": ["camelCase", "PascalCase", "CONSTANT_CASE"]
                            },
                            {
                                "selector": {
                                    "kind": "typeAlias"
                                },
                                "match": "[A-Z][a-zA-Z0-9]*"
                            },
                            {
                                "selector": {
                                    "kind": "namespace"
                                },
                                "match": "[A-Za-z][A-Za-z0-9]*"
                            }
                        ]
                    }
                }
            }
        }
    },
    "formatter": {
        "enabled": true,
        "indentWidth": 4,
        "indentStyle": "space",
        "lineWidth": 120
    },
    "overrides": [
        {
            "includes": ["examples/**/*.css"],
            "linter": {
                "enabled": false
            },
            "formatter": {
                "enabled": false
            }
        },
        {
            "includes": ["packages/gl/**", "packages/e2e/tests/gl/**", "packages/react/src/hooks/use-bind-setting.ts"],
            "linter": {
                "rules": {
                    "complexity": {
                        "useMaxParams": "off"
                    }
                }
            }
        },
        {
            "includes": ["examples/tutorial/**"],
            "linter": {
                "rules": {
                    "complexity": {
                        "noExcessiveCognitiveComplexity": "off",
                        "noExcessiveLinesPerFunction": "off"
                    }
                }
            }
        },
        {
            "includes": ["**/tests/**", "**/*.test.ts", "**/*.test.tsx"],
            "linter": {
                "rules": {
                    "complexity": {
                        "noExcessiveLinesPerFunction": "off"
                    }
                }
            }
        },
        {
            "includes": ["website/**"],
            "linter": {
                "rules": {
                    "complexity": {
                        "noImportantStyles": "off"
                    },
                    "style": {
                        "useFilenamingConvention": "off"
                    }
                }
            }
        },
        {
            "includes": ["**/*.vue"],
            "linter": {
                "rules": {
                    "correctness": {
                        "noUnusedFunctionParameters": "off",
                        "noUnusedImports": "off",
                        "noUnusedVariables": "off"
                    }
                }
            }
        }
    ],
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    }
}

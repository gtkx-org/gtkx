{
    "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
    "files": {
        "includes": ["**", "!**/*.svg", "!website", "!.design-handoff"]
    },
    "css": {
        "parser": {
            "cssModules": true
        }
    },
    "linter": {
        "rules": {
            "complexity": {
                "noExcessiveCognitiveComplexity": "error",
                "noExcessiveLinesPerFunction": "error",
                "useMaxParams": "error",
                "useLiteralKeys": "off"
            },
            "style": {
                "noNonNullAssertion": "error",
                "useNodejsImportProtocol": "error",
                "useImportType": "error",
                "useExportType": "error",
                "useConsistentArrayType": {
                    "level": "error",
                    "options": {
                        "syntax": "shorthand"
                    }
                },
                "useFilenamingConvention": {
                    "level": "error",
                    "options": {
                        "requireAscii": true,
                        "filenameCases": ["kebab-case"]
                    }
                },
                "useNamingConvention": {
                    "level": "error",
                    "options": {
                        "strictCase": false,
                        "requireAscii": true,
                        "conventions": [
                            {
                                "selector": {
                                    "kind": "typeParameter"
                                },
                                "match": "T?[A-Z][a-zA-Z0-9]*"
                            },
                            {
                                "selector": {
                                    "kind": "enumMember"
                                },
                                "formats": ["CONSTANT_CASE", "PascalCase"]
                            },
                            {
                                "selector": {
                                    "kind": "objectLiteralProperty"
                                },
                                "match": "[0-9]+|[_$]*([a-zA-Z][a-zA-Z0-9_]*?)[_$]*",
                                "formats": ["camelCase", "PascalCase", "CONSTANT_CASE"]
                            },
                            {
                                "selector": {
                                    "kind": "typeProperty"
                                },
                                "match": "[0-9]+|[_$]*([a-zA-Z][a-zA-Z0-9_]*?)[_$]*",
                                "formats": ["camelCase", "PascalCase", "CONSTANT_CASE"]
                            },
                            {
                                "selector": {
                                    "kind": "typeAlias"
                                },
                                "match": "[A-Z][a-zA-Z0-9]*"
                            },
                            {
                                "selector": {
                                    "kind": "namespace"
                                },
                                "match": "[A-Za-z][A-Za-z0-9]*"
                            }
                        ]
                    }
                }
            }
        }
    },
    "formatter": {
        "enabled": true,
        "indentWidth": 4,
        "indentStyle": "space",
        "lineWidth": 120
    },
    "overrides": [
        {
            "includes": ["examples/**/*.css"],
            "linter": {
                "enabled": false
            },
            "formatter": {
                "enabled": false
            }
        },
        {
            "includes": ["packages/gl/**"],
            "linter": {
                "rules": {
                    "complexity": {
                        "useMaxParams": "off"
                    }
                }
            }
        },
        {
            "includes": ["packages/codegen/src/templates/**"],
            "linter": {
                "rules": {
                    "complexity": {
                        "useMaxParams": "off"
                    }
                }
            }
        },
        {
            "includes": ["**/tests/**"],
            "linter": {
                "rules": {
                    "complexity": {
                        "noExcessiveLinesPerFunction": "off"
                    }
                }
            }
        }
    ],
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    }
}

{
    "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
    "files": {
        "includes": ["**", "!**/*.svg"]
    },
    "css": {
        "parser": {
            "cssModules": true
        }
    },
    "linter": {
        "rules": {
            "complexity": {
                "noExcessiveCognitiveComplexity": "error",
                "noExcessiveLinesPerFunction": "error",
                "useMaxParams": "error"
            },
            "style": {
                "noNonNullAssertion": "error",
                "useNodejsImportProtocol": "error",
                "useImportType": "error",
                "useExportType": "error",
                "useConsistentArrayType": {
                    "level": "error",
                    "options": { "syntax": "shorthand" }
                },
                "useFilenamingConvention": {
                    "level": "error",
                    "options": {
                        "requireAscii": true,
                        "filenameCases": ["kebab-case"]
                    }
                },
                "useNamingConvention": {
                    "level": "error",
                    "options": {
                        "strictCase": false,
                        "requireAscii": true,
                        "conventions": [
                            { "selector": { "kind": "typeParameter" }, "match": "T?[A-Z][a-zA-Z0-9]*" },
                            { "selector": { "kind": "enumMember" }, "formats": ["CONSTANT_CASE", "PascalCase"] },
                            {
                                "selector": { "kind": "objectLiteralProperty" },
                                "match": "\\$?\\$?_?_?[a-zA-Z][a-zA-Z0-9_]*_?_?\\$?\\$?",
                                "formats": ["camelCase", "PascalCase", "CONSTANT_CASE"]
                            },
                            {
                                "selector": { "kind": "typeProperty" },
                                "match": "\\$?\\$?_?_?[a-zA-Z][a-zA-Z0-9_]*_?_?\\$?\\$?",
                                "formats": ["camelCase", "PascalCase", "CONSTANT_CASE"]
                            },
                            {
                                "selector": { "kind": "typeAlias" },
                                "formats": ["PascalCase"]
                            }
                        ]
                    }
                }
            }
        }
    },
    "formatter": {
        "enabled": true,
        "indentWidth": 4,
        "indentStyle": "space",
        "lineWidth": 120
    },
    "overrides": [
        {
            "includes": ["examples/**/*.css"],
            "linter": {
                "enabled": false
            },
            "formatter": {
                "enabled": false
            }
        },
        {
            "includes": ["examples/gtk-demo/**"],
            "linter": {
                "rules": {
                    "complexity": {
                        "noExcessiveCognitiveComplexity": "off",
                        "noExcessiveLinesPerFunction": "off",
                        "useMaxParams": "off"
                    },
                    "style": {
                        "useNamingConvention": "off"
                    }
                }
            }
        },
        {
            "includes": ["packages/gl/src/generated/**"],
            "linter": {
                "rules": {
                    "complexity": {
                        "useMaxParams": "off"
                    },
                    "style": {
                        "useNamingConvention": "off"
                    }
                }
            }
        },
        {
            "includes": [
                "packages/codegen/src/templates/**",
                "packages/ffi/src/cairo.ts",
                "packages/ffi/src/gtype.ts",
                "packages/ffi/src/listeners.ts",
                "packages/ffi/src/value-marshal.ts",
                "packages/ffi/src/signals.ts",
                "packages/ffi/src/gobject/**",
                "packages/react/src/element-props.ts"
            ],
            "linter": {
                "rules": {
                    "style": {
                        "useNamingConvention": "off"
                    }
                }
            }
        },
        {
            "includes": ["website/.vitepress/**/*.vue"],
            "linter": {
                "enabled": false
            }
        },
        {
            "includes": ["packages/*/tests/**", "website/screenshots/**"],
            "linter": {
                "rules": {
                    "complexity": {
                        "noExcessiveLinesPerFunction": "off"
                    }
                }
            }
        }
    ],
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    }
}

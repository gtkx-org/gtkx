{
    "name": "@gtkx/eslint",
    "version": "0.0.0",
    "description": "Internal ESLint flat config and custom lint rules for the GTKX workspace",
    "private": true,
    "type": "module",
    "nx": {
        "targets": {
            "lint": {
                "options": {
                    "cwd": ".",
                    "command": "eslint {projectRoot}"
                },
                "dependsOn": []
            },
            "build": {
                "dependsOn": []
            },
            "typecheck": {
                "dependsOn": []
            },
            "test": {
                "dependsOn": []
            }
        }
    },
    "exports": {
        "./package.json": "./package.json",
        ".": "./src/index.ts"
    },
    "engines": {
        "node": ">=26.7.0"
    },
    "dependencies": {
        "@eslint/js": "^10.0.1",
        "@nx/eslint-plugin": "^23.2.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@typescript-eslint/eslint-plugin": "^8.71.0",
        "@typescript-eslint/utils": "^8.70.0",
        "@vitest/eslint-plugin": "^1.6.27",
        "eslint": "^10.10.0",
        "eslint-plugin-perfectionist": "^5.12.1",
        "eslint-plugin-promise": "^7.3.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-sonarjs": "^4.2.2",
        "eslint-plugin-unicorn": "^76.0.0",
        "eslint-plugin-vue": "^10.11.1",
        "jsonc-eslint-parser": "^3.3.0",
        "typescript": "catalog:",
        "typescript-eslint": "^8.71.0",
        "vue-eslint-parser": "^10.4.1"
    },
    "devDependencies": {
        "@typescript-eslint/rule-tester": "^8.71.0",
        "vitest": "catalog:"
    }
}

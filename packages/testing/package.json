{
    "name": "@gtkx/testing",
    "version": "1.0.0-rc.1",
    "description": "Testing Library-style queries, user events, and screenshots for GTK4 widget trees rendered by GTKX",
    "keywords": [
        "gtkx",
        "gtk",
        "gtk4",
        "react",
        "typescript",
        "testing",
        "testing-library",
        "linux",
        "desktop"
    ],
    "homepage": "https://gtkx.dev",
    "bugs": {
        "url": "https://github.com/gtkx-org/gtkx/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gtkx-org/gtkx.git",
        "directory": "packages/testing"
    },
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "sideEffects": [
        "./src/register-test-hooks.ts",
        "./dist/register-test-hooks.js"
    ],
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "tsc -b tsconfig.lib.json",
        "typecheck": "tsc -b --emitDeclarationOnly",
        "release": "tsx ../../scripts/release-package.ts"
    },
    "engines": {
        "node": ">=24"
    },
    "dependencies": {
        "@gtkx/runtime": "workspace:*",
        "@gtkx/react": "workspace:*",
        "@gtkx/utils": "workspace:*"
    },
    "devDependencies": {
        "@gtkx/config": "workspace:*",
        "@gtkx/vitest": "workspace:*",
        "@vitest/expect": "^4.1.10",
        "vitest": "catalog:"
    }
}

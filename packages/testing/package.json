{
    "name": "@gtkx/testing",
    "version": "0.21.0",
    "description": "Testing utilities for GTKX applications",
    "keywords": [
        "gtkx",
        "gtk",
        "gtk4",
        "react",
        "typescript",
        "testing",
        "testing-library",
        "linux",
        "desktop"
    ],
    "homepage": "https://gtkx.dev",
    "bugs": {
        "url": "https://github.com/gtkx-org/gtkx/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/gtkx-org/gtkx.git",
        "directory": "packages/testing"
    },
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./act": {
            "source": "./src/act.ts",
            "types": "./dist/act.d.ts",
            "default": "./dist/act.js"
        }
    },
    "sideEffects": [
        "./src/setup-runtime.ts",
        "./dist/setup-runtime.js"
    ],
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "tsc -b"
    },
    "engines": {
        "node": ">=26"
    },
    "dependencies": {
        "@gtkx/ffi": "workspace:*",
        "@gtkx/react": "workspace:*",
        "@gtkx/utils": "workspace:*"
    },
    "devDependencies": {
        "@gtkx/config": "workspace:*",
        "@gtkx/vitest": "workspace:*"
    }
}

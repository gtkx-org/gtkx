{
    "name": "@gtkx/testing",
    "version": "2.0.0-beta.2",
    "description": "Queries, events, and screenshots for GTK and GTK4 widget trees.",
    "keywords": [
        "gtkx",
        "gtk",
        "gtk4",
        "react",
        "typescript",
        "testing",
        "testing-library",
        "linux",
        "desktop"
    ],
    "homepage": "https://gtkx.dev",
    "bugs": {
        "url": "https://github.com/gtkx-org/gtkx/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gtkx-org/gtkx.git",
        "directory": "packages/testing"
    },
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": null,
            "default": "./dist/index.js"
        },
        "./internal": {
            "source": "./src/internal.ts",
            "types": "./dist/internal.d.ts",
            "import": "./dist/internal.js",
            "require": null,
            "default": "./dist/internal.js"
        }
    },
    "sideEffects": [
        "./src/register-test-hooks.ts",
        "./dist/register-test-hooks.js"
    ],
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "release": "tsx ../../scripts/release-package.ts"
    },
    "nx": {
        "targets": {
            "lint": {
                "options": {
                    "cwd": ".",
                    "command": "eslint {projectRoot}"
                }
            }
        }
    },
    "engines": {
        "node": ">=26.7.0"
    },
    "dependencies": {
        "@gtkx/runtime": "workspace:*",
        "@gtkx/react": "workspace:*",
        "@gtkx/utils": "workspace:*",
        "@vitest/expect": "^4.1.11",
        "@vitest/pretty-format": "^4.1.11"
    },
    "peerDependencies": {
        "@types/react": "^19.2",
        "react": "^19.2"
    },
    "devDependencies": {
        "@gtkx/config": "workspace:*",
        "@types/react": "catalog:"
    }
}

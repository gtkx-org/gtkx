{
    "name": "@gtkx/components",
    "version": "1.0.0-rc.1",
    "description": "High-level GTKX components for declarative collection views, menus, and containers with attach-time placement",
    "keywords": [
        "gtkx",
        "gtk",
        "gtk4",
        "adwaita",
        "react",
        "components",
        "linux",
        "desktop"
    ],
    "homepage": "https://gtkx.dev",
    "bugs": {
        "url": "https://github.com/gtkx-org/gtkx/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gtkx-org/gtkx.git",
        "directory": "packages/components"
    },
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./adw": {
            "source": "./src/adw/index.ts",
            "types": "./dist/adw/index.d.ts",
            "default": "./dist/adw/index.js"
        }
    },
    "sideEffects": false,
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "bench": "NODE_ENV=production vitest bench --run --config vitest.bench.config.ts",
        "release": "tsx ../../scripts/release-package.ts"
    },
    "engines": {
        "node": ">=24"
    },
    "dependencies": {
        "@gtkx/react": "workspace:*",
        "@gtkx/utils": "workspace:*"
    },
    "peerDependencies": {
        "react": "^19.2"
    },
    "devDependencies": {
        "@codspeed/vitest-plugin": "^5.7.1",
        "@gtkx/config": "workspace:*",
        "@gtkx/runtime": "workspace:*",
        "@gtkx/testing": "workspace:*",
        "@gtkx/vitest": "workspace:*",
        "vitest": "catalog:"
    }
}

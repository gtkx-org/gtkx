{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "name": "@gtkx/e2e",
    "targets": {
        "lint": {
            "dependsOn": [
                "codegen",
                "@gtkx/gl:codegen",
                "test-fixtures"
            ]
        },
        "test-fixtures": {
            "dependsOn": [
                "@gtkx/utils:build"
            ],
            "cache": false
        },
        "test:asan": {
            "dependsOn": [
                "test-fixtures",
                "@gtkx/runtime:build",
                "@gtkx/utils:build"
            ],
            "cache": true,
            "inputs": [
                "nodeTests",
                "{workspaceRoot}/packages/native/tests/**/*",
                "{workspaceRoot}/packages/native/vitest.config.ts",
                "{workspaceRoot}/packages/native/package.json",
                "{workspaceRoot}/packages/native/*.js"
            ],
            "outputs": []
        },
        "test": {
            "command": "vitest run --exclude '**/tests/testing/query-perf.test.tsx' && vitest run --config tests/native/vitest.config.ts",
            "dependsOn": [
                "test-fixtures",
                "@gtkx/native:build",
                "codegen"
            ],
            "cache": true,
            "inputs": [
                "nodeTests",
                {
                    "dependentTasksOutputFiles": "**/*.node",
                    "transitive": true
                }
            ],
            "options": {
                "cwd": "{projectRoot}"
            }
        },
        "typecheck": {
            "dependsOn": [
                "build",
                "^typecheck",
                "codegen",
                "test-fixtures"
            ]
        },
        "codegen": {
            "command": "gtkx codegen",
            "options": {
                "cwd": "{projectRoot}"
            },
            "cache": false,
            "dependsOn": [
                "gtkx:codegen",
                "@gtkx/cli:build"
            ],
            "outputs": [
                "{projectRoot}/node_modules/.gtkx/**/*.{js,d.ts,json}"
            ]
        }
    },
    "namedInputs": {
        "nodeTests": [
            "default",
            "{workspaceRoot}/packages/native/src/**/*",
            "{workspaceRoot}/packages/native/build.rs",
            "{workspaceRoot}/packages/native/Cargo.toml",
            "{workspaceRoot}/packages/native/Cargo.lock",
            "{workspaceRoot}/rust-toolchain.toml",
            "{workspaceRoot}/scripts/native-test-fixtures.ts",
            "{workspaceRoot}/scripts/asan-native.ts",
            "{workspaceRoot}/scripts/rust-nightly.ts",
            "{workspaceRoot}/packages/vitest/src/**/*",
            "{workspaceRoot}/packages/codegen/src/**/*",
            "{workspaceRoot}/packages/runtime/src/**/*",
            "{workspaceRoot}/packages/utils/src/**/*",
            "nativeEnvironment"
        ]
    }
}

<?xml version="1.0"?>
<repository version="1.2"
            xmlns="http://www.gtk.org/introspection/core/1.0"
            xmlns:c="http://www.gtk.org/introspection/c/1.0"
            xmlns:glib="http://www.gtk.org/introspection/glib/1.0">
  <include name="GLib" version="2.0"/>
  <include name="GObject" version="2.0"/>
  <package name="hookslots-1.0"/>
  <namespace name="HookSlots"
             version="1.0"
             shared-library="libhookslots.so.0"
             c:identifier-prefixes="HookSlots"
             c:symbol-prefixes="hook_slots">
    <callback name="HookFunc" c:type="HookSlotsHookFunc">
      <return-value transfer-ownership="none">
        <type name="gboolean" c:type="gboolean"/>
      </return-value>
      <parameters>
        <parameter name="value" transfer-ownership="none">
          <type name="gint" c:type="gint"/>
        </parameter>
        <parameter name="user_data" transfer-ownership="none" nullable="1" allow-none="1" closure="1">
          <type name="gpointer" c:type="gpointer"/>
        </parameter>
      </parameters>
    </callback>
    <alias name="HookAlias" c:type="HookSlotsHookAlias">
      <type name="HookFunc" c:type="HookSlotsHookFunc"/>
    </alias>
    <alias name="HookAliasChain" c:type="HookSlotsHookAliasChain">
      <type name="HookAlias" c:type="HookSlotsHookAlias"/>
    </alias>
    <class name="Station"
           c:symbol-prefix="station"
           c:type="HookSlotsStation"
           parent="GObject.Object"
           glib:type-name="HookSlotsStation"
           glib:get-type="hook_slots_station_get_type"
           glib:type-struct="StationClass">
      <method name="get_property" c:identifier="hook_slots_station_get_property">
        <return-value transfer-ownership="none" nullable="1">
          <type name="utf8" c:type="const gchar*"/>
        </return-value>
        <parameters>
          <instance-parameter name="station" transfer-ownership="none">
            <type name="Station" c:type="HookSlotsStation*"/>
          </instance-parameter>
          <parameter name="key" transfer-ownership="none">
            <type name="utf8" c:type="const gchar*"/>
          </parameter>
        </parameters>
      </method>
      <method name="invoke_watch" c:identifier="hook_slots_station_invoke_watch">
        <return-value transfer-ownership="none">
          <type name="none" c:type="void"/>
        </return-value>
        <parameters>
          <instance-parameter name="station" transfer-ownership="none">
            <type name="Station" c:type="HookSlotsStation*"/>
          </instance-parameter>
          <parameter name="has_callback" transfer-ownership="none">
            <type name="gboolean" c:type="gboolean"/>
          </parameter>
        </parameters>
      </method>
    </class>
    <record name="StationClass"
            c:type="HookSlotsStationClass"
            glib:is-gtype-struct-for="Station">
      <field name="parent_class">
        <type name="GObject.ObjectClass" c:type="GObjectClass"/>
      </field>
      <field name="bind">
        <callback name="bind">
          <return-value transfer-ownership="none">
            <type name="none" c:type="void"/>
          </return-value>
          <parameters>
            <parameter name="self" transfer-ownership="none">
              <type name="Station" c:type="HookSlotsStation*"/>
            </parameter>
            <parameter name="hook"
                       transfer-ownership="none"
                       nullable="1"
                       allow-none="1"
                       scope="async"
                       closure="2">
              <type name="HookFunc" c:type="HookSlotsHookFunc"/>
            </parameter>
            <parameter name="user_data" transfer-ownership="none" nullable="1" allow-none="1">
              <type name="gpointer" c:type="gpointer"/>
            </parameter>
          </parameters>
        </callback>
      </field>
      <field name="watch">
        <callback name="watch">
          <return-value transfer-ownership="none">
            <type name="none" c:type="void"/>
          </return-value>
          <parameters>
            <parameter name="self" transfer-ownership="none">
              <type name="Station" c:type="HookSlotsStation*"/>
            </parameter>
            <parameter name="hook"
                       transfer-ownership="none"
                       nullable="1"
                       allow-none="1"
                       scope="notified"
                       closure="2"
                       destroy="3">
              <type name="HookAliasChain" c:type="HookSlotsHookAliasChain"/>
            </parameter>
            <parameter name="user_data" transfer-ownership="none" nullable="1" allow-none="1">
              <type name="gpointer" c:type="gpointer"/>
            </parameter>
            <parameter name="destroy" transfer-ownership="none" nullable="1" allow-none="1" scope="async">
              <type name="GLib.DestroyNotify" c:type="GDestroyNotify"/>
            </parameter>
          </parameters>
        </callback>
      </field>
      <field name="defer">
        <callback name="defer">
          <return-value transfer-ownership="none">
            <type name="none" c:type="void"/>
          </return-value>
          <parameters>
            <parameter name="self" transfer-ownership="none">
              <type name="Station" c:type="HookSlotsStation*"/>
            </parameter>
            <parameter name="hook"
                       transfer-ownership="none"
                       nullable="1"
                       allow-none="1"
                       scope="async"
                       closure="3">
              <type name="HookAliasChain" c:type="HookSlotsHookAliasChain"/>
            </parameter>
            <parameter name="stride" transfer-ownership="none">
              <type name="gint" c:type="gint"/>
            </parameter>
            <parameter name="user_data" transfer-ownership="none" nullable="1" allow-none="1">
              <type name="gpointer" c:type="gpointer"/>
            </parameter>
          </parameters>
        </callback>
      </field>
      <field name="get_hook">
        <callback name="get_hook">
          <return-value transfer-ownership="none" nullable="1">
            <type name="HookAliasChain" c:type="HookSlotsHookAliasChain"/>
          </return-value>
          <parameters>
            <parameter name="self" transfer-ownership="none">
              <type name="Station" c:type="HookSlotsStation*"/>
            </parameter>
          </parameters>
        </callback>
      </field>
    </record>
    <function name="get_data_destroy_count" c:identifier="hook_slots_get_data_destroy_count">
      <return-value transfer-ownership="none">
        <type name="guint" c:type="guint"/>
      </return-value>
    </function>
    <function name="get_callback_count" c:identifier="hook_slots_get_callback_count">
      <return-value transfer-ownership="none">
        <type name="guint" c:type="guint"/>
      </return-value>
    </function>
    <function name="get_base_call_count" c:identifier="hook_slots_get_base_call_count">
      <return-value transfer-ownership="none">
        <type name="guint" c:type="guint"/>
      </return-value>
    </function>
    <function name="get_null_call_count" c:identifier="hook_slots_get_null_call_count">
      <return-value transfer-ownership="none">
        <type name="guint" c:type="guint"/>
      </return-value>
    </function>
    <function name="get_last_value" c:identifier="hook_slots_get_last_value">
      <return-value transfer-ownership="none">
        <type name="gint" c:type="gint"/>
      </return-value>
    </function>
    <function name="get_base_result" c:identifier="hook_slots_get_base_result">
      <return-value transfer-ownership="none">
        <type name="gboolean" c:type="gboolean"/>
      </return-value>
    </function>
  </namespace>
</repository>

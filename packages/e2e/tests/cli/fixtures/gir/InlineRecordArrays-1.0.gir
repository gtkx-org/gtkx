          <type name="Pure" c:type="InlineRecordArraysPure"/>
        </array>
      </return-value>
    </callback>
    <function name="borrow_values" c:identifier="inline_record_arrays_borrow_values">
      <return-value transfer-ownership="none"><type name="none" c:type="void"/></return-value>
      <parameters>
        <parameter name="values" transfer-ownership="none">

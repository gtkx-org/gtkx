  <include name="Gio" version="2.0"/>
  <include name="GObject" version="2.0"/>
  <namespace name="InlineRecordArrays" version="1.0" shared-library="libinline-record-arrays.so.0"
      c:identifier-prefixes="InlineRecordArrays" c:symbol-prefixes="inline_record_arrays">
    <record name="Pure" c:type="InlineRecordArraysPure" c:symbol-prefix="pure">
      <field name="count" writable="1"><type name="gint" c:type="gint"/></field>
      <field name="weight" writable="1"><type name="gdouble" c:type="gdouble"/></field>
    </record>
    <record name="StringSlot" c:type="InlineRecordArraysStringSlot" c:symbol-prefix="string_slot">
      <field name="text" writable="1"><type name="utf8" c:type="gchar*"/></field>
      <field name="count" writable="1"><type name="gint" c:type="gint"/></field>
    </record>
    <callback name="LentStringSlots" c:type="InlineRecordArraysLentStringSlots">
      <return-value transfer-ownership="none"><type name="none" c:type="void"/></return-value>
      <parameters>
        <parameter name="slots" transfer-ownership="none">
          <array fixed-size="2" zero-terminated="0" c:type="const InlineRecordArraysStringSlot*">
            <type name="StringSlot" c:type="InlineRecordArraysStringSlot"/>
          </array>
        </parameter>
      </parameters>
    </callback>
    <callback name="ReturnStringSlots" c:type="InlineRecordArraysReturnStringSlots">
      <return-value transfer-ownership="full">

<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <enum id="org.gtkx.test.WrapMode">
    <value nick="none" value="0"/>
    <value nick="word" value="1"/>
    <value nick="char" value="2"/>
  </enum>
  <schema id="com.gtkx.test.useSetting" path="/com/gtkx/test/useSetting/">
    <key name="enabled" type="b">
      <default>false</default>
      <summary>Enabled flag</summary>
    </key>
    <key name="count" type="i">
      <default>0</default>
      <summary>Counter</summary>
    </key>
    <key name="ratio" type="d">
      <default>1.0</default>
      <summary>Ratio</summary>
    </key>
    <key name="label" type="s">
      <default>"initial"</default>
      <summary>Label string</summary>
    </key>
    <key name="tags" type="as">
      <default>[]</default>
      <summary>Tag list</summary>
    </key>
    <key name="wrap-mode" enum="org.gtkx.test.WrapMode">
      <default>'none'</default>
      <summary>Wrap mode</summary>
    </key>
    <key name="theme" type="s">
      <choices>
        <choice value="default"/>
        <choice value="light"/>
        <choice value="dark"/>
      </choices>
      <default>'default'</default>
      <summary>Theme</summary>
    </key>
    <key name="retries" type="u">
      <default>3</default>
      <summary>Retry count</summary>
    </key>
    <key name="window-size" type="(ii)">
      <default>(800, 600)</default>
      <summary>Window size</summary>
    </key>
    <key name="payload" type="ay">
      <default>[1, 2]</default>
      <summary>Payload bytes</summary>
    </key>
    <key name="metadata" type="a{ss}">
      <default>{'origin': 'default'}</default>
      <summary>Metadata map</summary>
    </key>
    <key name="extras" type="a{sv}">
      <default>{}</default>
      <summary>Extra values</summary>
    </key>
    <key name="scores" type="a{ix}">
      <default>{}</default>
      <summary>Scores by id</summary>
    </key>
    <key name="matrix" type="aai">
      <default>[[1], [2, 3]]</default>
      <summary>Matrix rows</summary>
    </key>
    <key name="opt-limit" type="mi">
      <default>nothing</default>
      <summary>Optional limit</summary>
    </key>
    <key name="wrapped" type="v">
      <default>&lt;'hello'&gt;</default>
      <summary>Wrapped variant</summary>
    </key>
    <key name="big-offsets" type="ax">
      <default>[1, 2]</default>
      <summary>Big offsets</summary>
    </key>
    <key name="small-signed" type="n">
      <default>-32768</default>
      <summary>Small signed number</summary>
    </key>
    <key name="small-unsigned" type="q">
      <default>65535</default>
      <summary>Small unsigned number</summary>
    </key>
    <key name="one-byte" type="y">
      <default>255</default>
      <summary>Single byte</summary>
    </key>
    <key name="handle-slot" type="h">
      <default>0</default>
      <summary>Handle slot</summary>
    </key>
    <key name="bus-path" type="o">
      <default>'/com/gtkx/test'</default>
      <summary>Bus object path</summary>
    </key>
    <key name="bus-signature" type="g">
      <default>'a{sv}'</default>
      <summary>Bus type signature</summary>
    </key>
    <key name="big-signed" type="x">
      <default>-9223372036854775808</default>
      <summary>Big signed number</summary>
    </key>
    <key name="big-unsigned" type="t">
      <default>18446744073709551615</default>
      <summary>Big unsigned number</summary>
    </key>
    <key name="pair" type="{ss}">
      <default>{'k', 'v'}</default>
      <summary>Key value pair</summary>
    </key>
    <child name="nested" schema="com.gtkx.test.useSetting.nested"/>
  </schema>
  <schema id="com.gtkx.test.useSetting.nested" path="/com/gtkx/test/useSetting/nested/">
    <key name="depth" type="i">
      <default>1</default>
      <summary>Nested depth</summary>
    </key>
  </schema>
  <schema id="com.gtkx.test.useSetting.profile">
    <key name="title" type="s">
      <default>'untitled'</default>
      <summary>Profile title</summary>
    </key>
  </schema>
</schemalist>

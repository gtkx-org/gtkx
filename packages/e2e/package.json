{
    "name": "@gtkx/e2e",
    "version": "0.0.0",
    "description": "Internal integration tests covering the GTKX reconciler, runtime, and testing library",
    "private": true,
    "type": "module",
    "devDependencies": {
        "@gtkx/cairo": "workspace:*",
        "@gtkx/config": "workspace:*",
        "@gtkx/css": "workspace:*",
        "@gtkx/gl": "workspace:*",
        "@gtkx/native": "workspace:*",
        "@gtkx/react": "workspace:*",
        "@gtkx/runtime": "workspace:*",
        "@gtkx/testing": "workspace:*",
        "@gtkx/utils": "workspace:*",
        "@gtkx/vitest": "workspace:*",
        "react": "catalog:"
    },
    "nx": {
        "targets": {
            "lint": {
                "dependsOn": [
                    "gtkx:codegen",
                    "@gtkx/gl:codegen",
                    "test-fixtures"
                ],
                "options": {
                    "cwd": ".",
                    "command": "eslint {projectRoot}"
                }
            },
            "test-fixtures": {
                "dependsOn": [
                    "@gtkx/utils:build"
                ],
                "cache": false
            },
            "test:asan": {
                "dependsOn": [
                    "test-fixtures",
                    "@gtkx/runtime:build",
                    "@gtkx/utils:build"
                ],
                "cache": true,
                "inputs": [
                    "nodeTests"
                ],
                "outputs": []
            },
            "test": {
                "dependsOn": [
                    "test-fixtures",
                    "@gtkx/native:build"
                ],
                "cache": true,
                "inputs": [
                    "nodeTests"
                ],
                "options": {
                    "command": "vitest run && vitest run --config tests/native/vitest.config.ts"
                }
            },
            "typecheck": {
                "dependsOn": [
                    "build",
                    "^typecheck",
                    "gtkx:codegen",
                    "test-fixtures"
                ]
            }
        },
        "namedInputs": {
            "nodeTests": [
                "default",
                "{workspaceRoot}/packages/native/src/**/*",
                "{workspaceRoot}/packages/native/build.rs",
                "{workspaceRoot}/packages/native/Cargo.toml",
                "{workspaceRoot}/packages/native/Cargo.lock",
                "{workspaceRoot}/rust-toolchain.toml",
                "{workspaceRoot}/scripts/native-test-fixtures.ts",
                "{workspaceRoot}/scripts/asan-native.ts",
                "{workspaceRoot}/scripts/rust-nightly.ts",
                "{workspaceRoot}/packages/vitest/src/**/*",
                "{workspaceRoot}/packages/codegen/src/**/*",
                "{workspaceRoot}/packages/runtime/src/**/*",
                "{workspaceRoot}/packages/utils/src/**/*"
            ]
        }
    },
    "scripts": {
        "test:asan": "tsx ../../scripts/asan-native.ts",
        "test-fixtures": "tsx ../../scripts/native-test-fixtures.ts"
    }
}

{
    "name": "@gtkx/e2e",
    "version": "0.0.0",
    "description": "Internal integration tests and benchmarks covering the GTKX reconciler, runtime, and native FFI",
    "private": true,
    "type": "module",
    "scripts": {
        "bench": "NODE_ENV=production vitest bench --run --config vitest.bench.config.ts",
        "test:asan": "tsx ../../scripts/asan-e2e.ts"
    },
    "devDependencies": {
        "@codspeed/vitest-plugin": "^5.7.1",
        "@gtkx/config": "workspace:*",
        "@gtkx/runtime": "workspace:*",
        "@gtkx/native": "workspace:*",
        "@gtkx/react": "workspace:*",
        "@gtkx/testing": "workspace:*",
        "@gtkx/utils": "workspace:*",
        "@gtkx/vitest": "workspace:*",
        "react": "catalog:"
    },
    "nx": {
        "targets": {
            "test:asan": {
                "cache": false,
                "dependsOn": [
                    "gtkx:codegen",
                    "@gtkx/vitest:build",
                    "@gtkx/cli:build",
                    "@gtkx/components:build",
                    "@gtkx/css:build",
                    "@gtkx/gl:build"
                ]
            }
        }
    }
}

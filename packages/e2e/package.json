{
    "name": "@gtkx/e2e",
    "version": "0.0.0",
    "description": "Internal integration tests and benchmarks covering the GTKX reconciler, runtime, and native FFI",
    "private": true,
    "type": "module",
    "scripts": {
        "test:asan": "tsx ../../scripts/asan-e2e.ts"
    },
    "devDependencies": {
        "@gtkx/cairo": "workspace:*",
        "@gtkx/config": "workspace:*",
        "@gtkx/gl": "workspace:*",
        "@gtkx/native": "workspace:*",
        "@gtkx/react": "workspace:*",
        "@gtkx/runtime": "workspace:*",
        "@gtkx/testing": "workspace:*",
        "@gtkx/utils": "workspace:*",
        "@gtkx/vitest": "workspace:*",
        "react": "catalog:"
    },
    "nx": {
        "targets": {
            "lint": {
                "options": {
                    "cwd": ".",
                    "command": "eslint {projectRoot}"
                }
            },
            "test:asan": {
                "cache": true,
                "inputs": [
                    "default",
                    "^default",
                    "{workspaceRoot}/rust-toolchain.toml",
                    "{workspaceRoot}/scripts/asan-e2e.ts",
                    "{workspaceRoot}/scripts/rust-nightly.ts"
                ],
                "outputs": [],
                "dependsOn": [
                    "gtkx:codegen",
                    "@gtkx/vitest:build",
                    "@gtkx/cli:build",
                    "@gtkx/components:build",
                    "@gtkx/css:build",
                    "@gtkx/gl:build"
                ]
            }
        }
    }
}

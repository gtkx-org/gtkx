{
    "name": "@gtkx/react",
    "version": "0.21.0",
    "description": "Build GTK4 desktop applications with React and TypeScript",
    "keywords": [
        "gtkx",
        "gtk",
        "gtk4",
        "react",
        "typescript",
        "linux",
        "desktop",
        "gui",
        "native"
    ],
    "homepage": "https://gtkx.dev",
    "bugs": {
        "url": "https://github.com/gtkx-org/gtkx/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/gtkx-org/gtkx.git",
        "directory": "packages/react"
    },
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./internal": {
            "source": "./src/internal.ts",
            "types": "./dist/internal.d.ts",
            "default": "./dist/internal.js"
        }
    },
    "sideEffects": false,
    "files": [
        "dist",
        "src",
        "!**/*.tsbuildinfo"
    ],
    "scripts": {
        "build": "tsc -b tsconfig.lib.json",
        "typecheck": "tsc -b --emitDeclarationOnly",
        "release": "tsx ../../scripts/release-package.ts"
    },
    "engines": {
        "node": ">=24"
    },
    "dependencies": {
        "@gtkx/config": "workspace:*",
        "@gtkx/ffi": "workspace:*",
        "@gtkx/utils": "workspace:*",
        "react-reconciler": "^0.33.0"
    },
    "devDependencies": {
        "@types/react-reconciler": "^0.33.0"
    },
    "peerDependencies": {
        "react": "^19"
    }
}

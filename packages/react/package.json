{
    "name": "@gtkx/react",
    "version": "1.6.0",
    "description": "React reconciler for GTK. Renders real GTK4 widget trees.",
    "keywords": [
        "gtkx",
        "gtk",
        "gtk4",
        "react",
        "typescript",
        "linux",
        "desktop",
        "gui",
        "native"
    ],
    "homepage": "https://gtkx.dev",
    "bugs": {
        "url": "https://github.com/gtkx-org/gtkx/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gtkx-org/gtkx.git",
        "directory": "packages/react"
    },
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": null,
            "default": "./dist/index.js"
        },
        "./env": {
            "types": "./env.d.ts"
        },
        "./internal": {
            "source": "./src/internal.ts",
            "types": "./dist/internal.d.ts",
            "import": "./dist/internal.js",
            "require": null,
            "default": "./dist/internal.js"
        },
        "./adw": {
            "source": "./src/adw/index.ts",
            "types": "./dist/adw/index.d.ts",
            "import": "./dist/adw/index.js",
            "require": null,
            "default": "./dist/adw/index.js"
        },
        "./adw/config": {
            "source": "./src/adw/config.ts",
            "types": "./dist/adw/config.d.ts",
            "import": "./dist/adw/config.js",
            "require": null,
            "default": "./dist/adw/config.js"
        },
        "./config": {
            "source": "./src/config.ts",
            "types": "./dist/config.d.ts",
            "import": "./dist/config.js",
            "require": null,
            "default": "./dist/config.js"
        }
    },
    "sideEffects": [
        "./src/index.ts",
        "./dist/index.js",
        "./src/internal.ts",
        "./dist/internal.js",
        "./src/bootstrap.ts",
        "./dist/bootstrap.js",
        "./src/element-behaviors.ts",
        "./dist/element-behaviors.js",
        "./src/adw/index.ts",
        "./dist/adw/index.js",
        "./src/adw/element-behaviors.ts",
        "./dist/adw/element-behaviors.js"
    ],
    "files": [
        "dist",
        "src",
        "!**/*.tsbuildinfo",
        "env.d.ts"
    ],
    "scripts": {
        "release": "tsx ../../scripts/release-package.ts"
    },
    "nx": {
        "targets": {
            "lint": {
                "options": {
                    "cwd": ".",
                    "command": "eslint {projectRoot}"
                }
            }
        }
    },
    "engines": {
        "node": ">=26.7.0"
    },
    "dependencies": {
        "@gtkx/config": "workspace:*",
        "@gtkx/css": "workspace:*",
        "@gtkx/runtime": "workspace:*",
        "@gtkx/utils": "workspace:*",
        "react-merge-refs": "^3.0.2",
        "react-reconciler": "^0.33.0"
    },
    "devDependencies": {
        "@types/react": "catalog:",
        "@types/react-reconciler": "^0.33.0"
    },
    "peerDependencies": {
        "@types/react": "^19.2",
        "react": "^19.2"
    }
}

{
    "name": "@gtkx/animated",
    "version": "2.0.0-beta.11",
    "description": "Spring animations for GTKX widgets.",
    "keywords": [
        "gtkx",
        "gtk",
        "gtk4",
        "adwaita",
        "gnome",
        "react",
        "react-spring",
        "animation",
        "spring",
        "linux",
        "desktop"
    ],
    "homepage": "https://gtkx.dev",
    "bugs": {
        "url": "https://github.com/gtkx-org/gtkx/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gtkx-org/gtkx.git",
        "directory": "packages/animated"
    },
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": null,
            "default": "./dist/index.js"
        }
    },
    "sideEffects": [
        "./src/index.ts",
        "./dist/index.js",
        "./src/bootstrap.ts",
        "./dist/bootstrap.js"
    ],
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "release": "node ../../scripts/release/publish-package.ts"
    },
    "engines": {
        "node": ">=26.7.0"
    },
    "dependencies": {
        "@gtkx/react": "workspace:*",
        "@gtkx/runtime": "workspace:*",
        "@react-spring/core": "^10.1.2",
        "@react-spring/shared": "^10.1.2",
        "@react-spring/types": "^10.1.2"
    },
    "peerDependencies": {
        "@types/react": "^19.3",
        "react": "^19.3"
    },
    "devDependencies": {
        "@gtkx/config": "workspace:*",
        "@gtkx/testing": "workspace:*",
        "@gtkx/vitest": "workspace:*",
        "@types/react": "catalog:",
        "vitest": "catalog:"
    }
}

      </property>
      <property name="revision" writable="1" transfer-ownership="none"><type name="guint64" c:type="guint64"/></property>
      <property name="payload" writable="1" transfer-ownership="none"><type name="GLib.ByteArray" c:type="GByteArray*"/></property>
      <constructor name="new_with_data" c:identifier="callable_pointers_probe_new_with_data">
        <return-value transfer-ownership="full"><type name="Probe" c:type="CallablePointersProbe*"/></return-value>
        <parameters>
          <parameter name="data" nullable="1" transfer-ownership="none"><type name="PointerAlias" c:type="CallablePointersPointerAlias"/></parameter>
        </parameters>
      </constructor>
      <method name="take_direct" c:identifier="callable_pointers_probe_take_direct">
        <return-value transfer-ownership="none"><type name="none" c:type="void"/></return-value>
        <parameters>
          <instance-parameter name="self" transfer-ownership="none"><type name="Probe" c:type="CallablePointersProbe*"/></instance-parameter>
          <parameter name="data" nullable="1" transfer-ownership="none"><type name="gpointer" c:type="gpointer"/></parameter>
        </parameters>
      </method>
      <method name="take_alias" c:identifier="callable_pointers_probe_take_alias">
        <return-value transfer-ownership="none"><type name="none" c:type="void"/></return-value>
        <parameters>
          <instance-parameter name="self" transfer-ownership="none"><type name="Probe" c:type="CallablePointersProbe*"/></instance-parameter>
          <parameter name="data" nullable="1" transfer-ownership="none"><type name="PointerAlias" c:type="CallablePointersPointerAlias"/></parameter>
        </parameters>
      </method>
      <method name="read_direct" c:identifier="callable_pointers_probe_read_direct">
        <return-value transfer-ownership="none"><type name="none" c:type="void"/></return-value>
        <parameters>
          <instance-parameter name="self" transfer-ownership="none"><type name="Probe" c:type="CallablePointersProbe*"/></instance-parameter>
          <parameter name="data" direction="out" caller-allocates="0" nullable="1" transfer-ownership="none"><type name="gpointer" c:type="gpointer*"/></parameter>
        </parameters>
      </method>
      <method name="read_alias" c:identifier="callable_pointers_probe_read_alias">
        <return-value transfer-ownership="none"><type name="none" c:type="void"/></return-value>
        <parameters>
          <instance-parameter name="self" transfer-ownership="none"><type name="Probe" c:type="CallablePointersProbe*"/></instance-parameter>
          <parameter name="data" direction="out" caller-allocates="0" nullable="1" transfer-ownership="none"><type name="PointerAlias" c:type="CallablePointersPointerAlias*"/></parameter>
        </parameters>
      </method>
      <method name="return_direct" c:identifier="callable_pointers_probe_return_direct">
        <return-value nullable="1" transfer-ownership="none"><type name="gpointer" c:type="gpointer"/></return-value>
        <parameters><instance-parameter name="self" transfer-ownership="none"><type name="Probe" c:type="CallablePointersProbe*"/></instance-parameter></parameters>
      </method>
      <method name="return_alias" c:identifier="callable_pointers_probe_return_alias">
        <return-value nullable="1" transfer-ownership="none"><type name="PointerAlias" c:type="CallablePointersPointerAlias"/></return-value>
        <parameters><instance-parameter name="self" transfer-ownership="none"><type name="Probe" c:type="CallablePointersProbe*"/></instance-parameter></parameters>
      </method>
      <method name="discard_pointer" c:identifier="callable_pointers_probe_discard_pointer">
        <return-value nullable="1" skip="1" transfer-ownership="none"><type name="gpointer" c:type="gpointer"/></return-value>
        <parameters><instance-parameter name="self" transfer-ownership="none"><type name="Probe" c:type="CallablePointersProbe*"/></instance-parameter></parameters>
      </method>
      <method name="take_array" c:identifier="callable_pointers_probe_take_array">
        <return-value transfer-ownership="none"><type name="none" c:type="void"/></return-value>
        <parameters>
          <instance-parameter name="self" transfer-ownership="none"><type name="Probe" c:type="CallablePointersProbe*"/></instance-parameter>
          <parameter name="items" transfer-ownership="none">
            <array length="1" zero-terminated="0" c:type="gpointer*"><type name="gpointer" c:type="gpointer"/></array>
          </parameter>
          <parameter name="length" transfer-ownership="none"><type name="gsize" c:type="gsize"/></parameter>
        </parameters>
      </method>
      <method name="take_list" c:identifier="callable_pointers_probe_take_list">
        <return-value transfer-ownership="none"><type name="none" c:type="void"/></return-value>
        <parameters>
          <instance-parameter name="self" transfer-ownership="none"><type name="Probe" c:type="CallablePointersProbe*"/></instance-parameter>
          <parameter name="items" transfer-ownership="none">
            <type name="GLib.List" c:type="GList*"><type name="PointerAlias" c:type="CallablePointersPointerAlias"/></type>
          </parameter>
        </parameters>
      </method>
      <method name="take_hash_values" c:identifier="callable_pointers_probe_take_hash_values">

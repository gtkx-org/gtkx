    </alias>
    <class name="Probe" parent="GObject.Object" c:type="CallablePointersProbe"
        glib:type-name="CallablePointersProbe" glib:get-type="callable_pointers_probe_get_type">
      <property name="raw-list" writable="1" transfer-ownership="none">

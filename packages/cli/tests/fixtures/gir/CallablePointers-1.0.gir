<?xml version="1.0"?>
<repository version="1.2"
    xmlns="http://www.gtk.org/introspection/core/1.0"
    xmlns:c="http://www.gtk.org/introspection/c/1.0"
    xmlns:glib="http://www.gtk.org/introspection/glib/1.0">
  <include name="GObject" version="2.0"/>
  <namespace name="CallablePointers" version="1.0" shared-library="libcallablepointers.so.0"
      c:identifier-prefixes="CallablePointers" c:symbol-prefixes="callable_pointers">
    <alias name="DataPointer" c:type="CallablePointersDataPointer">
      <type name="gpointer" c:type="gpointer"/>
    </alias>
    <alias name="PointerAlias" c:type="CallablePointersPointerAlias">

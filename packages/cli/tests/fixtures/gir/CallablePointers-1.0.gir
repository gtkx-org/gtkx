    <function name="accept_pointer" c:identifier="callable_pointers_accept_pointer">
      <return-value transfer-ownership="none"><type name="none" c:type="void"/></return-value>
      <parameters><parameter name="data" nullable="1" transfer-ownership="none"><type name="gpointer" c:type="gpointer"/></parameter></parameters>
    </function>
    <function name="get_pointer" c:identifier="callable_pointers_get_pointer">
      <return-value nullable="1" transfer-ownership="none"><type name="PointerAlias" c:type="CallablePointersPointerAlias"/></return-value>
    </function>
    <function name="safe_count" c:identifier="callable_pointers_safe_count">
      <return-value transfer-ownership="none"><type name="guint64" c:type="guint64"/></return-value>
    </function>
  </namespace>

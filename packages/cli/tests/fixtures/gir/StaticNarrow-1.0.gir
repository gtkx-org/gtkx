<?xml version="1.0"?>
<repository version="1.2"
            xmlns="http://www.gtk.org/introspection/core/1.0"
            xmlns:c="http://www.gtk.org/introspection/c/1.0"
            xmlns:glib="http://www.gtk.org/introspection/glib/1.0">
  <package name="staticnarrow-1.0"/>
  <namespace name="StaticNarrow"
             version="1.0"
             shared-library="libstaticnarrow.so.0"
             c:identifier-prefixes="StaticNarrow"
             c:symbol-prefixes="static_narrow">
    <class name="Base"
           c:symbol-prefix="base"
           c:type="StaticNarrowBase"
           glib:type-name="StaticNarrowBase"
           glib:get-type="static_narrow_base_get_type">
      <constructor name="new" c:identifier="static_narrow_base_new">
        <return-value transfer-ownership="full">
          <type name="Base" c:type="StaticNarrowBase*"/>
        </return-value>
      </constructor>
      <method name="lookup" c:identifier="static_narrow_base_lookup">
        <return-value transfer-ownership="none">
          <type name="utf8" c:type="const gchar*"/>
        </return-value>
        <parameters>
          <instance-parameter name="self" transfer-ownership="none">
            <type name="Base" c:type="StaticNarrowBase*"/>
          </instance-parameter>
          <parameter name="value" transfer-ownership="none">
            <type name="utf8" c:type="const gchar*"/>
          </parameter>
        </parameters>
      </method>
    </class>
    <class name="Derived"
           c:symbol-prefix="derived"
           c:type="StaticNarrowDerived"
           parent="Base"
           glib:type-name="StaticNarrowDerived"
           glib:get-type="static_narrow_derived_get_type">
      <constructor name="new" c:identifier="static_narrow_derived_new">
        <return-value transfer-ownership="full">
          <type name="Derived" c:type="StaticNarrowDerived*"/>
        </return-value>
      </constructor>
      <method name="lookup" c:identifier="static_narrow_derived_lookup">
        <return-value transfer-ownership="none">
          <type name="gint" c:type="gint"/>
        </return-value>
        <parameters>
          <instance-parameter name="self" transfer-ownership="none">
            <type name="Derived" c:type="StaticNarrowDerived*"/>
          </instance-parameter>
          <parameter name="value" transfer-ownership="none">
            <type name="gint" c:type="gint"/>
          </parameter>
        </parameters>
      </method>
    </class>
  </namespace>
</repository>

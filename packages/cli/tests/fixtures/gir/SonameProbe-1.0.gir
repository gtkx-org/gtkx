<?xml version="1.0"?>
<repository version="1.2"
            xmlns="http://www.gtk.org/introspection/core/1.0"
            xmlns:c="http://www.gtk.org/introspection/c/1.0"
            xmlns:glib="http://www.gtk.org/introspection/glib/1.0">
  <include name="GObject" version="2.0"/>
  <package name="sonameprobe-1.0"/>
  <namespace name="SonameProbe"
             version="1.0"
             shared-library="libsonameprobe-1.0.so.7,libsonameprobe-aux-1.0.so.2"
             c:identifier-prefixes="SonameProbe"
             c:symbol-prefixes="soname_probe">
    <class name="Widget"
           c:symbol-prefix="widget"
           c:type="SonameProbeWidget"
           parent="GObject.Object"
           glib:type-name="SonameProbeWidget"
           glib:get-type="soname_probe_widget_get_type">
      <method name="ping" c:identifier="soname_probe_widget_ping">
        <return-value transfer-ownership="none">
          <type name="gint" c:type="gint"/>
        </return-value>
      </method>
    </class>
  </namespace>
</repository>

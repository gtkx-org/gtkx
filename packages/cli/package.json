{
    "name": "@gtkx/cli",
    "version": "0.21.0",
    "description": "CLI for GTKX - create and develop GTK4 React applications",
    "keywords": [
        "gtkx",
        "gtk",
        "gtk4",
        "react",
        "typescript",
        "native",
        "linux",
        "desktop",
        "cli",
        "scaffold",
        "hmr",
        "vite"
    ],
    "homepage": "https://gtkx.dev",
    "bugs": {
        "url": "https://github.com/gtkx-org/gtkx/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/gtkx-org/gtkx.git",
        "directory": "packages/cli"
    },
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        "./refresh-runtime": {
            "source": "./src/refresh-runtime.ts",
            "types": "./dist/refresh-runtime.d.ts",
            "default": "./dist/refresh-runtime.js"
        },
        "./vitest-plugin": {
            "source": "./src/vitest-plugin.ts",
            "types": "./dist/vitest-plugin.d.ts",
            "default": "./dist/vitest-plugin.js"
        },
        "./env": "./env.d.ts"
    },
    "bin": {
        "gtkx": "bin/gtkx.js"
    },
    "sideEffects": false,
    "files": [
        "bin",
        "dist",
        "env.d.ts",
        "src"
    ],
    "scripts": {
        "build": "tsc -b tsconfig.lib.json",
        "typecheck": "tsc -b --emitDeclarationOnly",
        "release": "tsx ../../scripts/release-package.ts"
    },
    "engines": {
        "node": ">=24"
    },
    "dependencies": {
        "@babel/core": "^8.0.1",
        "@babel/preset-typescript": "^8.0.1",
        "@gtkx/codegen": "workspace:*",
        "@gtkx/config": "workspace:*",
        "@gtkx/ffi": "workspace:*",
        "@gtkx/mcp": "workspace:*",
        "@gtkx/utils": "workspace:*",
        "@gtkx/vitest": "workspace:*",
        "@swc/core": "^1.15.43",
        "babel-plugin-react-compiler": "^1.0.0",
        "citty": "^0.2.2",
        "create-gtkx": "workspace:*",
        "fast-xml-parser": "^5.9.3",
        "react-refresh": "^0.18.0",
        "vite": "catalog:"
    },
    "devDependencies": {
        "@gtkx/testing": "workspace:*",
        "@types/babel__core": "^7.20.5",
        "@types/react-refresh": "^0.14.7"
    },
    "peerDependencies": {
        "react": "^19"
    }
}

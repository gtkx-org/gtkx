{
    "name": "@gtkx/cli",
    "version": "0.21.0",
    "description": "CLI for GTKX - create and develop GTK4 React applications",
    "keywords": [
        "gtkx",
        "gtk",
        "gtk4",
        "react",
        "typescript",
        "native",
        "linux",
        "desktop",
        "cli",
        "scaffold",
        "hmr",
        "vite"
    ],
    "homepage": "https://gtkx.dev",
    "bugs": {
        "url": "https://github.com/gtkx-org/gtkx/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/gtkx-org/gtkx.git",
        "directory": "packages/cli"
    },
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./builder": {
            "types": "./dist/builder.d.ts",
            "default": "./dist/builder.js"
        },
        "./refresh-runtime": {
            "types": "./dist/refresh-runtime.d.ts",
            "default": "./dist/refresh-runtime.js"
        },
        "./env": "./env.d.ts"
    },
    "bin": {
        "gtkx": "bin/gtkx.js"
    },
    "sideEffects": false,
    "files": [
        "bin",
        "dist",
        "env.d.ts",
        "src",
        "templates"
    ],
    "scripts": {
        "build": "tsc -b",
        "test": "vitest run",
        "coverage": "vitest run --coverage",
        "typecheck": "tsc -b --emitDeclarationOnly"
    },
    "dependencies": {
        "@clack/prompts": "^1.4.0",
        "@gtkx/codegen": "workspace:*",
        "@gtkx/ffi": "workspace:*",
        "@gtkx/mcp": "workspace:*",
        "@swc/core": "^1.15.33",
        "c12": "^3.3.0",
        "citty": "^0.2.2",
        "ejs": "^5.0.2",
        "jiti": "^2.7.0",
        "nypm": "^0.6.6",
        "react-refresh": "^0.18.0",
        "tinyexec": "^1.2.2",
        "typescript": "^6.0.3",
        "vite": "^8.0.14"
    },
    "devDependencies": {
        "@gtkx/testing": "workspace:*",
        "@types/ejs": "^3.1.5",
        "@types/react-refresh": "^0.14.7",
        "memfs": "^4.57.2"
    },
    "peerDependencies": {
        "@gtkx/react": "workspace:*",
        "@gtkx/testing": "workspace:*",
        "react": "^19"
    },
    "peerDependenciesMeta": {
        "@gtkx/react": {
            "optional": true
        },
        "@gtkx/testing": {
            "optional": true
        }
    }
}

{
    "name": "@gtkx/cli",
    "version": "2.0.0-beta.10",
    "description": "Adwaita-first GNOME app toolchain for React and TypeScript.",
    "keywords": [
        "gtkx",
        "gtk",
        "gtk4",
        "adwaita",
        "gnome",
        "react",
        "typescript",
        "native",
        "linux",
        "desktop",
        "cli",
        "scaffold",
        "hmr",
        "vite"
    ],
    "homepage": "https://gtkx.dev",
    "bugs": {
        "url": "https://github.com/gtkx-org/gtkx/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gtkx-org/gtkx.git",
        "directory": "packages/cli"
    },
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "exports": {
        "./env": "./env.d.ts",
        "./package.json": "./package.json",
        "./refresh-runtime": {
            "source": "./src/refresh-runtime.ts",
            "types": "./dist/refresh-runtime.d.ts",
            "import": "./dist/refresh-runtime.js",
            "require": null,
            "default": "./dist/refresh-runtime.js"
        },
        "./vitest-plugin": {
            "source": "./src/vitest-plugin.ts",
            "types": "./dist/vitest-plugin.d.ts",
            "import": "./dist/vitest-plugin.js",
            "require": null,
            "default": "./dist/vitest-plugin.js"
        }
    },
    "bin": {
        "gtkx": "bin/gtkx.js"
    },
    "sideEffects": false,
    "files": [
        "bin",
        "dist",
        "env.d.ts",
        "src"
    ],
    "scripts": {
        "release": "tsx ../../scripts/release-package.ts"
    },
    "nx": {
        "targets": {
            "lint": {
                "options": {
                    "cwd": ".",
                    "command": "eslint {projectRoot}"
                }
            }
        }
    },
    "engines": {
        "node": ">=26.7.0"
    },
    "dependencies": {
        "@babel/core": "^8.0.6",
        "@babel/preset-typescript": "^8.0.1",
        "@gtkx/codegen": "workspace:*",
        "@gtkx/config": "workspace:*",
        "@gtkx/mcp": "workspace:*",
        "@gtkx/native": "workspace:*",
        "@gtkx/runtime": "workspace:*",
        "@gtkx/utils": "workspace:*",
        "@gtkx/vitest": "workspace:*",
        "@swc/core": "^1.16.2",
        "babel-plugin-react-compiler": "^1.0.0",
        "citty": "^0.2.2",
        "confbox": "^0.3.1",
        "create-gtkx": "workspace:*",
        "fast-xml-builder": "^1.3.1",
        "gettext-parser": "^9.1.1",
        "hosted-git-info": "^10.1.1",
        "i18next-cli": "1.74.1",
        "jiti": "^2.7.0",
        "react-refresh": "^0.19.0",
        "semver": "^7.8.4",
        "spdx-expression-parse": "^5.0.0",
        "vite": "catalog:",
        "yaml": "catalog:"
    },
    "devDependencies": {
        "@gtkx/testing": "workspace:*",
        "@modelcontextprotocol/sdk": "^1.30.0",
        "@types/babel__core": "^7.20.5",
        "@types/gettext-parser": "^9.0.0",
        "@types/hosted-git-info": "^3.0.5",
        "@types/react-refresh": "^0.14.7",
        "@types/semver": "^7.8.0",
        "@types/spdx-expression-parse": "^4.0.0",
        "vitest": "catalog:"
    },
    "peerDependencies": {
        "react": "^19.3"
    }
}

{
    "name": "@gtkx/cli",
    "version": "1.4.0",
    "description": "GTK app toolchain for React: scaffold, dev server, build, docs.",
    "keywords": [
        "gtkx",
        "gtk",
        "gtk4",
        "react",
        "typescript",
        "native",
        "linux",
        "desktop",
        "cli",
        "scaffold",
        "hmr",
        "vite"
    ],
    "homepage": "https://gtkx.dev",
    "bugs": {
        "url": "https://github.com/gtkx-org/gtkx/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gtkx-org/gtkx.git",
        "directory": "packages/cli"
    },
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "exports": {
        "./env": "./env.d.ts",
        "./package.json": "./package.json",
        "./refresh-runtime": {
            "source": "./src/refresh-runtime.ts",
            "types": "./dist/refresh-runtime.d.ts",
            "default": "./dist/refresh-runtime.js"
        },
        "./vitest-plugin": {
            "source": "./src/vitest-plugin.ts",
            "types": "./dist/vitest-plugin.d.ts",
            "default": "./dist/vitest-plugin.js"
        }
    },
    "bin": {
        "gtkx": "bin/gtkx.js"
    },
    "sideEffects": false,
    "files": [
        "bin",
        "dist",
        "env.d.ts",
        "src"
    ],
    "scripts": {
        "release": "tsx ../../scripts/release-package.ts"
    },
    "nx": {
        "targets": {
            "lint": {
                "options": {
                    "cwd": ".",
                    "command": "eslint {projectRoot}"
                }
            }
        }
    },
    "engines": {
        "node": ">=24"
    },
    "dependencies": {
        "@babel/core": "^8.0.1",
        "@babel/preset-typescript": "^8.0.1",
        "@gtkx/codegen": "workspace:*",
        "@gtkx/config": "workspace:*",
        "@gtkx/mcp": "workspace:*",
        "@gtkx/runtime": "workspace:*",
        "@gtkx/utils": "workspace:*",
        "@gtkx/vitest": "workspace:*",
        "@swc/core": "^1.16.1",
        "babel-plugin-react-compiler": "^1.0.0",
        "citty": "^0.2.2",
        "create-gtkx": "workspace:*",
        "fast-xml-parser": "^5.11.0",
        "i18next-cli": "1.71.3",
        "react-refresh": "^0.18.0",
        "vite": "catalog:",
        "yaml": "catalog:"
    },
    "devDependencies": {
        "@gtkx/testing": "workspace:*",
        "@types/babel__core": "^7.20.5",
        "@types/react-refresh": "^0.14.7",
        "vitest": "catalog:"
    },
    "peerDependencies": {
        "react": "^19"
    }
}

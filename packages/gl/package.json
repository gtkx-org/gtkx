{
    "name": "@gtkx/gl",
    "version": "0.21.0",
    "description": "Generated OpenGL 4.6 core bindings plus override helpers for GTKX GLArea rendering",
    "keywords": [
        "gtkx",
        "gtk",
        "gtk4",
        "opengl",
        "gl",
        "glarea",
        "linux",
        "desktop"
    ],
    "homepage": "https://gtkx.dev",
    "bugs": {
        "url": "https://github.com/gtkx-org/gtkx/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/gtkx-org/gtkx.git",
        "directory": "packages/gl"
    },
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "sideEffects": false,
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "tsc -b tsconfig.lib.json",
        "typecheck": "tsc -b --emitDeclarationOnly",
        "codegen": "NODE_OPTIONS=--conditions=source tsx ./scripts/codegen.ts",
        "release": "tsx ../../scripts/release-package.ts"
    },
    "engines": {
        "node": ">=24"
    },
    "dependencies": {
        "@gtkx/ffi": "workspace:*",
        "@gtkx/native": "workspace:*"
    },
    "devDependencies": {
        "@gtkx/codegen": "workspace:*",
        "@gtkx/utils": "workspace:*",
        "@types/node": "catalog:"
    }
}

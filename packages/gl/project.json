{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "name": "@gtkx/gl",
    "targets": {
        "codegen": {
            "cache": true,
            "dependsOn": [
                "gtkx:_build:bindings"
            ],
            "inputs": [
                "{projectRoot}/scripts/**/*",
                "{projectRoot}/src/overrides.ts",
                "^production",
                "{workspaceRoot}/packages/codegen/src/khronos/**/*"
            ],
            "outputs": [
                "{projectRoot}/src/generated/**"
            ]
        },
        "build": {
            "dependsOn": [
                "...",
                "codegen"
            ],
            "inputs": [
                "...",
                {
                    "dependentTasksOutputFiles": "**/*.ts"
                }
            ]
        }
    }
}

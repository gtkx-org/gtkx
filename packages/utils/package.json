{
    "name": "@gtkx/utils",
    "version": "1.3.0",
    "description": "Cross-package utilities shared by the GTKX packages and toolchain: logging, error formatting, string and class helpers",
    "keywords": [
        "gtkx",
        "gtk",
        "gtk4",
        "utils",
        "linux",
        "desktop"
    ],
    "homepage": "https://gtkx.dev",
    "bugs": {
        "url": "https://github.com/gtkx-org/gtkx/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gtkx-org/gtkx.git",
        "directory": "packages/utils"
    },
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "sideEffects": false,
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "release": "tsx ../../scripts/release-package.ts"
    },
    "nx": {
        "targets": {
            "lint": {
                "options": {
                    "cwd": ".",
                    "command": "eslint {projectRoot}"
                }
            }
        }
    },
    "dependencies": {
        "picocolors": "^1.1.1"
    },
    "engines": {
        "node": ">=24"
    }
}

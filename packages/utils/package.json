{
    "name": "@gtkx/utils",
    "version": "2.0.0-beta.4",
    "description": "Shared utilities for the GTK toolchain: logging, errors, strings.",
    "keywords": [
        "gtkx",
        "gtk",
        "gtk4",
        "utils",
        "linux",
        "desktop"
    ],
    "homepage": "https://gtkx.dev",
    "bugs": {
        "url": "https://github.com/gtkx-org/gtkx/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gtkx-org/gtkx.git",
        "directory": "packages/utils"
    },
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": null,
            "default": "./dist/index.js"
        }
    },
    "sideEffects": false,
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "release": "tsx ../../scripts/release-package.ts"
    },
    "nx": {
        "targets": {
            "lint": {
                "options": {
                    "cwd": ".",
                    "command": "eslint {projectRoot}"
                }
            }
        }
    },
    "dependencies": {
        "picocolors": "^1.1.1",
        "which": "^7.0.0"
    },
    "devDependencies": {
        "@types/which": "^3.0.4"
    },
    "engines": {
        "node": ">=26.7.0"
    }
}

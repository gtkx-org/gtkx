{
    "name": "@gtkx/utils",
    "version": "0.21.0",
    "description": "Cross-package utilities shared by GTKX runtime entry points",
    "homepage": "https://gtkx.dev",
    "bugs": {
        "url": "https://github.com/gtkx-org/gtkx/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/gtkx-org/gtkx.git",
        "directory": "packages/utils"
    },
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "sideEffects": false,
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "tsc -b tsconfig.lib.json",
        "typecheck": "tsc -b --emitDeclarationOnly",
        "release": "cp ../../README.md README.md && pnpm publish --access public --no-git-checks"
    },
    "dependencies": {
        "picocolors": "^1.1.1"
    },
    "engines": {
        "node": ">=24"
    }
}

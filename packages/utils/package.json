{
    "name": "@gtkx/utils",
    "version": "2.0.0-beta.11",
    "description": "Shared utilities for the GTKX toolchain.",
    "keywords": [
        "gtkx",
        "gtk",
        "gtk4",
        "adwaita",
        "gnome",
        "utils",
        "linux",
        "desktop"
    ],
    "homepage": "https://gtkx.dev",
    "bugs": {
        "url": "https://github.com/gtkx-org/gtkx/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gtkx-org/gtkx.git",
        "directory": "packages/utils"
    },
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": null,
            "default": "./dist/index.js"
        }
    },
    "sideEffects": false,
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "release": "node ../../scripts/release/publish-package.ts"
    },
    "dependencies": {
        "@babel/helper-validator-identifier": "^8.0.6",
        "es-toolkit": "^1.51.0",
        "picocolors": "^1.1.1",
        "type-fest": "^5.10.0",
        "which": "^7.0.0"
    },
    "devDependencies": {
        "@types/which": "^3.0.4",
        "vitest": "catalog:"
    },
    "engines": {
        "node": ">=26.7.0"
    }
}

{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "name": "@gtkx/codegen",
    "targets": {
        "lint": {},
        "typecheck": {
            "dependsOn": ["...", "_typecheck:overrides", "_typecheck:bindings", "_typecheck:binding-sources"]
        },
        "_typecheck:overrides": {
            "command": "tsc -p overrides/tsconfig.json",
            "options": {
                "cwd": "packages/codegen"
            },
            "cache": true,
            "dependsOn": ["gtkx:bindings"],
            "inputs": [
                "default",
                "^production",
                {
                    "dependentTasksOutputFiles": "**/*.d.ts",
                    "transitive": true
                }
            ],
            "outputs": []
        },
        "_typecheck:bindings": {
            "executor": "nx:run-commands",
            "cache": true,
            "dependsOn": ["^build"],
            "inputs": [
                "production",
                "^production",
                {
                    "dependentTasksOutputFiles": "**/*.d.ts",
                    "transitive": true
                }
            ],
            "outputs": [],
            "options": {
                "cwd": "packages/codegen",
                "parallel": false,
                "commands": [
                    "node --import ../../scripts/register-workspace-loader.ts scripts/typecheck-bindings.ts declarations",
                    "tsc -p ../../build/bindings-typecheck/declarations/tsconfig.declarations.json"
                ]
            }
        },
        "_typecheck:binding-sources": {
            "executor": "nx:run-commands",
            "cache": true,
            "dependsOn": ["^build"],
            "inputs": [
                "production",
                "^production",
                {
                    "dependentTasksOutputFiles": "**/*.d.ts",
                    "transitive": true
                }
            ],
            "outputs": [],
            "options": {
                "cwd": "packages/codegen",
                "parallel": false,
                "commands": [
                    "node --import ../../scripts/register-workspace-loader.ts scripts/typecheck-bindings.ts sources",
                    "tsc -p ../../build/bindings-typecheck/sources/tsconfig.sources.json"
                ]
            }
        },
        "build": {
            "dependsOn": [
                "@gtkx/cairo:build",
                "@gtkx/config:build",
                "@gtkx/native:build",
                "@gtkx/runtime:build",
                "@gtkx/utils:build"
            ]
        }
    }
}

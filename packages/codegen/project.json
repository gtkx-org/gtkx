{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "name": "@gtkx/codegen",
    "targets": {
        "typecheck": {
            "dependsOn": ["...", "_typecheck:overrides"]
        },
        "_typecheck:overrides": {
            "command": "tsc -p overrides/tsconfig.json",
            "options": {
                "cwd": "packages/codegen"
            },
            "cache": true,
            "dependsOn": ["gtkx:bindings"],
            "inputs": [
                "default",
                "^production",
                {
                    "dependentTasksOutputFiles": "**/*.d.ts",
                    "transitive": true
                }
            ],
            "outputs": []
        },
        "build": {
            "dependsOn": ["@gtkx/config:build", "@gtkx/native:build", "@gtkx/runtime:build", "@gtkx/utils:build"]
        }
    }
}

<?xml version="1.0"?>
<repository version="1.2"
            xmlns="http://www.gtk.org/introspection/core/1.0"
            xmlns:c="http://www.gtk.org/introspection/c/1.0"
            xmlns:glib="http://www.gtk.org/introspection/glib/1.0">
  <namespace name="Opaque"
             version="1.0"
             shared-library="libopaque.so.1"
             c:identifier-prefixes="Opaque"
             c:symbol-prefixes="opaque">
    <record name="KeyFile"
            c:type="OpaqueKeyFile"
            opaque="1"
            glib:type-name="OpaqueKeyFile"
            glib:get-type="opaque_key_file_get_type"
            c:symbol-prefix="key_file">
      <constructor name="new" c:identifier="opaque_key_file_new">
        <return-value transfer-ownership="full">
          <type name="KeyFile" c:type="OpaqueKeyFile*"/>
        </return-value>
      </constructor>
      <method name="unref" c:identifier="opaque_key_file_unref">
        <return-value transfer-ownership="none">
          <type name="none" c:type="void"/>
        </return-value>
        <parameters>
          <instance-parameter name="key_file" transfer-ownership="none">
            <type name="KeyFile" c:type="OpaqueKeyFile*"/>
          </instance-parameter>
        </parameters>
      </method>
    </record>
    <record name="Bytes"
            c:type="OpaqueBytes"
            opaque="1"
            glib:type-name="OpaqueBytes"
            glib:get-type="opaque_bytes_get_type"
            c:symbol-prefix="bytes">
      <constructor name="new" c:identifier="opaque_bytes_new">
        <return-value transfer-ownership="full">
          <type name="Bytes" c:type="OpaqueBytes*"/>
        </return-value>
        <parameters>
          <parameter name="data" transfer-ownership="none">
            <array length="1" zero-terminated="0" c:type="gconstpointer">
              <type name="guint8" c:type="guint8"/>
            </array>
          </parameter>
          <parameter name="size" transfer-ownership="none">
            <type name="gsize" c:type="gsize"/>
          </parameter>
        </parameters>
      </constructor>
    </record>
    <record name="AsyncQueue"
            c:type="OpaqueAsyncQueue"
            opaque="1"
            glib:type-name="OpaqueAsyncQueue"
            glib:get-type="opaque_async_queue_get_type"
            c:symbol-prefix="async_queue">
      <function name="lookup" c:identifier="opaque_async_queue_lookup">
        <return-value transfer-ownership="none">
          <type name="AsyncQueue" c:type="OpaqueAsyncQueue*"/>
        </return-value>
        <parameters>
          <parameter name="name" transfer-ownership="none">
            <type name="utf8" c:type="const gchar*"/>
          </parameter>
        </parameters>
      </function>
      <function name="new" c:identifier="opaque_async_queue_new">
        <return-value transfer-ownership="full">
          <type name="AsyncQueue" c:type="OpaqueAsyncQueue*"/>
        </return-value>
      </function>
    </record>
    <record name="Language"
            c:type="OpaqueLanguage"
            disguised="1"
            glib:type-name="OpaqueLanguage"
            glib:get-type="opaque_language_get_type"
            c:symbol-prefix="language">
      <function name="from_string" c:identifier="opaque_language_from_string">
        <return-value transfer-ownership="none">
          <type name="Language" c:type="OpaqueLanguage*"/>
        </return-value>
        <parameters>
          <parameter name="language" transfer-ownership="none">
            <type name="utf8" c:type="const gchar*"/>
          </parameter>
        </parameters>
      </function>
    </record>
    <record name="MatchInfo"
            c:type="OpaqueMatchInfo"
            disguised="1"
            glib:type-name="OpaqueMatchInfo"
            glib:get-type="opaque_match_info_get_type"
            c:symbol-prefix="match_info">
      <function name="describe" c:identifier="opaque_match_info_describe">
        <return-value transfer-ownership="none">
          <type name="utf8" c:type="const gchar*"/>
        </return-value>
      </function>
      <method name="matches" c:identifier="opaque_match_info_matches">
        <return-value transfer-ownership="none">
          <type name="gboolean" c:type="gboolean"/>
        </return-value>
        <parameters>
          <instance-parameter name="match_info" transfer-ownership="none">
            <type name="MatchInfo" c:type="OpaqueMatchInfo*"/>
          </instance-parameter>
        </parameters>
      </method>
    </record>
    <record name="Query" c:type="OpaqueQuery" c:symbol-prefix="query">
      <field name="id" writable="1">
        <type name="guint" c:type="guint"/>
      </field>
      <field name="name" writable="1">
        <type name="utf8" c:type="const gchar*"/>
      </field>
    </record>
    <record name="Rect"
            c:type="OpaqueRect"
            glib:type-name="OpaqueRect"
            glib:get-type="opaque_rect_get_type"
            c:symbol-prefix="rect">
      <field name="x" writable="1">
        <type name="gint" c:type="gint"/>
      </field>
      <field name="y" writable="1">
        <type name="gint" c:type="gint"/>
      </field>
    </record>
    <function name="query" c:identifier="opaque_query">
      <return-value transfer-ownership="none">
        <type name="none" c:type="void"/>
      </return-value>
      <parameters>
        <parameter name="id" transfer-ownership="none">
          <type name="guint" c:type="guint"/>
        </parameter>
        <parameter name="query" direction="out" caller-allocates="1" transfer-ownership="none">
          <type name="Query" c:type="OpaqueQuery*"/>
        </parameter>
      </parameters>
    </function>
    <function name="bounds" c:identifier="opaque_bounds">
      <return-value transfer-ownership="none">
        <type name="none" c:type="void"/>
      </return-value>
      <parameters>
        <parameter name="rect" direction="out" caller-allocates="1" transfer-ownership="none">
          <type name="Rect" c:type="OpaqueRect*"/>
        </parameter>
      </parameters>
    </function>
    <function name="collect" c:identifier="opaque_collect">
      <return-value transfer-ownership="none">
        <type name="none" c:type="void"/>
      </return-value>
      <parameters>
        <parameter name="matches" direction="out" caller-allocates="1" transfer-ownership="none">
          <type name="MatchInfo" c:type="OpaqueMatchInfo*"/>
        </parameter>
      </parameters>
    </function>
    <function name="collect_optional" c:identifier="opaque_collect_optional">
      <return-value transfer-ownership="none">
        <type name="gboolean" c:type="gboolean"/>
      </return-value>
      <parameters>
        <parameter name="matches" direction="out" caller-allocates="1" optional="1" transfer-ownership="none">
          <type name="MatchInfo" c:type="OpaqueMatchInfo*"/>
        </parameter>
      </parameters>
    </function>
  </namespace>
</repository>

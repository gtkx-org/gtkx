<?xml version="1.0"?>
<repository version="1.2"
            xmlns="http://www.gtk.org/introspection/core/1.0"
            xmlns:c="http://www.gtk.org/introspection/c/1.0"
            xmlns:glib="http://www.gtk.org/introspection/glib/1.0">
  <include name="GObject" version="2.0"/>
  <namespace name="Accessor"
             version="1.0"
             shared-library="libaccessor.so.1"
             c:identifier-prefixes="Accessor"
             c:symbol-prefixes="accessor">
    <class name="Panel"
           c:symbol-prefix="panel"
           c:type="AccessorPanel"
           parent="GObject.Object"
           glib:type-name="AccessorPanel"
           glib:get-type="accessor_panel_get_type">
      <property name="caption"
                writable="1"
                transfer-ownership="none"
                getter="get_caption"
                setter="set_caption">
        <type name="utf8" c:type="gchar*"/>
      </property>
      <property name="title"
                writable="1"
                transfer-ownership="none"
                getter="get_title"
                setter="set_title">
        <type name="utf8" c:type="gchar*"/>
      </property>
      <property name="tags"
                writable="1"
                transfer-ownership="none"
                getter="get_tags"
                setter="set_tags">
        <array>
          <type name="utf8"/>
        </array>
      </property>
      <method name="get_caption" c:identifier="accessor_panel_get_caption">
        <return-value transfer-ownership="none" nullable="1">
          <type name="utf8" c:type="const gchar*"/>
        </return-value>
        <parameters>
          <instance-parameter name="panel" transfer-ownership="none">
            <type name="Panel" c:type="AccessorPanel*"/>
          </instance-parameter>
        </parameters>
      </method>
      <method name="set_caption" c:identifier="accessor_panel_set_caption">
        <return-value transfer-ownership="none">
          <type name="none" c:type="void"/>
        </return-value>
        <parameters>
          <instance-parameter name="panel" transfer-ownership="none">
            <type name="Panel" c:type="AccessorPanel*"/>
          </instance-parameter>
          <parameter name="caption" transfer-ownership="none">
            <type name="utf8" c:type="const gchar*"/>
          </parameter>
        </parameters>
      </method>
      <method name="get_title" c:identifier="accessor_panel_get_title">
        <return-value transfer-ownership="none">
          <type name="utf8" c:type="const gchar*"/>
        </return-value>
        <parameters>
          <instance-parameter name="panel" transfer-ownership="none">
            <type name="Panel" c:type="AccessorPanel*"/>
          </instance-parameter>
        </parameters>
      </method>
      <method name="set_title" c:identifier="accessor_panel_set_title">
        <return-value transfer-ownership="none">
          <type name="none" c:type="void"/>
        </return-value>
        <parameters>
          <instance-parameter name="panel" transfer-ownership="none">
            <type name="Panel" c:type="AccessorPanel*"/>
          </instance-parameter>
          <parameter name="title" transfer-ownership="none" nullable="1">
            <type name="utf8" c:type="const gchar*"/>
          </parameter>
        </parameters>
      </method>
      <method name="get_tags" c:identifier="accessor_panel_get_tags">
        <return-value transfer-ownership="none">
          <array c:type="GStrv">
            <type name="utf8"/>
          </array>
        </return-value>
        <parameters>
          <instance-parameter name="panel" transfer-ownership="none">
            <type name="Panel" c:type="AccessorPanel*"/>
          </instance-parameter>
        </parameters>
      </method>
      <method name="set_tags" c:identifier="accessor_panel_set_tags">
        <return-value transfer-ownership="none">
          <type name="none" c:type="void"/>
        </return-value>
        <parameters>
          <instance-parameter name="panel" transfer-ownership="none">
            <type name="Panel" c:type="AccessorPanel*"/>
          </instance-parameter>
          <parameter name="tags" transfer-ownership="none">
            <type name="utf8" c:type="const gchar* const*"/>
          </parameter>
        </parameters>
      </method>
    </class>
    <class name="Frame"
           c:symbol-prefix="frame"
           c:type="AccessorFrame"
           parent="GObject.Object"
           glib:type-name="AccessorFrame"
           glib:get-type="accessor_frame_get_type">
      <property name="badge"
                writable="1"
                transfer-ownership="none"
                getter="fetch_badge"
                setter="apply_badge">
        <type name="utf8" c:type="gchar*"/>
      </property>
      <method name="fetch_badge" c:identifier="accessor_frame_fetch_badge">
        <return-value transfer-ownership="none">
          <type name="utf8" c:type="const gchar*"/>
        </return-value>
        <parameters>
          <instance-parameter name="frame" transfer-ownership="none">
            <type name="Frame" c:type="AccessorFrame*"/>
          </instance-parameter>
        </parameters>
      </method>
      <method name="apply_badge" c:identifier="accessor_frame_apply_badge">
        <return-value transfer-ownership="none">
          <type name="none" c:type="void"/>
        </return-value>
        <parameters>
          <instance-parameter name="frame" transfer-ownership="none">
            <type name="Frame" c:type="AccessorFrame*"/>
          </instance-parameter>
          <parameter name="badge" transfer-ownership="none">
            <type name="utf8" c:type="const gchar*"/>
          </parameter>
        </parameters>
      </method>
      <property name="motto"
                writable="1"
                transfer-ownership="none"
                getter="fetch_motto"
                setter="apply_motto">
        <type name="utf8" c:type="gchar*"/>
      </property>
      <method name="fetch_motto" c:identifier="accessor_frame_fetch_motto">
        <return-value transfer-ownership="none">
          <type name="utf8" c:type="const gchar*"/>
        </return-value>
        <parameters>
          <instance-parameter name="frame" transfer-ownership="none">
            <type name="Frame" c:type="AccessorFrame*"/>
          </instance-parameter>
        </parameters>
      </method>
      <method name="apply_motto" c:identifier="accessor_frame_apply_motto">
        <return-value transfer-ownership="none">
          <type name="none" c:type="void"/>
        </return-value>
        <parameters>
          <instance-parameter name="frame" transfer-ownership="none">
            <type name="Frame" c:type="AccessorFrame*"/>
          </instance-parameter>
          <parameter name="motto" transfer-ownership="none" nullable="1">
            <type name="utf8" c:type="const gchar*"/>
          </parameter>
        </parameters>
      </method>
    </class>
    <class name="Dock"
           c:symbol-prefix="dock"
           c:type="AccessorDock"
           parent="Frame"
           glib:type-name="AccessorDock"
           glib:get-type="accessor_dock_get_type">
      <property name="badge"
                writable="1"
                transfer-ownership="none"
                getter="get_badge"
                setter="set_badge">
        <type name="utf8" c:type="gchar*"/>
      </property>
      <method name="get_badge" c:identifier="accessor_dock_get_badge">
        <return-value transfer-ownership="none" nullable="1">
          <type name="utf8" c:type="const gchar*"/>
        </return-value>
        <parameters>
          <instance-parameter name="dock" transfer-ownership="none">
            <type name="Dock" c:type="AccessorDock*"/>
          </instance-parameter>
        </parameters>
      </method>
      <method name="set_badge" c:identifier="accessor_dock_set_badge">
        <return-value transfer-ownership="none">
          <type name="none" c:type="void"/>
        </return-value>
        <parameters>
          <instance-parameter name="dock" transfer-ownership="none">
            <type name="Dock" c:type="AccessorDock*"/>
          </instance-parameter>
          <parameter name="badge" transfer-ownership="none">
            <type name="utf8" c:type="const gchar*"/>
          </parameter>
        </parameters>
      </method>
      <property name="motto"
                writable="1"
                transfer-ownership="none"
                getter="get_motto"
                setter="set_motto">
        <type name="utf8" c:type="gchar*"/>
      </property>
      <method name="get_motto" c:identifier="accessor_dock_get_motto">
        <return-value transfer-ownership="none">
          <type name="utf8" c:type="const gchar*"/>
        </return-value>
        <parameters>
          <instance-parameter name="dock" transfer-ownership="none">
            <type name="Dock" c:type="AccessorDock*"/>
          </instance-parameter>
        </parameters>
      </method>
      <method name="set_motto" c:identifier="accessor_dock_set_motto">
        <return-value transfer-ownership="none">
          <type name="none" c:type="void"/>
        </return-value>
        <parameters>
          <instance-parameter name="dock" transfer-ownership="none">
            <type name="Dock" c:type="AccessorDock*"/>
          </instance-parameter>
          <parameter name="motto" transfer-ownership="none">
            <type name="utf8" c:type="const gchar*"/>
          </parameter>
        </parameters>
      </method>
    </class>
  </namespace>
</repository>

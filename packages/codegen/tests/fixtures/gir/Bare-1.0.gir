<?xml version="1.0"?>
<repository version="1.2"
            xmlns="http://www.gtk.org/introspection/core/1.0"
            xmlns:c="http://www.gtk.org/introspection/c/1.0"
            xmlns:glib="http://www.gtk.org/introspection/glib/1.0">
  <namespace name="Bare"
             version="1.0"
             c:identifier-prefixes="Bare"
             c:symbol-prefixes="bare">
    <function name="init" c:identifier="BareInit">
      <return-value transfer-ownership="none">
        <type name="none" c:type="void"/>
      </return-value>
    </function>
    <function name="finalize" c:identifier="BareFinalize">
      <return-value transfer-ownership="none">
        <type name="none" c:type="void"/>
      </return-value>
    </function>
    <record name="Handle" c:type="BareHandle" glib:get-type="bare_handle_get_type">
      <method name="release" c:identifier="bare_handle_release">
        <return-value transfer-ownership="none">
          <type name="none" c:type="void"/>
        </return-value>
        <parameters>
          <instance-parameter name="handle" transfer-ownership="none">
            <type name="Handle" c:type="BareHandle*"/>
          </instance-parameter>
        </parameters>
      </method>
    </record>
  </namespace>
</repository>

{
    "compilerOptions": {
        "module": "esnext",
        "moduleResolution": "bundler",
        "target": "esnext",
        "strict": true,
        "isolatedDeclarations": true,
        "declaration": true,
        "noEmit": true,
        "skipLibCheck": true,
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "types": [],
        "paths": {
            "@gtkx/ffi": ["../../ffi/dist/index.d.ts"],
            "@gtkx/gi/*": ["../../../node_modules/.gtkx/gi/*"]
        }
    },
    "include": ["**/*.ts"],
    "exclude": ["**/index.ts"]
}

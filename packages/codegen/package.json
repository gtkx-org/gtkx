{
    "name": "@gtkx/codegen",
    "version": "0.21.0",
    "description": "GIR-driven TypeScript code generator for GTKX FFI and React bindings",
    "keywords": [
        "gtkx",
        "gtk",
        "gtk4",
        "gir",
        "codegen",
        "typescript",
        "ffi"
    ],
    "homepage": "https://gtkx.dev",
    "bugs": {
        "url": "https://github.com/gtkx-org/gtkx/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/gtkx-org/gtkx.git",
        "directory": "packages/codegen"
    },
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "sideEffects": false,
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "tsc -b",
        "test": "vitest run",
        "typecheck": "tsc -b --emitDeclarationOnly"
    },
    "dependencies": {
        "@gtkx/config": "workspace:*",
        "@gtkx/utils": "workspace:*",
        "fast-xml-parser": "^5.8.0",
        "typescript": "^6.0.3"
    },
    "devDependencies": {
        "@types/node": "^25.9.3"
    },
    "engines": {
        "node": ">=24"
    }
}

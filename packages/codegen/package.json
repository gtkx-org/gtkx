{
    "name": "@gtkx/codegen",
    "version": "2.0.0-beta.11",
    "description": "Generate TypeScript bindings and JSX elements from GIR libraries.",
    "keywords": [
        "gtkx",
        "gtk",
        "gtk4",
        "adwaita",
        "gnome",
        "gir",
        "codegen",
        "typescript",
        "ffi"
    ],
    "homepage": "https://gtkx.dev",
    "bugs": {
        "url": "https://github.com/gtkx-org/gtkx/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gtkx-org/gtkx.git",
        "directory": "packages/codegen"
    },
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": null,
            "default": "./dist/index.js"
        },
        "./internal": {
            "types": "./dist/internal.d.ts",
            "import": "./dist/internal.js",
            "require": null,
            "default": "./dist/internal.js"
        }
    },
    "sideEffects": false,
    "files": [
        "dist",
        "overrides",
        "!overrides/tsconfig.json",
        "src"
    ],
    "scripts": {
        "release": "tsx ../../scripts/release-package.ts"
    },
    "engines": {
        "node": ">=26.7.0"
    },
    "dependencies": {
        "@gtkx/cairo": "workspace:*",
        "@gtkx/native": "workspace:*",
        "@gtkx/react": "workspace:*",
        "@gtkx/runtime": "workspace:*",
        "@gtkx/utils": "workspace:*",
        "@types/node": "catalog:",
        "fast-xml-parser": "^5.11.2",
        "fast-xml-validator": "^1.4.2",
        "typescript": "catalog:"
    }
}

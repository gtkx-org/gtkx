import { getValueBoxed, setValueBoxed } from "@gtkx/ffi";
import { type Type, Value } from "../gobject.js";

export const buildValue = (gtype: Type, populate: (value: Value) => void): Value => {
    const value = new Value();
    value.init(gtype);
    populate(value);
    return value;
};

Value.prototype.getBoxed = function <T = unknown>(this: Value): T {
    return getValueBoxed(this) as T;
};

Value.prototype.setBoxed = function (this: Value, boxed: object | null): void {
    setValueBoxed(this, boxed);
};

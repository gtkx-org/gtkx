registerWrapperClass(Settings, resolveType("libgio-2.0.so.0", "g_settings_get_type"));

const generatedGetKey = SettingsSchema.prototype.getKey;

SettingsSchema.prototype.getKey = function getKey(name: string): SettingsSchemaKey {
    if (!this.hasKey(name)) {
        throw new Error(`GSettings key '${name}' not found in schema '${this.getId()}'`);
    }

    return generatedGetKey.call(this, name);
};

export { Settings };

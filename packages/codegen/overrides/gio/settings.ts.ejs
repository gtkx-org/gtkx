    getUserValue(key: string): GLib.Variant | null {
        checkKey(this, key);

        return super.getUserValue(key);
    }

    /**
     * Gets the value that is stored at `key` as a `GLib.Variant`.
     *
     * @throws An `Error` when the schema does not declare `key`.
     */
    getValue(key: string): GLib.Variant {
        checkKey(this, key);

        return super.getValue(key);
    }

    /**
     * Finds out if the given key can be written.
     *
     * @throws An `Error` when the schema does not declare `name`.
     */
    isWritable(name: string): boolean {
        checkKey(this, name);

        return super.isWritable(name);
    }

    /**
     * Checks if the given `value` is within the permitted range for `key`.
     *
     * @throws An `Error` when the schema does not declare `key`.
     */
    rangeCheck(key: string, value: GLib.Variant): boolean {
        checkKey(this, key);

        return super.rangeCheck(key, value);
    }

    /**
     * Resets `key` to its default value.
     *
     * @throws An `Error` when the schema does not declare `key`.
     */
    reset(key: string): void {
        checkKey(this, key);
        super.reset(key);
    }

    /**
     * Sets `key` to a boolean value.
     *
     * @throws An `Error` when the schema does not declare `key`.
     */
    setBoolean(key: string, value: boolean): boolean {
        checkKey(this, key);

        return super.setBoolean(key, value);
    }

    /**
     * Sets `key` to a double value.
     *
     * @throws An `Error` when the schema does not declare `key`.
     */
    setDouble(key: string, value: number): boolean {
        checkKey(this, key);

        return super.setDouble(key, value);
    }

    /**
     * Sets `key` to an enum value.
     *
     * @throws An `Error` when the schema does not declare `key`.
     */
    setEnum(key: string, value: number): boolean {
        checkKey(this, key);

        return super.setEnum(key, value);
    }

    /**
     * Sets `key` to a flags value.
     *
     * @throws An `Error` when the schema does not declare `key`.
     */
    setFlags(key: string, value: number): boolean {
        checkKey(this, key);

        return super.setFlags(key, value);
    }

    /**
     * Sets `key` to a 32-bit integer value.
     *
     * @throws An `Error` when the schema does not declare `key`.
     */
    setInt(key: string, value: number): boolean {
        checkKey(this, key);

        return super.setInt(key, value);
    }

    /**
     * Sets `key` to a 64-bit integer value.
     *
     * @throws An `Error` when the schema does not declare `key`.

    getString(key: string): string {
        checkKey(this, key);

        return super.getString(key);
    }

    /**
     * Gets the value that is stored at `key` as a string array.
     *
     * @throws An `Error` when the schema does not declare `key`.
     */
    getStrv(key: string): string[] {
        checkKey(this, key);

        return super.getStrv(key);
    }

    /**
     * Gets the value that is stored at `key` as a 32-bit unsigned integer.
     *
     * @throws An `Error` when the schema does not declare `key`.
     */
    getUint(key: string): number {
        checkKey(this, key);

        return super.getUint(key);
    }

    /**
     * Gets the value that is stored at `key` as a 64-bit unsigned integer.
     *
     * @throws An `Error` when the schema does not declare `key`.
     */
    getUint64(key: string): bigint {
        checkKey(this, key);

        return super.getUint64(key);
    }

    /**
     * Gets the user-set value of `key`, if any.

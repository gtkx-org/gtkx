{
    "name": "@gtkx/animate",
    "version": "0.21.0",
    "description": "Adwaita-powered animation for GTKX: the animated factory and AnimatePresence component with tween and spring transitions",
    "keywords": [
        "gtkx",
        "gtk",
        "gtk4",
        "adwaita",
        "animation",
        "react",
        "linux",
        "desktop"
    ],
    "homepage": "https://gtkx.dev",
    "bugs": {
        "url": "https://github.com/gtkx-org/gtkx/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/gtkx-org/gtkx.git",
        "directory": "packages/animate"
    },
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "sideEffects": false,
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "tsc -b tsconfig.lib.json",
        "typecheck": "tsc -b --emitDeclarationOnly",
        "release": "cp ../../README.md README.md && pnpm publish --access public --no-git-checks"
    },
    "engines": {
        "node": ">=24"
    },
    "dependencies": {
        "@gtkx/css": "workspace:*",
        "@gtkx/react": "workspace:*",
        "@gtkx/utils": "workspace:*"
    },
    "devDependencies": {
        "@gtkx/vitest": "workspace:*"
    },
    "peerDependencies": {
        "react": "^19"
    }
}

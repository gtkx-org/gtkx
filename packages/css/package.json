{
    "name": "@gtkx/css",
    "version": "2.0.0-beta.12",
    "description": "CSS-in-JS for GTKX widgets.",
    "keywords": [
        "gtkx",
        "gtk",
        "gtk4",
        "adwaita",
        "gnome",
        "react",
        "css",
        "emotion",
        "css-in-js",
        "styling",
        "linux",
        "desktop"
    ],
    "homepage": "https://gtkx.dev",
    "bugs": {
        "url": "https://github.com/gtkx-org/gtkx/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gtkx-org/gtkx.git",
        "directory": "packages/css"
    },
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": null,
            "default": "./dist/index.js"
        },
        "./internal": {
            "types": "./dist/internal.d.ts",
            "import": "./dist/internal.js",
            "require": null,
            "default": "./dist/internal.js"
        }
    },
    "sideEffects": false,
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "release": "node ../../scripts/release/publish-package.ts"
    },
    "engines": {
        "node": ">=26.7.0"
    },
    "dependencies": {
        "@emotion/serialize": "^1.3.3",
        "@gtkx/utils": "workspace:*",
        "postcss": "^8.5.31",
        "postcss-nested": "^9.0.0",
        "postcss-selector-parser": "^7.1.7"
    },
    "devDependencies": {
        "@gtkx/vitest": "workspace:*"
    }
}

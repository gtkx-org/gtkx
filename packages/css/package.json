{
    "name": "@gtkx/css",
    "version": "2.0.0-beta.2",
    "description": "CSS-in-JS for GTK that compiles to real GTK4 CSS.",
    "keywords": [
        "gtkx",
        "gtk",
        "gtk4",
        "react",
        "css",
        "emotion",
        "css-in-js",
        "styling",
        "linux",
        "desktop"
    ],
    "homepage": "https://gtkx.dev",
    "bugs": {
        "url": "https://github.com/gtkx-org/gtkx/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gtkx-org/gtkx.git",
        "directory": "packages/css"
    },
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": null,
            "default": "./dist/index.js"
        },
        "./internal": {
            "source": "./src/internal.ts",
            "types": "./dist/internal.d.ts",
            "import": "./dist/internal.js",
            "require": null,
            "default": "./dist/internal.js"
        }
    },
    "sideEffects": false,
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "release": "tsx ../../scripts/release-package.ts"
    },
    "nx": {
        "targets": {
            "lint": {
                "options": {
                    "cwd": ".",
                    "command": "eslint {projectRoot}"
                }
            }
        }
    },
    "engines": {
        "node": ">=26.7.0"
    },
    "dependencies": {
        "@emotion/serialize": "^1.3.3",
        "@gtkx/utils": "workspace:*",
        "stylis": "^4.4.0"
    },
    "devDependencies": {
        "@gtkx/vitest": "workspace:*",
        "@types/stylis": "^4.2.7"
    }
}

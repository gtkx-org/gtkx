{
    "name": "@gtkx/ffi",
    "version": "0.21.0",
    "description": "Generated TypeScript FFI bindings for GTKX",
    "keywords": [
        "gtkx",
        "gtk",
        "gtk4",
        "ffi",
        "bindings",
        "typescript",
        "linux",
        "desktop"
    ],
    "homepage": "https://gtkx.dev",
    "bugs": {
        "url": "https://github.com/gtkx-org/gtkx/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/gtkx-org/gtkx.git",
        "directory": "packages/ffi"
    },
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "sideEffects": true,
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./runtime": {
            "types": "./dist/runtime.d.ts",
            "default": "./dist/runtime.js"
        },
        "./object": {
            "types": "./dist/object.d.ts",
            "default": "./dist/object.js"
        },
        "./value-marshal": {
            "types": "./dist/value-marshal.d.ts",
            "default": "./dist/value-marshal.js"
        },
        "./handles": {
            "types": "./dist/handles.d.ts",
            "default": "./dist/handles.js"
        },
        "./native": {
            "types": "./dist/native.d.ts",
            "default": "./dist/native.js"
        },
        "./registry": {
            "types": "./dist/registry.d.ts",
            "default": "./dist/registry.js"
        },
        "./helpers": {
            "types": "./dist/helpers.d.ts",
            "default": "./dist/helpers.js"
        },
        "./gtype": {
            "types": "./dist/gtype.d.ts",
            "default": "./dist/gtype.js"
        },
        "./lifecycle": {
            "types": "./dist/lifecycle.d.ts",
            "default": "./dist/lifecycle.js"
        },
        "./register-native-class": {
            "types": "./dist/register-native-class.d.ts",
            "default": "./dist/register-native-class.js"
        },
        "./gobject/types": {
            "types": "./dist/gobject/types.d.ts",
            "default": "./dist/gobject/types.js"
        },
        "./gobject/fundamental-types": {
            "types": "./dist/gobject/fundamental-types.d.ts",
            "default": "./dist/gobject/fundamental-types.js"
        },
        "./gobject/gvalue": {
            "types": "./dist/gobject/gvalue.d.ts",
            "default": "./dist/gobject/gvalue.js"
        },
        "./gobject/gvalue-native": {
            "types": "./dist/gobject/gvalue-native.d.ts",
            "default": "./dist/gobject/gvalue-native.js"
        },
        "./gl": {
            "types": "./dist/gl/index.d.ts",
            "default": "./dist/gl/index.js"
        },
        "./cairo": {
            "types": "./dist/cairo/index.d.ts",
            "default": "./dist/cairo/index.js"
        },
        "./gdk": {
            "types": "./dist/gdk/index.d.ts",
            "default": "./dist/gdk/index.js"
        },
        "./gobject": {
            "types": "./dist/gobject/index.d.ts",
            "default": "./dist/gobject/index.js"
        },
        "./graphene": {
            "types": "./dist/graphene/index.d.ts",
            "default": "./dist/graphene/index.js"
        },
        "./gtk": {
            "types": "./dist/gtk/index.d.ts",
            "default": "./dist/gtk/index.js"
        },
        "./*": {
            "types": "./dist/generated/*/*.d.ts",
            "default": "./dist/generated/*/*.js"
        }
    },
    "files": [
        "dist",
        "src",
        "scripts",
        "!dist/generated",
        "!src/generated",
        "!**/*.tsbuildinfo"
    ],
    "scripts": {
        "build": "pnpm run ensure-generated && tsc -b && pnpm run copy-generated-dts",
        "copy-generated-dts": "node scripts/copy-generated-dts.ts",
        "ensure-generated": "node --conditions=source --import tsx ../cli/src/cli.ts codegen --if-missing --cwd ../..",
        "postinstall": "node scripts/postinstall.ts",
        "test": "vitest run",
        "typecheck": "pnpm run ensure-generated && tsc -b --emitDeclarationOnly && pnpm run copy-generated-dts"
    },
    "engines": {
        "node": ">=24"
    },
    "dependencies": {
        "@gtkx/native": "workspace:*"
    },
    "devDependencies": {
        "@gtkx/vitest": "workspace:*"
    }
}

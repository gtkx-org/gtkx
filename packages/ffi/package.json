{
    "name": "@gtkx/ffi",
    "version": "0.21.0",
    "description": "Hand-written FFI runtime for GTKX: GObject lifecycle, GValue marshalling, signals, and the class registry the generated bindings call into",
    "keywords": [
        "gtkx",
        "gtk",
        "gtk4",
        "ffi",
        "bindings",
        "typescript",
        "linux",
        "desktop"
    ],
    "homepage": "https://gtkx.dev",
    "bugs": {
        "url": "https://github.com/gtkx-org/gtkx/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/gtkx-org/gtkx.git",
        "directory": "packages/ffi"
    },
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "sideEffects": true,
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "src",
        "!**/*.tsbuildinfo"
    ],
    "scripts": {
        "build": "tsc -b",
        "test": "vitest run",
        "typecheck": "tsc -b --emitDeclarationOnly"
    },
    "engines": {
        "node": ">=24"
    },
    "dependencies": {
        "@gtkx/native": "workspace:*",
        "@gtkx/utils": "workspace:*"
    },
    "devDependencies": {
        "@gtkx/vitest": "workspace:*"
    }
}

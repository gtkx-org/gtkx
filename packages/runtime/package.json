{
    "name": "@gtkx/runtime",
    "version": "1.6.0",
    "description": "FFI runtime for the generated GTK bindings: types, GValues, signals.",
    "keywords": [
        "gtkx",
        "gtk",
        "gtk4",
        "ffi",
        "bindings",
        "typescript",
        "linux",
        "desktop"
    ],
    "homepage": "https://gtkx.dev",
    "bugs": {
        "url": "https://github.com/gtkx-org/gtkx/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gtkx-org/gtkx.git",
        "directory": "packages/runtime"
    },
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "sideEffects": [
        "./src/exit-hook.ts",
        "./dist/exit-hook.js",
        "./src/index.ts",
        "./dist/index.js"
    ],
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": null,
            "default": "./dist/index.js"
        },
        "./internal": {
            "source": "./src/internal.ts",
            "types": "./dist/internal.d.ts",
            "import": "./dist/internal.js",
            "require": null,
            "default": "./dist/internal.js"
        }
    },
    "files": [
        "dist",
        "src",
        "!**/*.tsbuildinfo"
    ],
    "scripts": {
        "release": "tsx ../../scripts/release-package.ts"
    },
    "nx": {
        "targets": {
            "lint": {
                "options": {
                    "cwd": ".",
                    "command": "eslint {projectRoot}"
                }
            }
        }
    },
    "engines": {
        "node": ">=26.7.0"
    },
    "dependencies": {
        "@gtkx/native": "workspace:*",
        "@gtkx/utils": "workspace:*"
    },
    "devDependencies": {
        "@gtkx/vitest": "workspace:*"
    }
}

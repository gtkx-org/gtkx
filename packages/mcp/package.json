{
    "name": "@gtkx/mcp",
    "version": "2.0.0-beta.4",
    "description": "MCP server exposing the GTK API reference and a running GTK4 app.",
    "keywords": [
        "gtkx",
        "gtk",
        "gtk4",
        "mcp",
        "model-context-protocol",
        "ai",
        "typescript",
        "linux",
        "desktop"
    ],
    "homepage": "https://gtkx.dev",
    "bugs": {
        "url": "https://github.com/gtkx-org/gtkx/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gtkx-org/gtkx.git",
        "directory": "packages/mcp"
    },
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        "./server": {
            "source": "./src/server.ts",
            "types": "./dist/server.d.ts",
            "import": "./dist/server.js",
            "require": null,
            "default": "./dist/server.js"
        },
        "./internal": {
            "source": "./src/internal.ts",
            "types": "./dist/internal.d.ts",
            "import": "./dist/internal.js",
            "require": null,
            "default": "./dist/internal.js"
        }
    },
    "bin": {
        "gtkx-mcp": "bin/gtkx-mcp.js"
    },
    "sideEffects": false,
    "files": [
        "bin",
        "dist",
        "src"
    ],
    "scripts": {
        "release": "tsx ../../scripts/release-package.ts"
    },
    "nx": {
        "targets": {
            "lint": {
                "options": {
                    "cwd": ".",
                    "command": "eslint {projectRoot}"
                }
            }
        }
    },
    "engines": {
        "node": ">=26.7.0"
    },
    "dependencies": {
        "@gtkx/codegen": "workspace:*",
        "@gtkx/config": "workspace:*",
        "@gtkx/utils": "workspace:*",
        "@modelcontextprotocol/sdk": "^1.30.0",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@gtkx/vitest": "workspace:*",
        "vitest": "catalog:"
    }
}

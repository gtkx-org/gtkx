{
    "name": "create-gtkx",
    "version": "0.21.0",
    "description": "Scaffold a new native GTK4 + React desktop application with gtkx",
    "keywords": [
        "gtkx",
        "gtk",
        "gtk4",
        "react",
        "typescript",
        "native",
        "linux",
        "desktop",
        "create",
        "scaffold"
    ],
    "homepage": "https://gtkx.dev",
    "bugs": {
        "url": "https://github.com/gtkx-org/gtkx/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/gtkx-org/gtkx.git",
        "directory": "packages/create-gtkx"
    },
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "bin": {
        "create-gtkx": "bin/create-gtkx.js"
    },
    "sideEffects": false,
    "files": [
        "bin",
        "dist",
        "src"
    ],
    "scripts": {
        "build": "tsc -b tsconfig.lib.json && rm -rf dist/templates && cp -r src/templates dist/templates",
        "typecheck": "tsc -b --emitDeclarationOnly",
        "release": "tsx ../../scripts/release-package.ts"
    },
    "engines": {
        "node": ">=24"
    },
    "dependencies": {
        "@clack/prompts": "^1.7.0",
        "@gtkx/config": "workspace:*",
        "@gtkx/utils": "workspace:*",
        "ejs": "catalog:",
        "citty": "^0.2.2",
        "nypm": "^0.6.8",
        "tinyexec": "^1.2.4"
    },
    "devDependencies": {
        "@types/ejs": "catalog:",
        "@types/node": "catalog:",
        "memfs": "^4.64.0",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}

{
    "name": "create-gtkx",
    "version": "1.0.0-rc.1",
    "description": "Scaffold a new native GTK4 + React desktop application with GTKX",
    "keywords": [
        "gtkx",
        "gtk",
        "gtk4",
        "react",
        "typescript",
        "native",
        "linux",
        "desktop",
        "create",
        "scaffold"
    ],
    "homepage": "https://gtkx.dev",
    "bugs": {
        "url": "https://github.com/gtkx-org/gtkx/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gtkx-org/gtkx.git",
        "directory": "packages/create-gtkx"
    },
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "bin": {
        "create-gtkx": "bin/create-gtkx.js"
    },
    "sideEffects": false,
    "files": [
        "bin",
        "dist",
        "src"
    ],
    "scripts": {
        "copy-templates": "mkdir -p dist/templates && cp -R src/templates/. dist/templates/",
        "release": "tsx ../../scripts/release-package.ts"
    },
    "engines": {
        "node": ">=24"
    },
    "dependencies": {
        "@clack/prompts": "^1.7.0",
        "@gtkx/config": "workspace:*",
        "@gtkx/utils": "workspace:*",
        "ejs": "catalog:",
        "citty": "^0.2.2",
        "nypm": "^0.6.9",
        "tinyexec": "^1.2.4"
    },
    "devDependencies": {
        "@types/ejs": "catalog:",
        "@types/node": "catalog:",
        "memfs": "^4.64.0",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "nx": {
        "targets": {
            "copy-templates": {
                "cache": true,
                "inputs": [
                    "{projectRoot}/src/templates/**/*"
                ],
                "outputs": [
                    "{projectRoot}/dist/templates/**"
                ]
            },
            "build": {
                "dependsOn": [
                    "^build",
                    "gtkx:codegen",
                    "copy-templates"
                ]
            }
        }
    }
}

{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "name": "create-gtkx",
    "targets": {
        "lint": {
            "dependsOn": ["^build", "_lint:eslint"]
        },
        "_build:templates": {
            "cache": true,
            "inputs": ["{projectRoot}/src/templates/**/*"],
            "outputs": ["{projectRoot}/dist/templates/**"],
            "command": "pnpm run _build:templates",
            "options": {
                "cwd": "{projectRoot}"
            }
        },
        "build": {
            "dependsOn": ["^build", "_build:templates"]
        },
        "typecheck": {
            "dependsOn": ["build", "^typecheck"]
        }
    }
}

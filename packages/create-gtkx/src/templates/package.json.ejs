{
    "name": "<%= name %>",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "imports": {
        "#data/*": "./data/*"
    },
    "scripts": {
        "dev": "gtkx dev",
        "build": "gtkx build",
        "codegen": "gtkx codegen",
<% if (typescript) { -%>
        "typecheck": "gtkx codegen && tsc --noEmit",
<% } -%>
        "start": "node dist/bundle.js"
    },
    "allowScripts": {
        "esbuild": true,
        "@swc/core": true
    }
}

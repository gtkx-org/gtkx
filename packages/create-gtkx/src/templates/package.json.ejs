{
    "name": "<%= name %>",
    "version": "0.0.1",
    "private": true,
    "description": "A GTK4 application built with GTKX",
    "license": "MIT",
<% if (developerEmail) { -%>
    "author": "<%= developerName %> <<%= developerEmail %>>",
<% } else { -%>
    "author": "<%= developerName %>",
<% } -%>
    "type": "module",
    "imports": {
        "#data/*": "./data/*"
    },
    "scripts": {
        "dev": "gtkx dev",
        "build": "gtkx build",
        "codegen": "gtkx codegen",
<% if (isTypescript) { -%>
        "typecheck": "gtkx codegen && tsc",
<% } -%>
        "start": "node dist/bundle.js",
        "deploy": "gtkx deploy"
    }
}

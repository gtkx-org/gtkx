{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "name": "@gtkx/native",
    "namedInputs": {
        "crate": [
            "{projectRoot}/src/**/*",
            "{projectRoot}/build.rs",
            "{projectRoot}/Cargo.toml",
            "{projectRoot}/Cargo.lock",
            "{projectRoot}/package.json",
            "{workspaceRoot}/rust-toolchain.toml",
            "nativeEnvironment",
            "{projectRoot}/tools/rust-toolchain.toml"
        ],
        "nativeTests": [
            "default",
            "crate",
            "{workspaceRoot}/packages/codegen/src/**/*",
            "{workspaceRoot}/packages/codegen/overrides/**/*",
            "{workspaceRoot}/packages/runtime/src/**/*",
            "{workspaceRoot}/packages/vitest/src/**/*",
            "{workspaceRoot}/scripts/register-workspace-loader.ts",
            "{workspaceRoot}/scripts/resolve-workspace-aliases.ts",
            "{workspaceRoot}/packages/e2e/tests/native/**/*",
            "{workspaceRoot}/packages/e2e/tests/helpers/native-fixtures*.ts"
        ]
    },
    "targets": {
        "build": {
            "dependsOn": [],
            "cache": true,
            "inputs": [
                "crate",
                "{projectRoot}/tools/build.ts",
                "{projectRoot}/tools/verify-artifacts.ts",
                "{projectRoot}/artifacts/**/*"
            ],
            "outputs": ["{projectRoot}/index.d.ts", "{projectRoot}/index.js", "{projectRoot}/native.*.node"],
            "command": "pnpm run build",
            "options": {
                "cwd": "{projectRoot}"
            },
            "configurations": {
                "release-artifacts": {
                    "command": "pnpm run build --from-artifacts"
                }
            }
        },
        "_lint:rust": {
            "cache": true,
            "dependsOn": [],
            "inputs": ["crate", "{workspaceRoot}/rustfmt.toml"],
            "outputs": [],
            "command": "pnpm run _lint:rust",
            "options": {
                "cwd": "{projectRoot}"
            }
        },
        "lint": {
            "dependsOn": ["^build", "build", "_lint:rust"]
        },
        "test-asan": {
            "dependsOn": ["build", "@gtkx/e2e:_test:fixtures", "@gtkx/runtime:build"],
            "cache": true,
            "inputs": [
                "nativeTests",
                "^production",
                {
                    "env": "NODE_OPTIONS"
                },
                {
                    "env": "LD_LIBRARY_PATH"
                }
            ],
            "outputs": [],
            "command": "pnpm run test-asan",
            "options": {
                "cwd": "{projectRoot}"
            }
        },
        "release": {
            "cache": false,
            "dependsOn": ["build"],
            "command": "pnpm run release",
            "options": {
                "cwd": "{projectRoot}"
            },
            "configurations": {
                "release-artifacts": {
                    "command": "node tools/prepublish.ts --from-artifacts && node ../../scripts/release/publish-package.ts"
                }
            }
        },
        "typecheck": {
            "dependsOn": ["...", "build"]
        }
    }
}

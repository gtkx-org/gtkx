{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "name": "@gtkx/native",
    "namedInputs": {
        "crate": [
            "{projectRoot}/src/**/*",
            "{projectRoot}/build.rs",
            "{projectRoot}/Cargo.toml",
            "{projectRoot}/Cargo.lock",
            "{projectRoot}/package.json",
            "{workspaceRoot}/rust-toolchain.toml",
            "nativeEnvironment",
            "{projectRoot}/tools/rust-toolchain.toml"
        ],
        "nativeTests": [
            "default",
            "crate",
            "{workspaceRoot}/packages/codegen/src/**/*",
            "{workspaceRoot}/packages/codegen/overrides/**/*",
            "{workspaceRoot}/packages/runtime/src/**/*",
            "{workspaceRoot}/packages/vitest/src/**/*",
            "{workspaceRoot}/scripts/tsx.ts",
            "{workspaceRoot}/scripts/workspace-paths.ts",
            "{workspaceRoot}/packages/e2e/tests/native/**/*",
            "{workspaceRoot}/packages/e2e/tests/helpers/native-fixtures.ts",
            "{workspaceRoot}/packages/e2e/tests/helpers/native-fixtures-compile.ts"
        ]
    },
    "targets": {
        "build": {
            "dependsOn": [],
            "cache": true,
            "inputs": [
                "crate",
                "{projectRoot}/tools/build.ts",
                "{workspaceRoot}/scripts/native-artifact.ts",
                "{projectRoot}/artifacts/**/*",
                {
                    "env": "GTKX_RELEASE_NATIVE_ARTIFACTS"
                },
                "{workspaceRoot}/scripts/ci/**/*"
            ],
            "outputs": [
                "{projectRoot}/index.d.ts",
                "{projectRoot}/index.js",
                "{projectRoot}/native.*.node"
            ],
            "command": "node ../../scripts/ci/run.mjs 'pnpm run build'",
            "options": {
                "cwd": "{projectRoot}"
            }
        },
        "_lint:rust": {
            "cache": true,
            "dependsOn": [],
            "inputs": [
                "crate",
                "{workspaceRoot}/rustfmt.toml",
                "{workspaceRoot}/scripts/ci/**/*"
            ],
            "outputs": [],
            "command": "node ../../scripts/ci/run.mjs 'pnpm run _lint:rust'",
            "options": {
                "cwd": "{projectRoot}"
            }
        },
        "_lint:audit": {
            "command": "node scripts/ci/run.mjs 'cargo audit --file packages/native/Cargo.lock --deny unsound'",
            "cache": false,
            "inputs": [
                "...",
                "default",
                "^default",
                "{workspaceRoot}/scripts/ci/**/*"
            ]
        },
        "lint": {
            "dependsOn": [
                "build",
                "_lint:rust"
            ]
        },
        "test-asan": {
            "dependsOn": [
                "build",
                "@gtkx/e2e:_test:fixtures",
                "@gtkx/runtime:build"
            ],
            "cache": true,
            "inputs": [
                "nativeTests",
                "^production",
                "{workspaceRoot}/scripts/ci/**/*"
            ],
            "outputs": [],
            "command": "node ../../scripts/ci/run.mjs 'pnpm run test-asan'",
            "options": {
                "cwd": "{projectRoot}"
            }
        },
        "test": {
            "dependsOn": [
                "build"
            ],
            "inputs": [
                "...",
                "nativeTests"
            ]
        },
        "release": {
            "cache": false,
            "dependsOn": [
                "build"
            ]
        },
        "typecheck": {
            "dependsOn": [
                "...",
                "build"
            ]
        }
    }
}

{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "name": "@gtkx/native",
    "namedInputs": {
        "crate": [
            "{projectRoot}/src/**/*",
            "{projectRoot}/build.rs",
            "{projectRoot}/Cargo.toml",
            "{projectRoot}/Cargo.lock",
            "{projectRoot}/package.json",
            "{workspaceRoot}/rust-toolchain.toml",
            "nativeEnvironment",
            "{projectRoot}/tools/rust-toolchain.toml"
        ],
        "nativeTests": [
            "default",
            "crate",
            "{workspaceRoot}/packages/codegen/src/**/*",
            "{workspaceRoot}/packages/codegen/overrides/**/*",
            "{workspaceRoot}/packages/runtime/src/**/*",
            "{workspaceRoot}/packages/vitest/src/**/*",
            "{workspaceRoot}/scripts/tsx.ts",
            "{workspaceRoot}/scripts/workspace-paths.ts",
            "{workspaceRoot}/packages/e2e/tests/native/**/*",
            "{workspaceRoot}/packages/e2e/tests/helpers/native-fixtures.ts"
        ]
    },
    "targets": {
        "build": {
            "dependsOn": [],
            "cache": true,
            "inputs": [
                "crate",
                "{projectRoot}/tools/build.ts",
                "{workspaceRoot}/scripts/native-artifact.ts",
                "{projectRoot}/artifacts/**/*",
                {
                    "env": "GTKX_RELEASE_NATIVE_ARTIFACTS"
                }
            ],
            "outputs": [
                "{projectRoot}/index.d.ts",
                "{projectRoot}/index.js",
                "{projectRoot}/native.*.node"
            ]
        },
        "_lint:rust": {
            "cache": true,
            "dependsOn": [],
            "inputs": [
                "crate",
                "{workspaceRoot}/rustfmt.toml"
            ],
            "outputs": []
        },
        "_lint:audit": {
            "command": "cargo audit --file packages/native/Cargo.lock --deny unsound",
            "cache": false
        },
        "lint": {
            "dependsOn": [
                "build",
                "_lint:rust",
                "_lint:audit"
            ]
        },
        "_test:asan": {
            "dependsOn": [
                "build",
                "@gtkx/e2e:_test:fixtures",
                "@gtkx/runtime:build"
            ],
            "cache": true,
            "inputs": [
                "nativeTests",
                "^production"
            ],
            "outputs": []
        },
        "test": {
            "dependsOn": [
                "build",
                "_test:asan"
            ],
            "inputs": [
                "...",
                "nativeTests"
            ]
        },
        "release": {
            "cache": false,
            "dependsOn": [
                "build"
            ]
        },
        "typecheck": {
            "dependsOn": [
                "...",
                "build"
            ]
        }
    }
}

{
    "name": "@gtkx/native",
    "version": "2.0.0-beta.4",
    "description": "Rust addon for GTK: loads libraries, marshals values, tracks GObjects.",
    "keywords": [
        "gtkx",
        "gtk",
        "gtk4",
        "native",
        "ffi",
        "rust",
        "napi",
        "linux",
        "desktop"
    ],
    "homepage": "https://gtkx.dev",
    "bugs": {
        "url": "https://github.com/gtkx-org/gtkx/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gtkx-org/gtkx.git",
        "directory": "packages/native"
    },
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./main.d.ts",
            "default": "./main.js"
        },
        "./internal": {
            "types": "./internal.d.ts",
            "default": "./internal.js"
        }
    },
    "sideEffects": [
        "./bootstrap.js",
        "./main.js"
    ],
    "files": [
        "bootstrap.js",
        "index.js",
        "index.d.ts",
        "internal.js",
        "internal.d.ts",
        "main.js",
        "main.d.ts"
    ],
    "napi": {
        "binaryName": "native",
        "targets": [
            "x86_64-unknown-linux-gnu",
            "aarch64-unknown-linux-gnu"
        ]
    },
    "scripts": {
        "artifacts": "napi artifacts",
        "build": "napi build --platform --release --esm --no-dts-cache --no-const-enum",
        "create-npm-dirs": "napi create-npm-dirs",
        "lint:rust": "tsx ../../scripts/cargo-nightly.ts fmt --check && cargo clippy --all-targets -- -D warnings",
        "release": "tsx ../../scripts/prepublish-native.ts && tsx ../../scripts/release-package.ts"
    },
    "nx": {
        "namedInputs": {
            "crate": [
                "{projectRoot}/src/**/*",
                "{projectRoot}/build.rs",
                "{projectRoot}/Cargo.toml",
                "{projectRoot}/Cargo.lock",
                "{projectRoot}/package.json",
                "{workspaceRoot}/rust-toolchain.toml",
                {
                    "runtime": "uname -m"
                }
            ]
        },
        "targets": {
            "lint": {
                "options": {
                    "cwd": ".",
                    "command": "eslint {projectRoot}"
                }
            },
            "build": {
                "dependsOn": [],
                "cache": true,
                "inputs": [
                    "crate"
                ],
                "outputs": [
                    "{projectRoot}/index.d.ts",
                    "{projectRoot}/index.js",
                    "{projectRoot}/native.*.node"
                ]
            },
            "lint:rust": {
                "cache": true,
                "inputs": [
                    "crate",
                    "{workspaceRoot}/rustfmt.toml",
                    "{workspaceRoot}/scripts/cargo-nightly.ts",
                    "{workspaceRoot}/scripts/rust-nightly.ts"
                ],
                "outputs": []
            },
            "create-npm-dirs": {
                "dependsOn": [
                    "build"
                ],
                "cache": true,
                "inputs": [
                    "crate"
                ],
                "outputs": [
                    "{projectRoot}/npm/**"
                ]
            },
            "artifacts": {
                "dependsOn": [
                    "build",
                    "create-npm-dirs"
                ],
                "cache": false
            },
            "release": {
                "dependsOn": [
                    "artifacts",
                    "create-npm-dirs"
                ],
                "cache": false
            },
            "test": {
                "dependsOn": [
                    "build"
                ],
                "cache": true
            }
        }
    },
    "engines": {
        "node": ">=26.7.0"
    },
    "devDependencies": {
        "@gtkx/vitest": "workspace:*",
        "@napi-rs/cli": "^3.8.6"
    }
}

{
    "name": "@gtkx/native",
    "version": "1.6.0",
    "description": "Rust addon for GTK: loads libraries, marshals values, tracks GObjects.",
    "keywords": [
        "gtkx",
        "gtk",
        "gtk4",
        "native",
        "ffi",
        "rust",
        "napi",
        "linux",
        "desktop"
    ],
    "homepage": "https://gtkx.dev",
    "bugs": {
        "url": "https://github.com/gtkx-org/gtkx/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gtkx-org/gtkx.git",
        "directory": "packages/native"
    },
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./main.d.ts",
            "import": "./main.js",
            "require": null,
            "default": "./main.js"
        }
    },
    "sideEffects": [
        "./init.js",
        "./main.js"
    ],
    "files": [
        "index.js",
        "index.d.ts",
        "init.js",
        "main.js",
        "main.d.ts"
    ],
    "napi": {
        "binaryName": "native",
        "targets": [
            "x86_64-unknown-linux-gnu",
            "aarch64-unknown-linux-gnu"
        ]
    },
    "scripts": {
        "artifacts": "napi artifacts",
        "build": "napi build --platform --release --esm --no-dts-cache --no-const-enum",
        "create-npm-dirs": "napi create-npm-dirs",
        "lint:rust": "cargo +nightly-2026-08-20 fmt --check && cargo clippy --all-targets -- -D warnings",
        "test:asan": "tsx ../../scripts/asan-native.ts",
        "test": "tsx ../../scripts/native-test-codegen.ts && LD_LIBRARY_PATH=\"$PWD/../../build/native-tests/lifecycle/meson${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}\" node --expose-gc --test node-tests/*.test.mjs",
        "release": "tsx ../../scripts/prepublish-native.ts && tsx ../../scripts/release-package.ts"
    },
    "nx": {
        "namedInputs": {
            "crate": [
                "{projectRoot}/src/**/*",
                "{projectRoot}/build.rs",
                "{projectRoot}/Cargo.toml",
                "{projectRoot}/Cargo.lock",
                "{projectRoot}/package.json",
                "{workspaceRoot}/rust-toolchain.toml",
                "{workspaceRoot}/rustfmt.toml",
                {
                    "runtime": "uname -m"
                }
            ],
            "nativeTests": [
                "crate",
                "sharedGlobals",
                "{projectRoot}/node-tests/**/*",
                "{projectRoot}/fixtures/**/*",
                "{workspaceRoot}/scripts/asan-native.ts",
                "{workspaceRoot}/scripts/descriptor-inventory.ts",
                "{workspaceRoot}/scripts/native-test-codegen.ts",
                "{workspaceRoot}/scripts/rust-nightly.ts",
                "{workspaceRoot}/packages/*/src/**/*"
            ]
        },
        "targets": {
            "lint": {
                "options": {
                    "cwd": ".",
                    "command": "eslint {projectRoot}"
                }
            },
            "build": {
                "dependsOn": [],
                "cache": true,
                "inputs": [
                    "crate"
                ],
                "outputs": [
                    "{projectRoot}/index.d.ts",
                    "{projectRoot}/index.js",
                    "{projectRoot}/native.*.node"
                ]
            },
            "test": {
                "dependsOn": [
                    "build",
                    "@gtkx/gl:codegen",
                    "@gtkx/runtime:build"
                ],
                "cache": false,
                "inputs": [
                    "nativeTests"
                ],
                "outputs": []
            },
            "test:asan": {
                "dependsOn": [
                    "build"
                ],
                "cache": true,
                "inputs": [
                    "nativeTests"
                ],
                "outputs": []
            },
            "lint:rust": {
                "cache": true,
                "inputs": [
                    "crate"
                ],
                "outputs": []
            },
            "create-npm-dirs": {
                "dependsOn": [
                    "build"
                ],
                "cache": true,
                "inputs": [
                    "crate"
                ],
                "outputs": [
                    "{projectRoot}/npm/**"
                ]
            },
            "artifacts": {
                "dependsOn": [
                    "build",
                    "create-npm-dirs"
                ],
                "cache": false
            },
            "release": {
                "dependsOn": [
                    "artifacts",
                    "create-npm-dirs"
                ],
                "cache": false
            }
        }
    },
    "engines": {
        "node": ">=26.7.0"
    },
    "devDependencies": {
        "@napi-rs/cli": "^3.8.6"
    }
}

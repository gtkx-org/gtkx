{
    "name": "@gtkx/native",
    "version": "0.21.0",
    "description": "Rust-based native module providing FFI bindings for GTKX",
    "keywords": [
        "gtkx",
        "gtk",
        "gtk4",
        "native",
        "ffi",
        "rust",
        "napi",
        "linux",
        "desktop"
    ],
    "homepage": "https://gtkx.dev",
    "bugs": {
        "url": "https://github.com/gtkx-org/gtkx/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/gtkx-org/gtkx.git",
        "directory": "packages/native"
    },
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "source": "./index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "sideEffects": false,
    "files": [
        "dist",
        "index.ts",
        "types.ts",
        "native-binding.cjs",
        "native-binding.d.cts"
    ],
    "napi": {
        "binaryName": "native",
        "targets": [
            "x86_64-unknown-linux-gnu",
            "aarch64-unknown-linux-gnu"
        ]
    },
    "scripts": {
        "artifacts": "napi artifacts",
        "build": "tsc -b && cp native-binding.cjs native-binding.d.cts dist/",
        "create-npm-dirs": "napi create-npm-dirs",
        "lint": "cargo fmt --check && cargo clippy --all-targets --all-features -- -D warnings",
        "native-bench": "cargo bench --features test-support --bench marshalling",
        "native-build": "napi build --platform --release --features test-support --js native-binding.cjs --dts native-binding.d.cts && cp native.linux-$(node -p \"process.arch\")-gnu.node npm/linux-$(node -p \"process.arch\")-gnu/",
        "native-build:dist": "napi build --platform --release --js native-binding.cjs --dts native-binding.d.cts && cp native.linux-$(node -p \"process.arch\")-gnu.node npm/linux-$(node -p \"process.arch\")-gnu/",
        "native-coverage": "mkdir -p coverage && node ../../scripts/ci.ts headless cargo +nightly llvm-cov --features test-support --lcov --output-path coverage/native.lcov.info --fail-under-lines 80 -- --test-threads=1",
        "prepublishOnly": "napi prepublish -t npm",
        "test": "node ../../scripts/ci.ts headless cargo test --features test-support -- --test-threads=1"
    },
    "engines": {
        "node": ">=26"
    },
    "optionalDependencies": {
        "@gtkx/native-linux-arm64-gnu": "workspace:*",
        "@gtkx/native-linux-x64-gnu": "workspace:*"
    },
    "devDependencies": {
        "@gtkx/vitest": "workspace:*",
        "@napi-rs/cli": "^3.7.2"
    }
}

{
    "name": "@gtkx/native",
    "version": "2.0.0-beta.11",
    "description": "Native addon for GTKX foreign-function calls.",
    "keywords": [
        "gtkx",
        "gtk",
        "gtk4",
        "adwaita",
        "gnome",
        "native",
        "ffi",
        "rust",
        "napi",
        "linux",
        "desktop"
    ],
    "homepage": "https://gtkx.dev",
    "bugs": {
        "url": "https://github.com/gtkx-org/gtkx/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gtkx-org/gtkx.git",
        "directory": "packages/native"
    },
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./main.d.ts",
            "default": "./main.js"
        },
        "./internal": {
            "types": "./internal.d.ts",
            "default": "./internal.js"
        },
        "./internal/binding": {
            "types": "./binding.d.ts",
            "default": "./binding.js"
        }
    },
    "sideEffects": [
        "./bootstrap.js",
        "./main.js"
    ],
    "files": [
        "binding.js",
        "binding.d.ts",
        "bootstrap.js",
        "index.js",
        "index.d.ts",
        "internal.js",
        "internal.d.ts",
        "main.js",
        "main.d.ts"
    ],
    "napi": {
        "binaryName": "native",
        "targets": [
            "x86_64-unknown-linux-gnu",
            "aarch64-unknown-linux-gnu"
        ]
    },
    "scripts": {
        "build": "tsx tools/build.ts",
        "_lint:rust": "(cd tools && env -u RUSTUP_TOOLCHAIN cargo fmt --manifest-path ../Cargo.toml --check) && cargo clippy --locked --all-targets -- -D warnings",
        "test-asan": "tsx tools/asan.ts",
        "release": "tsx tools/prepublish.ts && tsx ../../scripts/release-package.ts"
    },
    "engines": {
        "node": ">=26.7.0"
    },
    "devDependencies": {
        "@gtkx/utils": "workspace:*",
        "@napi-rs/cli": "^3.10.8"
    }
}

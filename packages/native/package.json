{
    "name": "@gtkx/native",
    "version": "0.21.0",
    "description": "Rust-based native module providing FFI bindings for GTKX",
    "keywords": [
        "gtkx",
        "gtk",
        "gtk4",
        "native",
        "ffi",
        "rust",
        "napi",
        "linux",
        "desktop"
    ],
    "homepage": "https://gtkx.dev",
    "bugs": {
        "url": "https://github.com/gtkx-org/gtkx/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/gtkx-org/gtkx.git",
        "directory": "packages/native"
    },
    "license": "MPL-2.0",
    "author": "Eugenio Depalo <eugeniodepalo@gmail.com>",
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./main.d.ts",
            "default": "./main.js"
        }
    },
    "sideEffects": [
        "./main.js"
    ],
    "files": [
        "index.js",
        "index.d.ts",
        "main.js",
        "main.d.ts"
    ],
    "napi": {
        "binaryName": "native",
        "targets": [
            "x86_64-unknown-linux-gnu",
            "aarch64-unknown-linux-gnu"
        ]
    },
    "scripts": {
        "artifacts": "napi artifacts",
        "build:debug": "napi build --platform --esm --no-dts-cache --no-const-enum",
        "build:release": "napi build --platform --release --esm --no-dts-cache --no-const-enum",
        "coverage": "mkdir -p coverage && node ../../scripts/ci.ts headless cargo +nightly llvm-cov --lcov --output-path coverage/native.lcov.info --fail-under-lines 80 -- --test-threads=1",
        "create-npm-dirs": "napi create-npm-dirs",
        "lint": "cargo fmt --check && cargo clippy --all-targets -- -D warnings",
        "prepublishOnly": "napi prepublish -t npm",
        "test": "node ../../scripts/ci.ts headless cargo test -- --test-threads=1"
    },
    "engines": {
        "node": ">=24"
    },
    "devDependencies": {
        "@napi-rs/cli": "^3.7.2"
    }
}

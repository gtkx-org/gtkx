{
    "name": "browser",
    "version": "0.0.0",
    "private": true,
    "license": "MPL-2.0",
    "description": "Simple browser using WebKitWebView",
    "type": "module",
    "scripts": {
        "build": "gtkx build",
        "dev": "gtkx dev",
        "start": "node dist/bundle.js"
    },
    "dependencies": {
        "@gtkx/css": "workspace:*",
        "@gtkx/react": "workspace:*",
        "react": "catalog:"
    },
    "devDependencies": {
        "@gtkx/cli": "workspace:*",
        "@gtkx/config": "workspace:*"
    },
    "nx": {
        "targets": {
            "codegen": {
                "command": "gtkx codegen",
                "options": {
                    "cwd": "{projectRoot}"
                },
                "cache": false,
                "dependsOn": [
                    "gtkx:codegen",
                    "@gtkx/cli:build"
                ]
            },
            "build": {
                "cache": true,
                "dependsOn": [
                    "^build",
                    "codegen"
                ],
                "outputs": [
                    "{projectRoot}/dist/**"
                ]
            },
            "typecheck": {
                "dependsOn": [
                    "^build",
                    "codegen"
                ]
            },
            "dev": {
                "cache": false,
                "continuous": true
            },
            "start": {
                "cache": false,
                "continuous": true
            }
        }
    }
}

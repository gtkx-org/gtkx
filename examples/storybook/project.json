{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "name": "storybook-example",
    "targets": {
        "codegen": {
            "command": "gtkx codegen",
            "options": {
                "cwd": "{projectRoot}"
            },
            "cache": false,
            "dependsOn": [
                "gtkx:_build:bindings",
                "@gtkx/cli:build"
            ],
            "outputs": [
                "{projectRoot}/node_modules/.gtkx/gi/**/*.{js,d.ts,json}",
                "{projectRoot}/node_modules/.gtkx/jsx/**/*.{js,d.ts,json}",
                "{projectRoot}/node_modules/.gtkx/*.d.ts"
            ]
        },
        "typecheck": {
            "dependsOn": [
                "^build",
                "codegen"
            ]
        },
        "dev": {
            "cache": false,
            "continuous": true,
            "dependsOn": [
                "^build",
                "codegen"
            ]
        },
        "test": {
            "dependsOn": [
                "...",
                "codegen",
                "@gtkx/testing:build"
            ]
        },
        "lint": {
            "dependsOn": [
                "...",
                "codegen"
            ]
        }
    }
}

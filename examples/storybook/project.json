{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "name": "storybook-example",
    "targets": {
        "codegen": {
            "command": "node ../../scripts/ci/run.mjs 'gtkx codegen'",
            "options": {
                "cwd": "{projectRoot}"
            },
            "cache": true,
            "dependsOn": [
                "gtkx:_build:bindings",
                "@gtkx/cli:build"
            ],
            "outputs": [
                "{projectRoot}/node_modules/.gtkx"
            ],
            "inputs": [
                "default",
                "^production",
                {
                    "dependentTasksOutputFiles": "**/*.{js,d.ts,json}",
                    "transitive": true
                },
                "{workspaceRoot}/scripts/ci/**/*"
            ]
        },
        "typecheck": {
            "dependsOn": [
                "^build",
                "codegen"
            ]
        },
        "dev": {
            "cache": false,
            "continuous": true,
            "dependsOn": [
                "^build",
                "codegen"
            ]
        },
        "test": {
            "dependsOn": [
                "...",
                "codegen",
                "@gtkx/testing:build"
            ],
            "command": "node ../../scripts/ci/run.mjs 'pnpm run test'",
            "options": {
                "cwd": "{projectRoot}"
            },
            "inputs": [
                "...",
                "default",
                "^default",
                "{workspaceRoot}/scripts/ci/**/*"
            ]
        },
        "lint": {
            "dependsOn": [
                "...",
                "codegen"
            ]
        }
    }
}

{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "name": "storybook-example",
    "targets": {
        "codegen": {
            "command": "gtkx codegen",
            "options": {
                "cwd": "{projectRoot}"
            },
            "cache": true,
            "dependsOn": ["gtkx:bindings", "@gtkx/cli:build"],
            "outputs": ["{projectRoot}/node_modules/.gtkx"],
            "inputs": [
                "default",
                "^production",
                {
                    "dependentTasksOutputFiles": "**/*.{js,d.ts,json}",
                    "transitive": true
                }
            ]
        },
        "typecheck": {
            "dependsOn": ["^build", "codegen"]
        },
        "dev": {
            "cache": false,
            "continuous": true,
            "dependsOn": ["^build", "codegen"]
        },
        "test": {
            "dependsOn": ["...", "codegen", "@gtkx/testing:build"],
            "command": "pnpm run test",
            "options": {
                "cwd": "{projectRoot}"
            },
            "inputs": ["...", "default", "^default"]
        },
        "lint": {
            "dependsOn": ["...", "codegen"]
        },
        "_lint:eslint": {
            "dependsOn": ["...", "codegen"]
        }
    }
}

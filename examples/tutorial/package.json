{
    "name": "gtkx-tutorial",
    "version": "0.1.0",
    "private": true,
    "license": "MPL-2.0",
    "description": "Tasks app from the GTKX tutorial",
    "type": "module",
    "imports": {
        "#data/*": "./data/*"
    },
    "scripts": {
        "dev": "gtkx dev",
        "build": "gtkx build",
        "codegen": "gtkx codegen",
        "test": "vitest run",
        "typecheck": "gtkx codegen && tsc --noEmit",
        "start": "node dist/bundle.js",
        "bundle": "gtkx build && node scripts/bundle.ts",
        "bundle:postject": "node scripts/bundle-postject.ts",
        "build:sea": "bash scripts/build-sea.sh",
        "flatpak:lint": "desktop-file-validate flatpak/com.gtkx.tutorial.desktop && appstreamcli validate --no-net flatpak/com.gtkx.tutorial.metainfo.xml",
        "flatpak:sources": "bash flatpak/generate-sources.sh",
        "flatpak:build": "bash flatpak/build.sh"
    },
    "dependencies": {
        "@gtkx/components": "^1.0.0-rc.4",
        "@gtkx/css": "^1.0.0-rc.4",
        "@gtkx/react": "^1.0.0-rc.4",
        "react": "^19.2.8",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@gtkx/cli": "^1.0.0-rc.4",
        "@gtkx/config": "^1.0.0-rc.4",
        "@gtkx/testing": "^1.0.0-rc.4",
        "@types/node": "^26.1.2",
        "@types/react": "^19.2.18",
        "esbuild": "^0.28.1",
        "postject": "1.0.0-alpha.6",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    },
    "allowScripts": {
        "esbuild": true,
        "@swc/core": true
    }
}

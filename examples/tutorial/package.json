{
    "name": "gtkx-tutorial",
    "version": "1.0.0",
    "private": true,
    "license": "MPL-2.0",
    "description": "Tasks app from the GTKX tutorial",
    "type": "module",
    "engines": {
        "node": ">=26.7.0"
    },
    "scripts": {
        "dev": "gtkx dev",
        "build": "gtkx build",
        "codegen": "gtkx codegen",
        "test": "vitest run && npm run test:i18n",
        "test:i18n": "gtkx build && vitest run --config vitest.i18n.config.ts",
        "typecheck": "gtkx codegen && tsc",
        "start": "node dist/bundle.mjs",
        "deploy": "gtkx deploy"
    },
    "dependencies": {
        "@gtkx/cairo": "^1.6.0",
        "@gtkx/components": "^1.6.0",
        "@gtkx/css": "^1.6.0",
        "@gtkx/forms": "^1.6.0",
        "@gtkx/i18n": "^1.6.0",
        "@gtkx/navigation": "^1.6.0",
        "@gtkx/react": "^1.6.0",
        "react": "^19.2.8",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@gtkx/cli": "^1.6.0",
        "@gtkx/config": "^1.6.0",
        "@gtkx/testing": "^1.6.0",
        "@types/node": "^26.4.0",
        "@types/react": "^19.2.18",
        "typescript": "^7.0.2",
        "vitest": "^4.1.11"
    },
    "allowScripts": {
        "@swc/core": true
    },
    "author": "GTKX <hello@gtkx.dev>",
    "homepage": "https://gtkx.dev"
}

{
    "name": "tutorial",
    "version": "0.1.0",
    "private": true,
    "license": "MPL-2.0",
    "description": "Notes app from the GTKX tutorial",
    "type": "module",
    "imports": {
        "#data/*": "./data/*"
    },
    "scripts": {
        "build": "gtkx build",
        "typecheck": "gtkx codegen && tsc -b --emitDeclarationOnly",
        "dev": "gtkx dev",
        "start": "node dist/bundle.js",
        "bundle": "gtkx build && node scripts/bundle.ts",
        "bundle:postject": "node scripts/bundle-postject.ts",
        "build:sea": "bash scripts/build-sea.sh",
        "build:flatpak": "pnpm bundle:postject && bash flatpak/build.sh"
    },
    "dependencies": {
        "@gtkx/animate": "workspace:*",
        "@gtkx/components": "workspace:*",
        "@gtkx/css": "workspace:*",
        "@gtkx/react": "workspace:*",
        "react": "catalog:"
    },
    "devDependencies": {
        "@gtkx/cli": "workspace:*",
        "@gtkx/config": "workspace:*",
        "esbuild": "^0.28.1",
        "postject": "1.0.0-alpha.6"
    }
}

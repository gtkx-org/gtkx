{
    "name": "hello-world",
    "version": "1.0.0",
    "private": true,
    "license": "MPL-2.0",
    "description": "Simple counter app demonstrating GTKX basics",
    "type": "module",
    "scripts": {
        "build": "gtkx build",
        "dev": "gtkx dev",
        "start": "node dist/bundle.js"
    },
    "dependencies": {
        "@gtkx/react": "workspace:*",
        "react": "catalog:"
    },
    "devDependencies": {
        "@gtkx/cli": "workspace:*",
        "@gtkx/config": "workspace:*"
    },
    "nx": {
        "targets": {
            "codegen": {
                "command": "gtkx codegen",
                "options": {
                    "cwd": "{projectRoot}"
                },
                "cache": false,
                "dependsOn": [
                    "gtkx:codegen",
                    "@gtkx/cli:build"
                ],
                "outputs": [
                    "{projectRoot}/node_modules/.gtkx/**/*.{js,d.ts,json}"
                ]
            },
            "build": {
                "cache": true,
                "dependsOn": [
                    "^build",
                    "codegen"
                ],
                "inputs": [
                    "default",
                    "^production",
                    {
                        "dependentTasksOutputFiles": "**/*.{js,d.ts,json}",
                        "transitive": true
                    }
                ],
                "outputs": [
                    "{projectRoot}/dist/**"
                ]
            },
            "typecheck": {
                "dependsOn": [
                    "^build",
                    "codegen"
                ]
            },
            "dev": {
                "cache": false,
                "continuous": true,
                "dependsOn": [
                    "^build",
                    "codegen"
                ]
            },
            "start": {
                "cache": false,
                "continuous": true,
                "dependsOn": [
                    "build"
                ]
            },
            "lint": {
                "dependsOn": [
                    "gtkx:codegen",
                    "@gtkx/gl:codegen",
                    "codegen"
                ],
                "options": {
                    "cwd": ".",
                    "command": "eslint examples/hello-world"
                }
            }
        }
    },
    "author": "GTKX <hello@gtkx.dev>",
    "imports": {
        "#data/*": "./data/*"
    }
}

{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "name": "gtk-demo",
    "targets": {
        "codegen": {
            "command": "gtkx codegen",
            "options": {
                "cwd": "{projectRoot}"
            },
            "cache": true,
            "dependsOn": ["gtkx:bindings", "@gtkx/cli:build"],
            "outputs": ["{projectRoot}/node_modules/.gtkx"],
            "inputs": [
                "default",
                "^production",
                {
                    "dependentTasksOutputFiles": "**/*.{js,d.ts,json}",
                    "transitive": true
                }
            ]
        },
        "build": {
            "cache": true,
            "dependsOn": ["^build", "codegen"],
            "inputs": [
                "default",
                "^production",
                {
                    "dependentTasksOutputFiles": "**/*.{js,d.ts,json}",
                    "transitive": true
                }
            ],
            "outputs": ["{projectRoot}/dist/**"],
            "command": "pnpm run build",
            "options": {
                "cwd": "{projectRoot}"
            }
        },
        "typecheck": {
            "dependsOn": ["^build", "codegen"]
        },
        "dev": {
            "cache": false,
            "continuous": true,
            "dependsOn": ["^build", "codegen"]
        },
        "start": {
            "cache": false,
            "continuous": true,
            "dependsOn": ["build"]
        },
        "lint": {
            "dependsOn": ["...", "codegen"]
        }
    }
}

{
    "name": "gtk-demo",
    "version": "0.0.0",
    "private": true,
    "license": "MPL-2.0",
    "description": "GTK4 widget showcase - React port of official gtk-demo",
    "type": "module",
    "imports": {
        "#data/*": "./data/*"
    },
    "scripts": {
        "build": "gtkx build",
        "dev": "gtkx dev",
        "start": "node dist/bundle.js",
        "coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@gtkx/components": "workspace:*",
        "@gtkx/css": "workspace:*",
        "@gtkx/runtime": "workspace:*",
        "@gtkx/gl": "workspace:*",
        "@gtkx/react": "workspace:*",
        "react": "catalog:"
    },
    "devDependencies": {
        "@gtkx/cli": "workspace:*",
        "@gtkx/config": "workspace:*",
        "@gtkx/native": "workspace:*",
        "@gtkx/testing": "workspace:*",
        "@vitest/coverage-v8": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    },
    "nx": {
        "targets": {
            "codegen": {
                "command": "gtkx codegen",
                "options": {
                    "cwd": "{projectRoot}"
                },
                "cache": false,
                "dependsOn": [
                    "gtkx:codegen",
                    "@gtkx/cli:build"
                ]
            },
            "build": {
                "cache": true,
                "dependsOn": [
                    "^build",
                    "codegen"
                ],
                "outputs": [
                    "{projectRoot}/dist/**"
                ]
            },
            "typecheck": {
                "dependsOn": [
                    "^build",
                    "codegen"
                ]
            },
            "dev": {
                "cache": false,
                "continuous": true
            },
            "start": {
                "cache": false,
                "continuous": true
            }
        }
    }
}

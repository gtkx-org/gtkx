{
    "name": "gtk-demo",
    "version": "0.0.0",
    "private": true,
    "license": "MPL-2.0",
    "description": "GTK4 widget showcase - React port of official gtk-demo",
    "type": "module",
    "imports": {
        "#data/*": "./data/*"
    },
    "scripts": {
        "build": "gtkx build",
        "coverage": "vitest run --coverage",
        "dev": "gtkx dev",
        "start": "node dist/bundle.js"
    },
    "dependencies": {
        "@gtkx/components": "workspace:*",
        "@gtkx/css": "workspace:*",
        "@gtkx/runtime": "workspace:*",
        "@gtkx/gl": "workspace:*",
        "@gtkx/react": "workspace:*",
        "@gtkx/utils": "workspace:*",
        "react": "catalog:"
    },
    "devDependencies": {
        "@gtkx/cli": "workspace:*",
        "@gtkx/config": "workspace:*",
        "@gtkx/native": "workspace:*",
        "@gtkx/testing": "workspace:*",
        "@vitest/coverage-v8": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    },
    "nx": {
        "targets": {
            "codegen": {
                "command": "gtkx codegen",
                "options": {
                    "cwd": "{projectRoot}"
                },
                "cache": false,
                "dependsOn": [
                    "gtkx:codegen",
                    "@gtkx/cli:build"
                ],
                "outputs": [
                    "{projectRoot}/node_modules/.gtkx/**/*.{js,d.ts,json}"
                ]
            },
            "build": {
                "cache": true,
                "dependsOn": [
                    "^build",
                    "codegen"
                ],
                "inputs": [
                    "default",
                    "^production",
                    {
                        "dependentTasksOutputFiles": "**/*.{js,d.ts,json}",
                        "transitive": true
                    }
                ],
                "outputs": [
                    "{projectRoot}/dist/**"
                ]
            },
            "typecheck": {
                "dependsOn": [
                    "^build",
                    "codegen"
                ]
            },
            "dev": {
                "cache": false,
                "continuous": true,
                "dependsOn": [
                    "^build",
                    "codegen"
                ]
            },
            "start": {
                "cache": false,
                "continuous": true,
                "dependsOn": [
                    "build"
                ]
            },
            "test": {
                "command": "vitest run",
                "options": {
                    "cwd": "{projectRoot}"
                },
                "cache": true,
                "inputs": [
                    "default",
                    "^production",
                    {
                        "dependentTasksOutputFiles": "**/*.{js,d.ts,json}",
                        "transitive": true
                    }
                ],
                "outputs": [],
                "dependsOn": [
                    "...",
                    "codegen",
                    "@gtkx/testing:build"
                ]
            },
            "lint": {
                "dependsOn": [
                    "gtkx:codegen",
                    "@gtkx/gl:codegen",
                    "codegen"
                ],
                "options": {
                    "cwd": ".",
                    "command": "eslint examples/gtk-demo"
                }
            },
            "coverage": {
                "command": "vitest run --coverage",
                "options": {
                    "cwd": "{projectRoot}"
                },
                "cache": true,
                "inputs": [
                    "default",
                    "^production",
                    {
                        "dependentTasksOutputFiles": "**/*.{js,d.ts,json}",
                        "transitive": true
                    }
                ],
                "outputs": [
                    "{projectRoot}/coverage"
                ],
                "dependsOn": [
                    "...",
                    "codegen",
                    "@gtkx/testing:build"
                ]
            }
        }
    }
}

{
    "name": "gtk-demo",
    "version": "0.0.0",
    "private": true,
    "license": "MPL-2.0",
    "description": "GTK4 widget showcase - React port of official gtk-demo",
    "type": "module",
    "scripts": {
        "build": "gtkx build",
        "typecheck": "tsc -b --emitDeclarationOnly",
        "dev": "gtkx dev",
        "start": "node dist/bundle.js",
        "test": "vitest run",
        "coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@gtkx/css": "workspace:*",
        "@gtkx/ffi": "workspace:*",
        "@gtkx/react": "workspace:*",
        "react": "^19.2.6"
    },
    "devDependencies": {
        "@gtkx/cli": "workspace:*",
        "@gtkx/testing": "workspace:*",
        "@vitest/coverage-v8": "^4.1.7",
        "vite": "^8.0.14",
        "vitest": "^4.1.7"
    }
}

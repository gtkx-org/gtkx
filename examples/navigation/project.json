{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "name": "navigation",
    "targets": {
        "codegen": {
            "command": "gtkx codegen",
            "options": {
                "cwd": "{projectRoot}"
            },
            "cache": false,
            "dependsOn": [
                "gtkx:codegen",
                "@gtkx/cli:build"
            ],
            "outputs": [
                "{projectRoot}/node_modules/.gtkx/gi/**/*.{js,d.ts,json}",
                "{projectRoot}/node_modules/.gtkx/jsx/**/*.{js,d.ts,json}"
            ]
        },
        "build": {
            "cache": true,
            "dependsOn": [
                "^build",
                "codegen"
            ],
            "inputs": [
                "default",
                "^production",
                {
                    "dependentTasksOutputFiles": "**/*.{js,d.ts,json}",
                    "transitive": true
                }
            ],
            "outputs": [
                "{projectRoot}/dist/**"
            ]
        },
        "typecheck": {
            "dependsOn": [
                "^build",
                "codegen"
            ]
        },
        "dev": {
            "cache": false,
            "continuous": true,
            "dependsOn": [
                "^build",
                "codegen"
            ]
        },
        "start": {
            "cache": false,
            "continuous": true,
            "dependsOn": [
                "build"
            ]
        },
        "test": {
            "dependsOn": [
                "...",
                "codegen",
                "@gtkx/testing:build"
            ]
        },
        "lint": {
            "dependsOn": [
                "...",
                "codegen"
            ]
        }
    }
}
